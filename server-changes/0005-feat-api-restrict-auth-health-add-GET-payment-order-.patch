+mrd_assert('polling adds isPaid', $polling['isPaid'], true);
+mrd_assert('polling adds isTerminal', $polling['isTerminal'], true);
+mrd_assert('polling adds updatedAt', $polling['updatedAt'], '2026-10-16 08:05:00');
