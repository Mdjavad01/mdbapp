+     * پاسخ نتوانند از هم فاصله بگیرند (اگر روزی کلید جدیدی اضافه شد، در هر دو
+     * ظاهر می‌شود).
+     *
+     * @param object $row     ردیف سفارش (به‌همراه admin_review_note در صورت وجود)
+     * @param array  $options ['polling' => bool, 'admin_note' => bool]
+     * @return array
+     */
+    public static function format_order_for_client($row, $options = array()) {
+        $polling = !empty($options['polling']);
+        $with_admin_note = !array_key_exists('admin_note', $options) || $options['admin_note'];
+
+        $item = array(
+            'id' => (string) $row->id,
+            'orderNumber' => (string) $row->order_number,
+            'itemTitle' => (string) $row->item_title,
+            'amountToman' => (int) $row->amount_toman,
+            'gateway' => (string) $row->gateway,
+            'status' => (string) $row->status,
+            'createdAt' => (string) $row->created_at,
+            'verifiedAt' => !empty($row->verified_at) ? (string) $row->verified_at : null,
+            'refNumber' => !empty($row->zibal_ref_number) ? (string) $row->zibal_ref_number : null,
+        );
+
+        // یادداشت ادمین فقط برای فیشِ کارت‌به‌کارتِ «ردشده»ی خودِ کاربر — شفافیت
