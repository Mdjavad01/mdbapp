+     * منطق (خالص، تا بدون وردپرس آزمون‌پذیر باشد):
+     *   - محیط‌های غیرproductionِ شناخته‌شده ⇒ مجاز (کاربرد اصلی: عیب‌یابی)
+     *   - هر چیز دیگری — از جمله production، رشتهٔ خالی، یا یک مقدار ناشناخته —
+     *     فقط با توکن تنظیم‌شده و مطابق
+     *   - توکن تنظیم‌نشده در production ⇒ رد (fail-closed، نه «باز»)
+     *
+     * عمداً allow-list است، نه «هر چیزی جز production». اگر روزی کسی
+     * WP_ENVIRONMENT_TYPE را به یک مقدار ناشناخته ست کند، نتیجه «قفل شدن» است
+     * نه «باز شدن» — و بازکردنش یک توکن می‌خواهد، نه یک اشتباه پیکربندی.
+     *
+     * مقایسه با hash_equals انجام می‌شود تا زمان پاسخ، توکن را لو ندهد.
+     *
+     * @param string $environment
+     * @param string $provided
+     * @param string $expected
+     * @return bool
+     */
+    public static function health_access_allowed_for($environment, $provided, $expected) {
+        $environment = strtolower(trim((string) $environment));
+
+        if (in_array($environment, array('local', 'development', 'staging'), true)) {
+            return true;
+        }
+
+        $expected = (string) $expected;
+        $provided = (string) $provided;
+
+        if ('' === $expected || '' === $provided) {
+            return false;
+        }
+
+        return hash_equals($expected, $provided);
+    }
+
+    /**
+     * v1.8.0: پوشش وردپرسیِ [health_access_allowed_for].
+     *
+     * @return bool
+     */
+    public static function health_access_allowed() {
+        return self::health_access_allowed_for(
+            self::environment_type(),
+            self::provided_health_token(),
+            self::health_token()
+        );
+    }
