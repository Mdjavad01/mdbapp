+
+    /**
+     * آیا این وضعیت پایانی است؟ (پولینگ بعد از آن بی‌فایده است)
+     *
+     * `verifying` عمداً پایانی نیست: ممکن است به completed برود یا به pending
+     * برگردد. `pending` هم پایانی نیست (کاربر ممکن است هنوز پرداخت کند).
+     *
+     * @param string $status
+     * @return bool
+     */
+    public static function is_terminal_status($status) {
+        return in_array(
+            (string) $status,
+            array('completed', 'failed', 'cancelled', 'rejected'),
+            true
+        );
+    }
+
+    /**
