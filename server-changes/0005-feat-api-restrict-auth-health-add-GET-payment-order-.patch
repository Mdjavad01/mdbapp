+<?php
+/**
+ * تست وضعیت سفارش (test-order-status) — بدون وردپرس
+ *
+ * اجرا: php tests/php/test-order-status.php
+ *
+ * پوشش:
+ *   - is_paid_status()      فقط `completed` یعنی پول گرفته شده
+ *   - is_terminal_status()  پولینگ بعد از این وضعیت‌ها بی‌فایده است
+ *   - validate_order_id()   الگوی شناسهٔ مسیر
+ *   - format_order_for_client()  شکل پاسخ، و کلیدهای مخصوص پولینگ
+ *
+ * ─── چرا مهم است ───
+ * دو خطای ممکن اینجا هر دو به ضرر کاربر است:
+ *   ۱) اگر `verifying` را «پرداخت‌شده» حساب کنیم، اپی که پرداختش رد می‌شود
+ *      پیام موفقیت می‌بیند.
+ *   ۲) اگر `isTerminal` برای `pending` درست شود، پولینگ زودتر از موعد متوقف
+ *      می‌شود و کاربری که در حال پرداخت است، صفحهٔ «ناموفق» می‌بیند.
+ * تست هر دو جهت را قفل می‌کند.
+ */
+
+define('ABSPATH', '/tmp/');
+define('MRDASTBAAF_API_NAMESPACE', 'mrdastbaaf/v1');
+
+if (!defined('MINUTE_IN_SECONDS')) {
+    define('MINUTE_IN_SECONDS', 60);
+}
+if (!defined('HOUR_IN_SECONDS')) {
+    define('HOUR_IN_SECONDS', 3600);
+}
+if (!defined('DAY_IN_SECONDS')) {
+    define('DAY_IN_SECONDS', 86400);
+}
+
+require_once __DIR__ . '/../../includes/class-payment-controller.php';
+
+$pass = 0;
+$fail = 0;
+
+function mrd_assert($label, $actual, $expected) {
+    global $pass, $fail;
+    if ($actual === $expected) {
+        $pass++;
+        echo "PASS: {$label}\n";
+    } else {
+        $fail++;
+        echo "FAIL: {$label} — expected: " . var_export($expected, true) . " | got: " . var_export($actual, true) . "\n";
+    }
+}
+
+$controller = new MrDastbaaf_Payment_Controller();
+
+// ─── ۱) پرداخت‌شده؟ ────────────────────────────────────────────────────────
+
+mrd_assert('completed is paid', MrDastbaaf_Payment_Controller::is_paid_status('completed'), true);
+mrd_assert('pending is not paid', MrDastbaaf_Payment_Controller::is_paid_status('pending'), false);
+mrd_assert('verifying is NOT paid (it is a transient state)', MrDastbaaf_Payment_Controller::is_paid_status('verifying'), false);
+mrd_assert('failed is not paid', MrDastbaaf_Payment_Controller::is_paid_status('failed'), false);
+mrd_assert('cancelled is not paid', MrDastbaaf_Payment_Controller::is_paid_status('cancelled'), false);
+mrd_assert('rejected is not paid', MrDastbaaf_Payment_Controller::is_paid_status('rejected'), false);
+mrd_assert('an empty status is not paid', MrDastbaaf_Payment_Controller::is_paid_status(''), false);
+mrd_assert('the check is case sensitive', MrDastbaaf_Payment_Controller::is_paid_status('Completed'), false);
+
+// ─── ۲) پایانی؟ ────────────────────────────────────────────────────────────
+
+mrd_assert('completed is terminal', MrDastbaaf_Payment_Controller::is_terminal_status('completed'), true);
+mrd_assert('failed is terminal', MrDastbaaf_Payment_Controller::is_terminal_status('failed'), true);
+mrd_assert('cancelled is terminal', MrDastbaaf_Payment_Controller::is_terminal_status('cancelled'), true);
+mrd_assert('rejected is terminal', MrDastbaaf_Payment_Controller::is_terminal_status('rejected'), true);
+
+// این دو مهم‌اند: توقف پولینگ روی آن‌ها کاربر را در حالت «ناموفق» رها می‌کند.
+mrd_assert('pending is NOT terminal (the user may still pay)', MrDastbaaf_Payment_Controller::is_terminal_status('pending'), false);
+mrd_assert('verifying is NOT terminal (it may still resolve)', MrDastbaaf_Payment_Controller::is_terminal_status('verifying'), false);
+mrd_assert('an empty status is not terminal', MrDastbaaf_Payment_Controller::is_terminal_status(''), false);
+mrd_assert('an unknown status is not terminal', MrDastbaaf_Payment_Controller::is_terminal_status('whatever'), false);
+
+// ─── ۳) اعتبارسنجی شناسهٔ سفارش ────────────────────────────────────────────
+
+mrd_assert('a normal id is valid', $controller->validate_order_id('abc123'), true);
+mrd_assert('hyphens and underscores are valid', $controller->validate_order_id('A-b_c-9'), true);
+mrd_assert('a 64 character id is valid', $controller->validate_order_id(str_repeat('a', 64)), true);
+mrd_assert('a 65 character id is invalid', $controller->validate_order_id(str_repeat('a', 65)), false);
+mrd_assert('an empty id is invalid', $controller->validate_order_id(''), false);
+mrd_assert('a slash is invalid', $controller->validate_order_id('a/b'), false);
+mrd_assert('a dot is invalid', $controller->validate_order_id('a.b'), false);
+mrd_assert('a space is invalid', $controller->validate_order_id('a b'), false);
+mrd_assert('a newline is invalid', $controller->validate_order_id("a\nb"), false);
+mrd_assert('a percent is invalid', $controller->validate_order_id('a%2Fb'), false);
+mrd_assert('persian digits are invalid (ids are ascii)', $controller->validate_order_id('۱۲۳'), false);
+
+// ─── ۴) شکل پاسخ ───────────────────────────────────────────────────────────
+
+/**
+ * ساخت ردیف سفارش آزمایشی.
+ */
+function mrd_order_row($overrides = array()) {
+    return (object) array_merge(array(
+        'id' => 'ord-1',
+        'order_number' => 'MD-1001',
+        'item_title' => 'اشتراک طلایی',
+        'amount_toman' => 490000,
+        'gateway' => 'zibal',
+        'status' => 'pending',
+        'created_at' => '2026-10-16 08:00:00',
+        'updated_at' => '2026-10-16 08:05:00',
+        'verified_at' => null,
+        'zibal_ref_number' => null,
+        'admin_review_note' => null,
+    ), $overrides);
+}
+
+// شکل پایه — باید **مو‌به‌مو** همان چیزی باشد که /me/orders برمی‌گرداند.
+$base = MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row());
+
+mrd_assert('the base shape is unchanged (key order included)', $base, array(
+    'id' => 'ord-1',
+    'orderNumber' => 'MD-1001',
+    'itemTitle' => 'اشتراک طلایی',
+    'amountToman' => 490000,
+    'gateway' => 'zibal',
+    'status' => 'pending',
+    'createdAt' => '2026-10-16 08:00:00',
+    'verifiedAt' => null,
+    'refNumber' => null,
+));
+
+// کلیدهای مخصوص پولینگ نباید در پاسخ فهرست ظاهر شوند.
+mrd_assert('the base shape has no isPaid key', array_key_exists('isPaid', $base), false);
+mrd_assert('the base shape has no updatedAt key', array_key_exists('updatedAt', $base), false);
+
+mrd_assert(
+    'a null verified_at maps to null, not an empty string',
+    MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array('verified_at' => null)))['verifiedAt'],
+    null
+);
+mrd_assert(
+    'a set verified_at is passed through',
+    MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array('verified_at' => '2026-10-16 09:00:00')))['verifiedAt'],
+    '2026-10-16 09:00:00'
+);
+mrd_assert(
+    'a null ref number maps to null',
+    MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array('zibal_ref_number' => null)))['refNumber'],
+    null
+);
+mrd_assert(
+    'the amount is cast to int',
+    MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array('amount_toman' => '490000')))['amountToman'],
+    490000
+);
+
+// ─── ۵) یادداشت ادمین — فقط در یک حالت ────────────────────────────────────
+
+mrd_assert(
+    'adminNote is exposed for a rejected card-to-card receipt',
+    MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array(
+        'gateway' => 'card_to_card',
+        'status' => 'rejected',
+        'admin_review_note' => 'مبلغ واریزی با مبلغ سفارش مطابقت ندارد.',
+    )))['adminNote'],
+    'مبلغ واریزی با مبلغ سفارش مطابقت ندارد.'
+);
+
+mrd_assert(
+    'adminNote is NOT exposed for a rejected zibal payment',
+    array_key_exists('adminNote', MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array(
+        'gateway' => 'zibal',
+        'status' => 'rejected',
+        'admin_review_note' => 'یادداشت داخلی',
+    )))),
+    false
+);
+
+mrd_assert(
+    'adminNote is NOT exposed for an approved card-to-card receipt',
+    array_key_exists('adminNote', MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array(
+        'gateway' => 'card_to_card',
+        'status' => 'completed',
+        'admin_review_note' => 'یادداشت داخلی',
+    )))),
+    false
+);
+
+mrd_assert(
+    'adminNote is NOT exposed when the note is empty',
+    array_key_exists('adminNote', MrDastbaaf_Payment_Controller::format_order_for_client(mrd_order_row(array(
+        'gateway' => 'card_to_card',
+        'status' => 'rejected',
+        'admin_review_note' => '',
+    )))),
+    false
+);
+
+mrd_assert(
+    'adminNote can be suppressed explicitly',
+    array_key_exists('adminNote', MrDastbaaf_Payment_Controller::format_order_for_client(
+        mrd_order_row(array('gateway' => 'card_to_card', 'status' => 'rejected', 'admin_review_note' => 'x')),
+        array('admin_note' => false)
+    )),
+    false
+);
+
+// ─── ۶) حالت پولینگ ────────────────────────────────────────────────────────
+
+$polling = MrDastbaaf_Payment_Controller::format_order_for_client(
+    mrd_order_row(array('status' => 'completed', 'verified_at' => '2026-10-16 09:00:00')),
+    array('polling' => true)
