+            && 'rejected' === (string) $row->status
+            && !empty($row->admin_review_note)
+        ) {
+            $item['adminNote'] = (string) $row->admin_review_note;
+        }
+
+        if ($polling) {
+            // کلیدهای مخصوص پولینگ: اپ نباید واژگان وضعیت را خودش تفسیر کند.
+            $item['updatedAt'] = !empty($row->updated_at) ? (string) $row->updated_at : null;
+            $item['isPaid'] = self::is_paid_status($row->status);
+            $item['isTerminal'] = self::is_terminal_status($row->status);
+        }
+
+        return $item;
+    }
+
+    /**
+     * v1.8.0: GET /payment/order/{orderId} — وضعیت یک سفارش برای پولینگ.
+     *
+     * مالکیت در خود WHERE بررسی می‌شود (مثل گارد نشست‌ها): سفارش کاربر دیگر
+     * همان ۴۰۴ «یافت نشد» را می‌گیرد، پس نمی‌شود با حدس‌زدن شناسه، وجود
+     * سفارش‌های دیگران را شمارش کرد.
+     *
+     * @param WP_REST_Request $request
+     * @return WP_REST_Response|WP_Error
+     */
+    public function handle_get_order($request) {
+        global $wpdb;
+
+        $user_id = get_current_user_id();
+        if ($user_id <= 0) {
+            return new WP_Error('unauthorized', 'برای مشاهدهٔ سفارش ابتدا وارد حساب کاربری خود شوید.', array('status' => 401));
+        }
+
+        $order_id = (string) $request->get_param('orderId');
+        if ('' === $order_id) {
+            return new WP_Error('invalid_order', 'شناسهٔ سفارش معتبر نیست.', array('status' => 400));
+        }
+
+        $table_orders = $wpdb->prefix . 'mrdastbaaf_orders';
+        $table_transfers = $wpdb->prefix . 'mrdastbaaf_manual_transfers';
+
+        $row = $wpdb->get_row($wpdb->prepare(
+            "SELECT o.*, t.admin_review_note
+             FROM $table_orders o
+             LEFT JOIN $table_transfers t ON t.order_id = o.id
+             WHERE o.id = %s AND o.user_id = %d
+             LIMIT 1",
+            $order_id,
+            $user_id
+        ));
+
+        if (!$row) {
+            return new WP_Error('order_not_found', 'سفارشی با این شناسه یافت نشد.', array('status' => 404));
+        }
+
+        return rest_ensure_response(array(
+            'success' => true,
+            'order' => self::format_order_for_client($row, array('polling' => true)),
+        ));
+    }
