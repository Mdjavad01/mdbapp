+     *
+     * @param mixed $value
+     * @return bool
+     */
+    public function validate_order_id($value) {
+        return (bool) preg_match('/^[A-Za-z0-9_\-]{1,64}$/', (string) $value);
+    }
+
+    /**
+     * شکل‌دهی یک ردیف سفارش برای کلاینت — تنها جایی که این شکل تعریف می‌شود.
