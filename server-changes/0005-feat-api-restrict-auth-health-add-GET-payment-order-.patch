new file mode 100644
index 0000000..6cc91d4
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-health-access.php
@@ -0,0 +1,137 @@
+<?php
+/**
+ * تست محدودسازی اندپوینت سلامت‌سنجی (test-health-access) — بدون وردپرس
+ *
+ * اجرا: php tests/php/test-health-access.php
+ *
+ * ─── چرا این تست مهم است ───
+ * GET /auth/health عمومی بود و اطلاعات داخلی هاست را لو می‌داد: نسخهٔ افزونه،
+ * تایمینگ خواندن/نوشتن دیتابیس، وضعیت صف OTP، نام کالبک‌های فیلتر و نتیجهٔ
+ * تست اتصال خروجی. هیچ‌کدام رمز نیست، ولی با هم نقشهٔ خوبی برای مهاجم می‌سازد.
+ *
+ * جهت خطا اینجا مهم است: اگر منطق اشتباه کند، نتیجه «باز شدن» است نه «بسته
+ * شدن». پس تست عمداً روی حالت‌های مرزی تمرکز دارد — رشتهٔ خالی محیط، مقدار
+ * ناشناخته، توکن تنظیم‌نشده، و توکن اشتباه.
+ */
+
+define('ABSPATH', '/tmp/');
+
+$GLOBALS['mrd_test_options'] = array();
+
+if (!function_exists('get_option')) {
+    function get_option($name, $default = false) {
+        return isset($GLOBALS['mrd_test_options'][$name]) ? $GLOBALS['mrd_test_options'][$name] : $default;
+    }
+}
+
+require_once __DIR__ . '/../../includes/class-auth-controller.php';
+
+$pass = 0;
+$fail = 0;
+
+function mrd_assert($label, $actual, $expected) {
+    global $pass, $fail;
+    if ($actual === $expected) {
+        $pass++;
+        echo "PASS: {$label}\n";
+    } else {
+        $fail++;
+        echo "FAIL: {$label} — expected: " . var_export($expected, true) . " | got: " . var_export($actual, true) . "\n";
+    }
+}
+
+$allow = 'MrDastbaaf_Auth_Controller::health_access_allowed_for';
+
+// ─── ۱) محیط‌های غیرproduction باز می‌مانند ────────────────────────────────
+//
+// کاربرد اصلی این اندپوینت عیب‌یابی بدون دسترسی به پیشخوان است؛ روی استیجینگ
+// باید بی‌دردسر کار کند.
+
+mrd_assert('local is allowed without a token', $allow('local', '', ''), true);
+mrd_assert('development is allowed without a token', $allow('development', '', ''), true);
+mrd_assert('staging is allowed without a token', $allow('staging', '', ''), true);
+mrd_assert('a mixed-case environment name is normalised', $allow('Staging', '', ''), true);
+mrd_assert('surrounding whitespace is trimmed', $allow(' development ', '', ''), true);
+
+// ─── ۲) production بدون توکن ⇒ کاملاً خاموش ────────────────────────────────
+
+mrd_assert('production without a configured token is denied', $allow('production', '', ''), false);
+mrd_assert('production with a token but none configured is denied', $allow('production', 'anything', ''), false);
+mrd_assert('production with a configured token but none provided is denied', $allow('production', '', 'secret-token'), false);
+
+// ─── ۳) production با توکن درست ⇒ مجاز ────────────────────────────────────
+
+mrd_assert('production with the matching token is allowed', $allow('production', 'secret-token', 'secret-token'), true);
+
+mrd_assert(
+    'a wrong token of the same length is denied',
+    $allow('production', 'secret-tokeX', 'secret-token'),
+    false
+);
+mrd_assert(
+    'a prefix of the token is denied',
+    $allow('production', 'secret', 'secret-token'),
+    false
+);
+mrd_assert(
+    'a token with different case is denied',
+    $allow('production', 'SECRET-TOKEN', 'secret-token'),
+    false
+);
+mrd_assert(
+    'an empty provided token never matches a configured one',
+    $allow('production', '', ''),
+    false
+);
+
+// ─── ۴) حالت‌های مرزی — جهت خطا باید «بسته» باشد ──────────────────────────
+//
+// این‌ها مهم‌ترین بخش‌اند: اگر wp_get_environment_type روزی مقدار عجیبی برگرداند
+// یا ثابت درست تنظیم نشده باشد، نباید اندپوینت باز شود.
+
+mrd_assert('an empty environment string is treated as production', $allow('', 'x', 'x'), true);
+// ↑ با توکن درست مجاز است؛ ولی بدون توکن باید بسته باشد:
+mrd_assert('an empty environment string without a token is denied', $allow('', '', ''), false);
+
+mrd_assert('an unknown environment name requires the token', $allow('qa', '', ''), false);
+mrd_assert('an unknown environment name works with the token', $allow('qa', 't', 't'), true);
+
+// مقدارهایی که می‌توانند به‌اشتباه «محیط توسعه» تلقی شوند.
+mrd_assert('the literal string production is never treated as development', $allow('production', '', ''), false);
+mrd_assert('a near-miss environment name is not allowed', $allow('productionn', '', ''), false);
+mrd_assert('the word dev is not in the allow-list', $allow('dev', '', ''), false);
+
+// ─── ۵) پوشش وردپرسی ───────────────────────────────────────────────────────
+//
+// health_access_allowed() همان منطق را با خواندن محیط/توکن از وردپرس صدا
+// می‌زند. اینجا فقط مسیر «توکن از گزینه» آزموده می‌شود (محیط را نمی‌توان بدون
+// وردپرس عوض کرد، پس روی production نمی‌مانیم).
+
+$GLOBALS['mrd_test_options']['mrdastbaaf_health_token'] = 'option-token';
+
+mrd_assert(
+    'health_token reads the option',
+    MrDastbaaf_Auth_Controller::health_token(),
+    'option-token'
+);
+
+// ثابت wp-config باید بر گزینه اولویت داشته باشد.
+define('MRDASTBAAF_HEALTH_TOKEN', 'constant-token');
+mrd_assert(
+    'health_token prefers the wp-config constant over the option',
+    MrDastbaaf_Auth_Controller::health_token(),
+    'constant-token'
+);
+
+// نبود WP_ENVIRONMENT_TYPE ⇒ امن‌ترین فرض (production).
+mrd_assert(
+    'environment_type falls back to production when WordPress cannot tell',
+    MrDastbaaf_Auth_Controller::environment_type(),
+    'production'
+);
+
+echo "\n---- result ----\n";
+echo "PASS: {$pass}\n";
+echo "FAIL: {$fail}\n";
+
+exit($fail > 0 ? 1 : 0);
