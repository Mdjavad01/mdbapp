         ) $charset_collate;";
         dbDelta($sql_tokens);
 
+        // ۱۰. موقعیت پخش درس (v1.8.0 — اسکیما ۱.۷.۰)
+        //
+        // پیش از این، تنها وضعیت پیشرفتِ ذخیره‌شدنی «تکمیل‌شده» و «نشان‌شده» بود
+        // (usermeta mrdastbaaf_progress). کاربری که نیمهٔ یک درس یک‌ساعته را
+        // می‌دید و اپ را می‌بست، بار بعد از ابتدا شروع می‌کرد.
+        //
+        // چرا جدول و نه usermeta: موقعیت «هر درس» یک ردیف است؛ در usermeta این
+        // به یک آرایهٔ JSON بزرگ و بازنویسی کل آن در هر ۵ ثانیه تبدیل می‌شد
+        // (نوشتن سنگین روی ردیف مشترک — همان الگویی که حادثهٔ تعلیق ۱.۷.۹ را
+        // ساخت). اینجا هر نوشتن یک UPSERT کوچک روی کلید یکتاست.
+        //
+        // UNIQUE(user_id, lesson_id): تضمین دیتابیس در برابر ردیف تکراری وقتی
+        // پلیر و رویداد «خروج از فورگراند» هم‌زمان PUT می‌فرستند.
+        //
+        // lesson_id از نوع varchar است (نه bigint) چون مسیر فیلتر قدیمی
+        // شناسهٔ رشته‌ای هم می‌پذیرد و باید همان قرارداد باقی بماند.
+        $table_progress = $wpdb->prefix . 'mrdastbaaf_lesson_progress';
+        $sql_progress = "CREATE TABLE $table_progress (
+            id bigint(20) unsigned NOT NULL AUTO_INCREMENT,
+            user_id bigint(20) unsigned NOT NULL,
+            lesson_id varchar(64) NOT NULL,
+            position_seconds int(11) unsigned DEFAULT 0 NOT NULL,
+            duration_seconds int(11) unsigned DEFAULT 0 NOT NULL,
+            completed tinyint(1) DEFAULT 0 NOT NULL,
+            updated_at datetime NOT NULL,
+            PRIMARY KEY  (id),
+            UNIQUE KEY user_lesson_idx (user_id, lesson_id),
+            KEY user_updated_idx (user_id, updated_at)
+        ) $charset_collate;";
+        dbDelta($sql_progress);
+
         // درج پلن‌های پیش‌فرض در صورت خالی بودن جدول
         self::seed_initial_plans();
     }
