+<?php
+/**
+ * کنترلر موقعیت پخش درس (v1.8.0 — اسکیما ۱.۷.۰)
+ *
+ * چرا این اندپوینت لازم شد: پیش از این، تنها وضعیت پیشرفتِ قابل‌ذخیره
+ * «تکمیل‌شده» و «نشان‌شده» بود (PUT /me/progress). کاربری که نیمهٔ یک درس
+ * یک‌ساعته را می‌دید و بعد اپ را می‌بست، هر بار از ابتدا شروع می‌کرد — چون
+ * سرور هیچ‌جا «ثانیهٔ آخر» را نگه نمی‌داشت.
+ *
+ * این کنترلر موقعیت را جدا از پرچم تکمیل نگه می‌دارد:
+ *   - منبع حقیقت «موقعیت» همین جدول است (هر کاربر، هر درس، یک ردیف)
+ *   - پرچم «تکمیل» پس از عبور از آستانه، در همان مسیر /me/progress هم نوشته
+ *     می‌شود تا داشبورد و پخش هرگز واگرا نشوند
+ *
+ * ─── تصمیم عمدی: بدون گارد دسترسی ───
+ * این اندپوینت «دسترسی به درس» را بررسی نمی‌کند؛ فقط ورود کاربر را لازم دارد.
+ * دلیل: (۱) پخش از قبل با بلیط معتبر انجام شده و موقعیت فقط در همان جریان
+ * فرستاده می‌شود، (۲) کسی که درخواست را دستی می‌سازد فقط داشبورد خودش را
+ * آلوده می‌کند — نه دارایی‌ای می‌گیرد و نه به دادهٔ دیگری دست می‌زند، (۳) گارد
+ * دسترسی در کنترلر دوره‌ها خصوصی است و بیرون‌کشیدنش برای یک اثر «آرایشی»
+ * پیچیدگی بی‌مورد می‌آورد. اگر روزی تکمیل درس به گواهی/امتیاز گره بخورد، این
+ * تصمیم باید بازبینی شود.
+ *
+ * ─── مهار نوشتن ───
+ * پلیر هر چند ثانیه یک PUT می‌فرستد. برای هاست اشتراکی (و با توجه به حادثهٔ
+ * تعلیق ۱.۷.۹–۱.۷.۱۳ که ریشه‌اش نوشتن‌های پرتکرار بود) نوشتن‌های بی‌اثر حذف
+ * می‌شوند: جهش کمتر از MIN_POSITION_DELTA_SECONDS نوشته نمی‌شود.
+ */
+
+if (!defined('ABSPATH')) {
+    exit;
+}
+
+class MrDastbaaf_Lesson_Progress_Controller {
+
+    /**
+     * آستانهٔ «تکمیل» — ۹۵٪ مدت درس.
+     *
+     * دقیقاً ۱۰۰٪ غیرواقعی است: تیتراژ پایانی/سکوت آخر باعث می‌شود کاربر
+     * عملاً هرگز به انتهای فایل نرسد و درس هرگز «تکمیل‌شده» نشود.
+     */
+    const COMPLETION_RATIO = 0.95;
+
+    /**
+     * کمینهٔ موقعیتی که «پیشرفت واقعی» حساب می‌شود.
+     *
+     * اگر کاربری درسی را فقط باز کند و ببندد (۲-۳ ثانیه)، موقعیت ذخیره‌شدهٔ
+     * قبلی‌اش نباید پاک شود. این ثابت همان محافظ است.
+     */
+    const MIN_MEANINGFUL_SECONDS = 5;
+
+    /**
+     * کمینهٔ جهش لازم برای یک نوشتن.
+     *
+     * PUT با فاصلهٔ کمتر از این مقدار نسبت به مقدار ذخیره‌شده، نوشته نمی‌شود.
+     * جست‌وجوی عقب/جلو (جهش بزرگ) همیشه ذخیره می‌شود.
+     */
+    const MIN_POSITION_DELTA_SECONDS = 5;
+
+    /**
+     * سقف سلامت موقعیت — ۲۴ ساعت. مقدار بزرگ‌تر یعنی کلاینت خراب/دستکاری‌شده؛
+     * ذخیرهٔ آن باعث می‌شود بعداً «ادامهٔ پخش» کاربر را به انتهای بی‌معنا ببرد.
+     */
+    const MAX_POSITION_SECONDS = 86400;
+
+    public function register_routes() {
+        register_rest_route(
+            MRDASTBAAF_API_NAMESPACE,
+            '/lessons/(?P<id>[a-zA-Z0-9_-]+)/progress',
+            array(
+                array(
+                    'methods' => 'GET',
+                    'callback' => array($this, 'handle_get_progress'),
+                    'permission_callback' => array('MrDastbaaf_Auth_Controller', 'permission_logged_in'),
+                ),
+                array(
+                    'methods' => 'PUT',
+                    'callback' => array($this, 'handle_put_progress'),
+                    'permission_callback' => array('MrDastbaaf_Auth_Controller', 'permission_logged_in'),
+                ),
+            )
+        );
+    }
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // بخش خالص (بدون وردپرس) — قابل آزمون در tests/php/test-lesson-progress.php
+    // ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * نرمال‌سازی و کرانه‌گذاری موقعیت/مدت.
+     *
+     * @param mixed $position ثانیهٔ اعلامی کلاینت
+     * @param mixed $duration مدت کل درس
+     * @return array ['position' => int, 'duration' => int]
+     */
+    public static function normalize_values($position, $duration) {
+        $position = (int) $position;
+        $duration = (int) $duration;
+
+        $position = max(0, min($position, self::MAX_POSITION_SECONDS));
+        $duration = max(0, min($duration, self::MAX_POSITION_SECONDS));
+
+        // موقعیت هرگز از مدت جلو نمی‌زند؛ اگر کلاینت مدت را کوچک‌تر فرستاد،
+        // موقعیت به همان مدت بریده می‌شود.
+        if ($duration > 0 && $position > $duration) {
+            $position = $duration;
+        }
+
+        return array('position' => $position, 'duration' => $duration);
+    }
+
+    /**
+     * آیا این موقعیت درس را «تکمیل‌شده» می‌کند؟
+     *
+     * مدت صفر هرگز تکمیل نمی‌شود: بدون مدت، هیچ نسبتی معنا ندارد و «تکمیل»
+     * بی‌دلیل روی داشبورد ظاهر می‌شد.
+     */
+    public static function is_completed($position, $duration) {
+        $values = self::normalize_values($position, $duration);
+        if ($values['duration'] <= 0) {
+            return false;
+        }
+
+        return $values['position'] >= (int) ceil($values['duration'] * self::COMPLETION_RATIO);
+    }
+
+    /**
+     * آیا مقدار تازه باید نوشته شود؟
+     *
+     * @param int $new_position      موقعیت تازه (نرمال‌شده)
+     * @param int $existing_position موقعیت ذخیره‌شده (۰ اگر ردیفی نیست)
+     * @param int $duration          مدت درس
+     * @return bool
+     */
+    public static function should_store($new_position, $existing_position, $duration) {
+        $new_position = (int) $new_position;
+        $existing_position = (int) $existing_position;
+
+        // گذر به «تکمیل‌شده» همیشه نوشته می‌شود — حتی اگر جهش کوچک باشد.
+        if (self::is_completed($new_position, $duration) && !self::is_completed($existing_position, $duration)) {
+            return true;
+        }
+
+        // باز کردن گذرا (زیر آستانهٔ معنادار) پیشرفت واقعی را پاک نمی‌کند.
+        if ($new_position < self::MIN_MEANINGFUL_SECONDS
+            && $existing_position >= self::MIN_MEANINGFUL_SECONDS) {
+            return false;
+        }
+
+        // جهش کافی نداشته ⇒ نوشتن بی‌اثر.
+        if (abs($new_position - $existing_position) < self::MIN_POSITION_DELTA_SECONDS) {
+            return false;
+        }
+
+        return true;
+    }
+
+    /**
+     * شناسهٔ درس معتبر؟
+     *
+     * همان الگوی مسیرهای بلیط/پخش: شناسه‌های جدول عددی‌اند، اما مسیر فیلتر
+     * قدیمی هم شناسهٔ رشته‌ای می‌پذیرفت — پس هر دو شکل مجاز است.
+     */
+    public static function is_valid_lesson_id($lesson_id) {
+        $lesson_id = (string) $lesson_id;
+        if ('' === $lesson_id || strlen($lesson_id) > 64) {
+            return false;
+        }
+        return (bool) preg_match('/^[a-zA-Z0-9_-]+$/', $lesson_id);
+    }
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // بخش DB-محور
+    // ─────────────────────────────────────────────────────────────────────────
+
+    public static function table() {
+        global $wpdb;
+        return $wpdb->prefix . 'mrdastbaaf_lesson_progress';
+    }
+
+    /**
+     * GET /lessons/{id}/progress
+     *
+     * @param WP_REST_Request $request
+     * @return WP_REST_Response|WP_Error
+     */
+    public function handle_get_progress(WP_REST_Request $request) {
+        $lesson_id = (string) $request->get_param('id');
+        if (!self::is_valid_lesson_id($lesson_id)) {
+            return new WP_Error('invalid_lesson', 'شناسهٔ درس نامعتبر است.', array('status' => 400));
+        }
+
+        $user_id = get_current_user_id();
+        $row = self::fetch_row($user_id, $lesson_id);
+
+        return rest_ensure_response(self::format_response($lesson_id, $row));
+    }
+
+    /**
+     * PUT /lessons/{id}/progress
+     *
+     * بدنه: { positionSeconds: number, durationSeconds?: number }
+     *
+     * پاسخ، وضعیت «ذخیره‌شده» را برمی‌گرداند (نه لزوماً ورودی کلاینت) تا اگر
+     * نوشتن به‌دلیل مهار جهش رد شد، کلاینت بداند مقدار واقعی روی سرور چیست.
+     *
+     * @param WP_REST_Request $request
+     * @return WP_REST_Response|WP_Error
+     */
+    public function handle_put_progress(WP_REST_Request $request) {
+        $lesson_id = (string) $request->get_param('id');
+        if (!self::is_valid_lesson_id($lesson_id)) {
+            return new WP_Error('invalid_lesson', 'شناسهٔ درس نامعتبر است.', array('status' => 400));
+        }
+
+        $user_id = get_current_user_id();
+        if ($user_id <= 0) {
+            return new WP_Error('unauthorized', 'برای ثبت پیشرفت ابتدا وارد حساب کاربری خود شوید.', array('status' => 401));
+        }
+
+        $raw_position = $request->get_param('positionSeconds');
+        if (null === $raw_position || !is_numeric($raw_position)) {
+            return new WP_Error('invalid_position', 'موقعیت پخش ارسال نشده است.', array('status' => 400));
+        }
+
+        $raw_duration = $request->get_param('durationSeconds');
+
+        $existing = self::fetch_row($user_id, $lesson_id);
+        $existing_position = $existing ? (int) $existing['position_seconds'] : 0;
+
+        // مدت: مقدار تازه اگر معتبر بود، وگرنه مدتِ ذخیره‌شده. بدون این، یک
+        // درخواست بدون durationSeconds مدت قبلی را صفر می‌کرد و آستانهٔ تکمیل
+        // را از کار می‌انداخت.
+        $duration = is_numeric($raw_duration)
+            ? (int) $raw_duration
+            : ($existing ? (int) $existing['duration_seconds'] : 0);
+
+        $values = self::normalize_values($raw_position, $duration);
+
+        if (!self::should_store($values['position'], $existing_position, $values['duration'])) {
+            // نوشتن بی‌اثر — وضعیت فعلی برگردانده می‌شود (بدون کوئری نوشتن).
+            return rest_ensure_response(
+                array_merge(
+                    self::format_response($lesson_id, $existing),
+                    array('stored' => false)
+                )
+            );
+        }
+
+        $completed = self::is_completed($values['position'], $values['duration']);
+        $now = current_time('mysql');
+
+        $saved = self::upsert_row($user_id, $lesson_id, $values['position'], $values['duration'], $completed, $now);
+        if (false === $saved) {
+            return new WP_Error('db_error', 'ثبت پیشرفت ممکن نشد؛ لطفاً دوباره تلاش کنید.', array('status' => 500));
+        }
+
+        // پرچم تکمیل در همان منبعی نوشته می‌شود که داشبورد از آن می‌خواند، تا
+        // /me/progress و موقعیت پخش هرگز واگرا نشوند.
+        if ($completed) {
+            $memberships = new MrDastbaaf_Memberships_Controller();
+            $memberships->mark_lesson_completed($user_id, $lesson_id);
+        }
+
+        return rest_ensure_response(
+            array(
+                'lessonId'        => $lesson_id,
+                'positionSeconds' => $values['position'],
+                'durationSeconds' => $values['duration'],
+                'completed'       => $completed,
+                'updatedAt'       => $now,
+                'stored'          => true,
+            )
+        );
+    }
+
+    /**
+     * خواندن ردیف پیشرفت (یا null).
+     */
+    private static function fetch_row($user_id, $lesson_id) {
+        global $wpdb;
+
+        $user_id = (int) $user_id;
+        if ($user_id <= 0) {
+            return null;
+        }
+
+        $row = $wpdb->get_row(
+            $wpdb->prepare(
+                'SELECT * FROM ' . self::table() . ' WHERE user_id = %d AND lesson_id = %s LIMIT 1',
+                $user_id,
+                (string) $lesson_id
+            ),
+            ARRAY_A
+        );
+
+        return is_array($row) ? $row : null;
+    }
+
+    /**
+     * درج/به‌روزرسانی اتمیک ردیف پیشرفت.
+     *
+     * از INSERT … ON DUPLICATE KEY UPDATE استفاده می‌کند تا دو PUT هم‌زمان
+     * (پلیر + رویداد خروج از فورگراند) ردیف تکراری نسازند؛ UNIQUE(user_id,
+     * lesson_id) تضمین دیتابیس است و این کوئری همان را به‌کار می‌گیرد.
+     *
+     * @return bool
+     */
+    private static function upsert_row($user_id, $lesson_id, $position, $duration, $completed, $updated_at) {
+        global $wpdb;
+
+        $sql = 'INSERT INTO ' . self::table() . '
+                    (user_id, lesson_id, position_seconds, duration_seconds, completed, updated_at)
+                VALUES (%d, %s, %d, %d, %d, %s)
+                ON DUPLICATE KEY UPDATE
+                    position_seconds = VALUES(position_seconds),
+                    duration_seconds = VALUES(duration_seconds),
+                    completed        = VALUES(completed),
+                    updated_at       = VALUES(updated_at)';
+
+        $result = $wpdb->query(
+            $wpdb->prepare(
+                $sql,
+                (int) $user_id,
+                (string) $lesson_id,
+                (int) $position,
+                (int) $duration,
+                $completed ? 1 : 0,
+                (string) $updated_at
+            )
+        );
+
+        return (false !== $result);
+    }
+
+    /**
+     * شکل قراردادی پاسخ — کلیدها در همهٔ حالت‌ها حاضرند تا کلاینت به کلید
+     * ناموجود برخورد نکند.
+     */
+    private static function format_response($lesson_id, $row) {
+        if (!is_array($row)) {
+            return array(
+                'lessonId'        => (string) $lesson_id,
+                'positionSeconds' => 0,
+                'durationSeconds' => 0,
+                'completed'       => false,
+                'updatedAt'       => null,
+            );
+        }
+
+        return array(
+            'lessonId'        => (string) $row['lesson_id'],
+            'positionSeconds' => (int) $row['position_seconds'],
+            'durationSeconds' => (int) $row['duration_seconds'],
+            'completed'       => ((int) $row['completed'] === 1),
+            'updatedAt'       => !empty($row['updated_at']) ? (string) $row['updated_at'] : null,
+        );
+    }
+}
