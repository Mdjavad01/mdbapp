diff --git a/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-lesson-progress.php b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-lesson-progress.php
new file mode 100644
index 0000000..19f1a2e
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-lesson-progress.php
@@ -0,0 +1,207 @@
+<?php
+/**
+ * تست مستقل منطق موقعیت پخش درس (test-lesson-progress) — بدون وردپرس
+ *
+ * اجرای روی سرور: php tests/php/test-lesson-progress.php
+ *
+ * فقط متدهای «خالص» کلاس MrDastbaaf_Lesson_Progress_Controller آزموده می‌شوند:
+ *
+ *   - normalize_values()   کرانه‌گذاری موقعیت/مدت و جلوگیری از موقعیت > مدت
+ *   - is_completed()       آستانهٔ ۹۵٪ + رفتار ایمن با مدت صفر
+ *   - should_store()       مهار نوشتن‌های بی‌اثر (محافظت از هاست اشتراکی)
+ *                          و محافظت از پیشرفت واقعی در برابر باز کردن گذرا
+ *   - is_valid_lesson_id() اعتبارسنجی شناسهٔ درس
+ *
+ * چرا این تست مهم است: دو رفتار اینجا مستقیماً به تجربهٔ کاربر آسیب می‌زنند —
+ * (۱) اگر should_store اشتباه کند، یک باز کردنِ دو ثانیه‌ای می‌تواند پیشرفت
+ * نیم‌ساعتهٔ کاربر را پاک کند؛ (۲) اگر is_completed اشتباه کند، درس‌ها یا
+ * هرگز «تکمیل‌شده» نمی‌شوند یا با دیدن چند ثانیه، تکمیل علامت می‌خورند.
+ */
+
+define('ABSPATH', '/tmp/');
+
+require_once __DIR__ . '/../../includes/class-lesson-progress-controller.php';
+
+$pass = 0;
+$fail = 0;
+
+/**
+ * اجرای یک assertion و ثبت نتیجه
+ */
+function mrd_assert($label, $actual, $expected) {
+    global $pass, $fail;
+    if ($actual === $expected) {
+        $pass++;
+        echo "PASS: {$label}\n";
+    } else {
+        $fail++;
+        echo "FAIL: {$label} — expected: " . var_export($expected, true) . " | got: " . var_export($actual, true) . "\n";
+    }
+}
+
+// ─── ۱) کرانه‌گذاری ────────────────────────────────────────────────────────
+
+mrd_assert(
+    'normalize: negative position clamps to 0',
+    MrDastbaaf_Lesson_Progress_Controller::normalize_values(-30, 600),
+    array('position' => 0, 'duration' => 600)
+);
+
+mrd_assert(
+    'normalize: position beyond duration is clamped to duration',
+    MrDastbaaf_Lesson_Progress_Controller::normalize_values(900, 600),
+    array('position' => 600, 'duration' => 600)
+);
+
+mrd_assert(
+    'normalize: absurd values are capped',
+    MrDastbaaf_Lesson_Progress_Controller::normalize_values(999999, 999999),
+    array(
+        'position' => MrDastbaaf_Lesson_Progress_Controller::MAX_POSITION_SECONDS,
+        'duration' => MrDastbaaf_Lesson_Progress_Controller::MAX_POSITION_SECONDS,
+    )
+);
+
+mrd_assert(
+    'normalize: unknown duration (0) keeps the position as reported',
+    MrDastbaaf_Lesson_Progress_Controller::normalize_values(120, 0),
+    array('position' => 120, 'duration' => 0)
+);
+
+mrd_assert(
+    'normalize: non numeric input degrades to 0',
+    MrDastbaaf_Lesson_Progress_Controller::normalize_values('abc', 'xyz'),
+    array('position' => 0, 'duration' => 0)
+);
+
+mrd_assert(
+    'normalize: numeric strings are accepted',
+    MrDastbaaf_Lesson_Progress_Controller::normalize_values('431', '1420'),
+    array('position' => 431, 'duration' => 1420)
+);
+
+// ─── ۲) آستانهٔ تکمیل ──────────────────────────────────────────────────────
+
+mrd_assert('completed: 94 of 100 is not complete', MrDastbaaf_Lesson_Progress_Controller::is_completed(94, 100), false);
+mrd_assert('completed: exactly 95 of 100 is complete', MrDastbaaf_Lesson_Progress_Controller::is_completed(95, 100), true);
+mrd_assert('completed: 100 of 100 is complete', MrDastbaaf_Lesson_Progress_Controller::is_completed(100, 100), true);
+mrd_assert('completed: 0 of 100 is not complete', MrDastbaaf_Lesson_Progress_Controller::is_completed(0, 100), false);
+
+// ۳۳ ثانیه × ۰٫۹۵ = ۳۱٫۳۵ ⇒ سقف ۳۲ ⇒ ۳۱ ناکافی، ۳۲ کافی
+mrd_assert('completed: rounding uses ceil (31 of 33)', MrDastbaaf_Lesson_Progress_Controller::is_completed(31, 33), false);
+mrd_assert('completed: rounding uses ceil (32 of 33)', MrDastbaaf_Lesson_Progress_Controller::is_completed(32, 33), true);
+
+// مدت صفر هرگز تکمیل نمی‌شود — بدون مدت، نسبت بی‌معناست
+mrd_assert('completed: zero duration is never complete', MrDastbaaf_Lesson_Progress_Controller::is_completed(0, 0), false);
+mrd_assert('completed: zero duration with a position is never complete', MrDastbaaf_Lesson_Progress_Controller::is_completed(500, 0), false);
+
+// ─── ۳) مهار نوشتن ─────────────────────────────────────────────────────────
+
+mrd_assert('should_store: first real write is stored', MrDastbaaf_Lesson_Progress_Controller::should_store(120, 0, 600), true);
+
+mrd_assert(
+    'should_store: a no-op write is skipped',
+    MrDastbaaf_Lesson_Progress_Controller::should_store(120, 120, 600),
+    false
+);
+
+mrd_assert(
+    'should_store: a small forward step is skipped',
+    MrDastbaaf_Lesson_Progress_Controller::should_store(123, 120, 600),
+    false
+);
+
+mrd_assert(
+    'should_store: a step at the delta boundary is stored',
+    MrDastbaaf_Lesson_Progress_Controller::should_store(
+        120 + MrDastbaaf_Lesson_Progress_Controller::MIN_POSITION_DELTA_SECONDS,
+        120,
+        600
+    ),
+    true
+);
+
+// محافظ پیشرفت: باز کردن گذرای درس، موقعیت واقعی را پاک نمی‌کند
+mrd_assert(
+    'should_store: a transient 2s open does not erase real progress',
+    MrDastbaaf_Lesson_Progress_Controller::should_store(2, 900, 1800),
+    false
+);
+
+// و اگر پیشرفت واقعی هم نباشد، موقعیت ناچیز اصلاً ردیف نمی‌سازد.
+//
+// این «باگ» نیست: ذخیرهٔ ۲ ثانیه یعنی دفعهٔ بعد «ادامهٔ پخش» کاربر را روی
+// ثانیهٔ ۲ می‌گذارد، که بدتر از شروع از ابتداست. ضمناً جهش ۲ ثانیه‌ای از صفر
+// از آستانهٔ MIN_POSITION_DELTA_SECONDS هم کوچک‌تر است، پس همین قاعدهٔ کلی
+// آن را پوشش می‌دهد.
+mrd_assert(
+    'should_store: a sub-threshold position does not create a row at all',
+    MrDastbaaf_Lesson_Progress_Controller::should_store(2, 0, 1800),
+    false
+);
+
+// ضبط پیشرفت از آستانهٔ جهش شروع می‌شود — نه از صفر مطلق
+mrd_assert(
+    'should_store: recording begins at the delta threshold, not before',
+    MrDastbaaf_Lesson_Progress_Controller::should_store(
+        MrDastbaaf_Lesson_Progress_Controller::MIN_POSITION_DELTA_SECONDS - 1,
+        0,
+        1800
+    ),
+    false
+);
+mrd_assert(
+    'should_store: the first storable position is exactly the delta threshold',
+    MrDastbaaf_Lesson_Progress_Controller::should_store(
+        MrDastbaaf_Lesson_Progress_Controller::MIN_POSITION_DELTA_SECONDS,
+        0,
+        1800
+    ),
+    true
+);
+
+// جست‌وجوی عقب (rewind) باید ذخیره شود
+mrd_assert(
+    'should_store: seeking backwards is stored',
