@@ -168,6 +168,65 @@ class MrDastbaaf_Memberships_Controller {
         );
     }
 
+    /**
+     * v1.8.0: افزودن یک درس به فهرست «تکمیل‌شده»های کاربر — نقطهٔ ورود عمومی.
+     *
+     * از کنترلر موقعیت پخش صدا زده می‌شود: وقتی موقعیت از آستانهٔ تکمیل عبور
+     * کند، همان پرچم در همین منبع (که داشبورد از آن می‌خواند) هم نوشته می‌شود
+     * تا /me/progress و موقعیت پخش هرگز واگرا نشوند.
+     *
+     * چرا متد عمومی روی همین کلاس و نه نوشتن مستقیم در کنترلر پخش: قالب ذخیره
+     * (کلید usermeta، شکل JSON، پالایش و سقف ۵۰۰ مورد) مالِ همین کلاس است؛
+     * نوشتن موازی از جای دیگر یعنی دو پیاده‌سازی که دیر یا زود واگرا می‌شوند.
+     *
+     * idempotent: اگر درس از قبل در فهرست باشد، هیچ نوشتنی انجام نمی‌شود.
+     *
+     * @param int    $user_id
+     * @param string $lesson_id
+     * @return bool آیا نوشتنی انجام شد؟
+     */
+    public function mark_lesson_completed($user_id, $lesson_id) {
+        $user_id = (int) $user_id;
+        $lesson_id = (string) $lesson_id;
+        if ($user_id <= 0 || '' === $lesson_id) {
+            return false;
+        }
+
+        $raw = get_user_meta($user_id, 'mrdastbaaf_progress', true);
+        $data = (is_string($raw) && '' !== $raw) ? json_decode($raw, true) : array();
+        if (!is_array($data)) {
+            $data = array(); // JSON خراب/دستکاری‌شده = صفرِ تمیز (fail-safe)
+        }
+
+        $completed = $this->clean_progress_ids(isset($data['completedLessonIds']) ? $data['completedLessonIds'] : array());
+        $bookmarked = $this->clean_progress_ids(isset($data['bookmarkedLessonIds']) ? $data['bookmarkedLessonIds'] : array());
+
+        if (in_array($lesson_id, $completed, true)) {
+            return false; // از قبل ثبت شده — بدون نوشتن
+        }
+
+        // سقف فهرست: اگر پر است، قدیمی‌ترین حذف می‌شود تا «تازه‌ترین تکمیل»
+        // هرگز قربانی سقف نشود (appending و بعد بریدن، همین را برعکس می‌کرد).
+        if (count($completed) >= self::PROGRESS_MAX_ITEMS) {
+            array_shift($completed);
+        }
+        $completed[] = $lesson_id;
+
+        update_user_meta(
+            $user_id,
+            'mrdastbaaf_progress',
+            wp_json_encode(
+                array(
+                    'completedLessonIds'  => $completed,
+                    'bookmarkedLessonIds' => $bookmarked,
+                ),
+                JSON_UNESCAPED_UNICODE
+            )
+        );
+
+        return true;
+    }
+
     /**
      * ذخیرهٔ پیشرفت — replace semantics + اعتبارسنجی سخت
      *
