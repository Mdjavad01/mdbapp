diff --git a/wordpress-plugin/mrdastbaaf-bridge/tests/php/run-all.sh b/wordpress-plugin/mrdastbaaf-bridge/tests/php/run-all.sh
new file mode 100644
index 0000000..dfe75ee
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/tests/php/run-all.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+#
+# Runs every standalone PHP test in the plugin.
+#
+# These tests deliberately do NOT need WordPress: they define ABSPATH and the
+# WordPress time constants themselves, then exercise only the pure logic of the
+# classes they load. That keeps them runnable on a bare PHP CLI, on the server,
+# and in CI — which is the only way they actually get run.
+#
+# Usage:
+#   ./tests/php/run-all.sh              # uses `php` from PATH
+#   PHP=/path/to/php ./tests/php/run-all.sh
+#
+# Exit code is non-zero if any test file fails.
+
+set -u
+
+PHP_BIN="${PHP:-php}"
+
+if ! command -v "$PHP_BIN" >/dev/null 2>&1; then
+    echo "error: PHP binary not found (looked for '$PHP_BIN')" >&2
+    echo "hint: set PHP=/path/to/php" >&2
+    exit 127
+fi
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+echo "PHP: $("$PHP_BIN" -r 'echo PHP_VERSION;')"
+echo
+
+total_pass=0
+total_fail=0
+failed_files=0
+
+for test_file in "$SCRIPT_DIR"/test-*.php; do
+    [ -e "$test_file" ] || continue
+
+    name="$(basename "$test_file")"
+    echo "──────── $name"
+
+    output="$("$PHP_BIN" "$test_file" 2>&1)"
+    status=$?
+
+    # Surface only the summary lines in the aggregate view; the full output of a
+    # failing test is printed so the failure is diagnosable without re-running.
+    if [ $status -eq 0 ]; then
+        echo "$output" | grep -E '^(PASS|FAIL): [0-9]+$'
+    else
+        echo "$output"
+        failed_files=$((failed_files + 1))
+    fi
+
+    file_pass="$(echo "$output" | sed -n 's/^PASS: \([0-9]\+\)$/\1/p' | tail -1)"
+    file_fail="$(echo "$output" | sed -n 's/^FAIL: \([0-9]\+\)$/\1/p' | tail -1)"
+    total_pass=$((total_pass + ${file_pass:-0}))
+    total_fail=$((total_fail + ${file_fail:-0}))
+
+    echo
+done
+
+echo "═══════════════════════════════════════"
+echo "TOTAL PASS: $total_pass"
+echo "TOTAL FAIL: $total_fail"
+echo "FAILED FILES: $failed_files"
+
+if [ "$total_fail" -gt 0 ] || [ "$failed_files" -gt 0 ]; then
+    exit 1
+fi
+
+exit 0
diff --git a/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-token-store.php b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-token-store.php
new file mode 100644
index 0000000..13f1b75
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-token-store.php
@@ -0,0 +1,693 @@
+<?php
+/**
+ * تست مستقل مخزن توکن چند-دستگاهی (test-token-store) — بدون وردپرس
+ *
+ * اجرای روی سرور: php tests/php/test-token-store.php
+ *
+ * فقط متدهای «خالص» کلاس MrDastbaaf_Token_Store آزموده می‌شوند — آن‌هایی که به
+ * $wpdb یا توابع وردپرس نیاز ندارند. مسیرهای DB-محور (issue/find/revoke) باید
+ * روی محیط واقعی با تست یکپارچه سنجیده شوند؛ در اینجا فقط «منطق» تضمین می‌شود:
+ *
+ *   - parse_token()      تجزیهٔ «{user_id}.{secret}» و رد ورودی‌های بدشکل
+ *   - hash_secret()      هش قطعی و ۶۴ نویسه‌ای
+ *   - secret_matches()   مقایسهٔ زمان-ثابت + سازگاری با توکن‌های پیش از ارتقا
+ *   - is_usable()        ردیف باطل/منقضی/بدشکل هرگز معتبر نیست (fail-closed)
+ *   - oldest_row_id()    سیاست سقف دستگاه‌ها — همیشه قدیمی‌ترین قربانی می‌شود
+ *   - expiry_from()      عمر دقیق ۳۰ روزه
+ *   - should_touch()     مهار نوشتن last_used_at (محافظت از هاست اشتراکی)
+ *
+ * چرا این تست مهم است: اگر is_usable یا secret_matches اشتباه کنند، خطا در جهت
+ * «باز شدن دسترسی» است نه «بسته شدن» — یعنی توکن باطل‌شده همچنان کار می‌کند.
+ * این تست همان جهت خطا را قفل می‌کند.
+ */
+
+define('ABSPATH', '/tmp/');
+
+// ثابت‌های زمانی وردپرس — در محیط واقعی از هسته می‌آیند؛ اینجا برای بارگذاری
+// کلاس به‌صورت مستقل تعریف می‌شوند (کلاس در ثابت‌های خود از آن‌ها استفاده می‌کند).
+if (!defined('MINUTE_IN_SECONDS')) {
+    define('MINUTE_IN_SECONDS', 60);
+}
+if (!defined('HOUR_IN_SECONDS')) {
+    define('HOUR_IN_SECONDS', 3600);
+}
+if (!defined('DAY_IN_SECONDS')) {
+    define('DAY_IN_SECONDS', 86400);
+}
+
+require_once __DIR__ . '/../../includes/class-token-store.php';
+
+$pass = 0;
+$fail = 0;
+
+/**
+ * اجرای یک assertion و ثبت نتیجه
+ */
+function mrd_assert($label, $actual, $expected) {
+    global $pass, $fail;
+    if ($actual === $expected) {
+        $pass++;
+        echo "PASS: {$label}\n";
+    } else {
+        $fail++;
+        echo "FAIL: {$label} — expected: " . var_export($expected, true) . " | got: " . var_export($actual, true) . "\n";
+    }
+}
+
+// ─── ۱) تجزیهٔ توکن ─────────────────────────────────────────────────────────
+
+mrd_assert(
+    'parse_token: canonical {id}.{secret}',
+    MrDastbaaf_Token_Store::parse_token('42.abcdef123456'),
+    array('user_id' => 42, 'secret' => 'abcdef123456')
+);
+
+mrd_assert(
+    'parse_token: secret containing a dot keeps the remainder intact',
+    MrDastbaaf_Token_Store::parse_token('42.abc.def'),
+    array('user_id' => 42, 'secret' => 'abc.def')
+);
+
+mrd_assert('parse_token: empty string', MrDastbaaf_Token_Store::parse_token(''), null);
+mrd_assert('parse_token: no separator', MrDastbaaf_Token_Store::parse_token('42abcdef'), null);
+mrd_assert('parse_token: zero user id', MrDastbaaf_Token_Store::parse_token('0.abc'), null);
+mrd_assert('parse_token: non numeric user id', MrDastbaaf_Token_Store::parse_token('abc.def'), null);
+mrd_assert('parse_token: empty secret', MrDastbaaf_Token_Store::parse_token('42.'), null);
+mrd_assert('parse_token: trailing dot only', MrDastbaaf_Token_Store::parse_token('42'), null);
+
+// ─── ۲) هش و مقایسه ────────────────────────────────────────────────────────
+
+$hash = MrDastbaaf_Token_Store::hash_secret('secret-value');
+mrd_assert('hash_secret: 64 hex characters', strlen($hash), 64);
+mrd_assert('hash_secret: matches sha256', $hash, hash('sha256', 'secret-value'));
+mrd_assert(
+    'hash_secret: deterministic',
+    MrDastbaaf_Token_Store::hash_secret('secret-value'),
+    MrDastbaaf_Token_Store::hash_secret('secret-value')
+);
+mrd_assert(
+    'hash_secret: different inputs differ',
+    MrDastbaaf_Token_Store::hash_secret('a') === MrDastbaaf_Token_Store::hash_secret('b'),
+    false
+);
+
+mrd_assert('secret_matches: correct secret', MrDastbaaf_Token_Store::secret_matches('secret-value', $hash), true);
+mrd_assert('secret_matches: wrong secret', MrDastbaaf_Token_Store::secret_matches('other-value', $hash), false);
+mrd_assert('secret_matches: empty stored hash is never a match', MrDastbaaf_Token_Store::secret_matches('secret-value', ''), false);
+mrd_assert('secret_matches: empty secret against a real hash', MrDastbaaf_Token_Store::secret_matches('', $hash), false);
+
+// سازگاری با توکن پیش از ارتقا: سرور قدیمی فقط hash را در usermeta داشت.
+// مهاجرت همان hash را در token_hash می‌نویسد، پس همین مقایسه باید کار کند.
+$legacy_secret = wp_stub_generate_secret();
+$legacy_stored = hash('sha256', $legacy_secret);
+mrd_assert(
+    'legacy migration: a pre-upgrade token still validates',
+    MrDastbaaf_Token_Store::secret_matches($legacy_secret, $legacy_stored),
+    true
+);
+
+// ─── ۳) اعتبار ردیف ────────────────────────────────────────────────────────
+
+$now = 1800000000;
+
+$active_row = array(
+    'id' => 7,
+    'revoked_at' => null,
+    'expires_at' => gmdate('Y-m-d H:i:s', $now + 3600),
+);
+mrd_assert('is_usable: active row', MrDastbaaf_Token_Store::is_usable($active_row, $now), true);
+
+$revoked_row = array(
+    'id' => 8,
+    'revoked_at' => gmdate('Y-m-d H:i:s', $now - 10),
+    'expires_at' => gmdate('Y-m-d H:i:s', $now + 3600),
+);
+mrd_assert('is_usable: revoked row is rejected even if unexpired', MrDastbaaf_Token_Store::is_usable($revoked_row, $now), false);
+
+$expired_row = array(
+    'id' => 9,
+    'revoked_at' => null,
+    'expires_at' => gmdate('Y-m-d H:i:s', $now - 1),
+);
+mrd_assert('is_usable: expired row', MrDastbaaf_Token_Store::is_usable($expired_row, $now), false);
+
+// مرز دقیق: انقضا در همان ثانیه یعنی منقضی (fail-closed).
+$boundary_row = array(
+    'id' => 10,
+    'revoked_at' => null,
+    'expires_at' => gmdate('Y-m-d H:i:s', $now),
+);
+mrd_assert('is_usable: expiry exactly at now counts as expired', MrDastbaaf_Token_Store::is_usable($boundary_row, $now), false);
+
+mrd_assert('is_usable: not an array', MrDastbaaf_Token_Store::is_usable('nonsense', $now), false);
+mrd_assert('is_usable: missing expires_at', MrDastbaaf_Token_Store::is_usable(array('id' => 11, 'revoked_at' => null), $now), false);
+mrd_assert('is_usable: malformed expires_at', MrDastbaaf_Token_Store::is_usable(array('id' => 12, 'expires_at' => 'not-a-date'), $now), false);
+
+// ─── ۴) سیاست سقف دستگاه‌ها ────────────────────────────────────────────────
+
+$rows = array(
+    array('id' => 30, 'issued_at' => '2026-10-10 10:00:00'), // جدیدترین
+    array('id' => 10, 'issued_at' => '2026-01-01 10:00:00'), // قدیمی‌ترین
+    array('id' => 20, 'issued_at' => '2026-05-05 10:00:00'),
+);
+mrd_assert('oldest_row_id: picks the earliest issued_at', MrDastbaaf_Token_Store::oldest_row_id($rows), 10);
+
+// tie-break قطعی: دو ردیف با issued_at یکسان ⇒ شناسهٔ کوچک‌تر قربانی می‌شود
+$tied = array(
+    array('id' => 55, 'issued_at' => '2026-01-01 10:00:00'),
+    array('id' => 44, 'issued_at' => '2026-01-01 10:00:00'),
+);
+mrd_assert('oldest_row_id: tie breaks on the lower id deterministically', MrDastbaaf_Token_Store::oldest_row_id($tied), 44);
+
+mrd_assert('oldest_row_id: empty list', MrDastbaaf_Token_Store::oldest_row_id(array()), null);
+mrd_assert('oldest_row_id: skips malformed entries', MrDastbaaf_Token_Store::oldest_row_id(array('junk', array('id' => 3, 'issued_at' => '2026-01-01 00:00:00'))), 3);
+mrd_assert(
+    'oldest_row_id: missing issued_at treated as epoch (oldest)',
+    MrDastbaaf_Token_Store::oldest_row_id(array(array('id' => 99, 'issued_at' => '2026-01-01 00:00:00'), array('id' => 98))),
+    98
+);
+
+// ─── ۵) عمر توکن ───────────────────────────────────────────────────────────
+
+$issued = 1800000000;
+mrd_assert(
+    'expiry_from: exactly 30 days after issue',
+    MrDastbaaf_Token_Store::expiry_from($issued),
+    gmdate('Y-m-d H:i:s', $issued + 30 * 86400)
+);
+mrd_assert('TOKEN_LIFETIME_SECONDS is 30 days', MrDastbaaf_Token_Store::TOKEN_LIFETIME_SECONDS, 2592000);
+mrd_assert('MAX_DEVICES is 3', MrDastbaaf_Token_Store::MAX_DEVICES, 3);
+
+// ─── ۶) مهار نوشتن last_used_at ────────────────────────────────────────────
+
+mrd_assert('should_touch: never touched before', MrDastbaaf_Token_Store::should_touch(null, $now), true);
+mrd_assert('should_touch: empty string', MrDastbaaf_Token_Store::should_touch('', $now), true);
+mrd_assert(
+    'should_touch: touched 1 minute ago is skipped',
+    MrDastbaaf_Token_Store::should_touch(gmdate('Y-m-d H:i:s', $now - 60), $now),
+    false
+);
+mrd_assert(
+    'should_touch: touched 11 minutes ago is written',
+    MrDastbaaf_Token_Store::should_touch(gmdate('Y-m-d H:i:s', $now - 11 * 60), $now),
+    true
+);
+mrd_assert(
+    'should_touch: exactly at the interval boundary writes',
+    MrDastbaaf_Token_Store::should_touch(gmdate('Y-m-d H:i:s', $now - MrDastbaaf_Token_Store::TOUCH_INTERVAL_SECONDS), $now),
+    true
+);
+mrd_assert('should_touch: malformed value falls back to writing', MrDastbaaf_Token_Store::should_touch('garbage', $now), true);
+
+// ─── ۷) هش‌نشدن secret در مسیر ذخیره‌سازی ──────────────────────────────────
+//
+// issue() فقط hash_secret() را در ستون token_hash می‌نویسد. اینجا رفتار هش
+// دوباره تأیید می‌شود تا اگر کسی روزی مقدار خام را جای هش بگذارد، تست بیفتد:
+// هش یک secret هرگز با خود secret برابر نیست.
+
+mrd_assert(
+    'a stored hash never equals the raw secret',
+    MrDastbaaf_Token_Store::hash_secret('plain-secret') === 'plain-secret',
+    false
+);
+mrd_assert(
+    'the stored form is a fixed-length digest regardless of secret length',
+    strlen(MrDastbaaf_Token_Store::hash_secret(str_repeat('x', 512))),
+    64
+);
+
+// ─── ۸) سیاست سقف دستگاه‌ها (خالص) ─────────────────────────────────────────
+//
+// چرا این بخش حیاتی است: قاعدهٔ «قدیمی‌ترین قربانی می‌شود، نه جدیدترین» دقیقاً
+// همان چیزی است که تجربهٔ کاربر را تعیین می‌کند. اگر اشتباه شود، کاربری که روی
+// گوشی تازه وارد شده بلافاصله بیرون انداخته می‌شود و فکر می‌کند اپ خراب است.
+
+/**
+ * ساخت ردیف‌های آزمایشی با issued_at صعودی (id بزرگ‌تر = جدیدتر).
+ */
+function mrd_rows($ids) {
+    $rows = array();
+    foreach ($ids as $id) {
+        $rows[] = array(
+            'id' => $id,
+            'issued_at' => gmdate('Y-m-d H:i:s', 1800000000 + (int) $id),
+            'revoked_at' => null,
+        );
+    }
+    return $rows;
+}
+
+mrd_assert('rows_to_evict: empty list evicts nothing', MrDastbaaf_Token_Store::rows_to_evict(array(), 3), array());
+mrd_assert('rows_to_evict: exactly at the limit evicts nothing', MrDastbaaf_Token_Store::rows_to_evict(mrd_rows(array(1, 2, 3)), 3), array());
+mrd_assert('rows_to_evict: under the limit evicts nothing', MrDastbaaf_Token_Store::rows_to_evict(mrd_rows(array(1, 2)), 3), array());
+
+// یک دستگاه اضافه ⇒ فقط قدیمی‌ترین.
+mrd_assert(
+    'rows_to_evict: one over the limit evicts the oldest',
+    MrDastbaaf_Token_Store::rows_to_evict(mrd_rows(array(1, 2, 3, 4)), 3),
+    array(1)
+);
+
+// دو دستگاه اضافه ⇒ دو قدیمی‌ترین، به ترتیب.
+mrd_assert(
+    'rows_to_evict: two over the limit evicts the two oldest, oldest first',
+    MrDastbaaf_Token_Store::rows_to_evict(mrd_rows(array(1, 2, 3, 4, 5)), 3),
+    array(1, 2)
+);
+
+// ورودی همیشه جدیدترین‌اول نیست؛ نباید به ترتیب آرایه تکیه کند.
+mrd_assert(
+    'rows_to_evict does not depend on the input order (newest first)',
+    MrDastbaaf_Token_Store::rows_to_evict(mrd_rows(array(4, 3, 2, 1)), 3),
+    array(1)
+);
+
+mrd_assert(
+    'rows_to_evict does not depend on the input order (shuffled)',
+    MrDastbaaf_Token_Store::rows_to_evict(mrd_rows(array(3, 1, 4, 2)), 3),
+    array(1)
+);
+
+// tie-break: دو ردیف با issued_at یکسان ⇒ id کوچک‌تر قدیمی‌تر فرض می‌شود.
+$tied = array(
+    array('id' => 5, 'issued_at' => '2026-01-01 00:00:00', 'revoked_at' => null),
+    array('id' => 2, 'issued_at' => '2026-01-01 00:00:00', 'revoked_at' => null),
+    array('id' => 7, 'issued_at' => '2026-01-02 00:00:00', 'revoked_at' => null),
+);
+mrd_assert(
+    'rows_to_evict: a tie on issued_at breaks by lower id',
+    MrDastbaaf_Token_Store::rows_to_evict($tied, 2),
+    array(2)
