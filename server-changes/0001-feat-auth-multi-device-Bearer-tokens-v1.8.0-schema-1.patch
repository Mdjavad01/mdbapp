+
+// ردیف بدون id نادیده گرفته می‌شود (و باعث خطای PHP نمی‌شود).
+mrd_assert(
+    'rows_to_evict ignores rows without an id',
+    MrDastbaaf_Token_Store::rows_to_evict(array(array('issued_at' => '2026-01-01 00:00:00'), array('id' => 9, 'issued_at' => '2026-01-02 00:00:00')), 1),
+    array()
+);
+
+// issued_at نامعتبر ⇒ «قدیمی‌ترین» فرض می‌شود (fail-closed: مشکوک اول بیرون).
+$malformed = array(
+    array('id' => 1, 'issued_at' => 'garbage', 'revoked_at' => null),
+    array('id' => 2, 'issued_at' => '2026-01-02 00:00:00', 'revoked_at' => null),
+);
+mrd_assert(
+    'rows_to_evict treats a malformed issued_at as the oldest (fail-closed)',
+    MrDastbaaf_Token_Store::rows_to_evict($malformed, 1),
+    array(1)
+);
+
+mrd_assert(
+    'rows_to_evict defaults the limit to MAX_DEVICES',
+    MrDastbaaf_Token_Store::rows_to_evict(mrd_rows(array(1, 2, 3, 4))),
+    array(1)
+);
+
+mrd_assert(
+    'oldest_row_id agrees with rows_to_evict',
+    MrDastbaaf_Token_Store::oldest_row_id(mrd_rows(array(4, 2, 3))),
+    2
+);
+
+mrd_assert('oldest_row_id on an empty list', MrDastbaaf_Token_Store::oldest_row_id(array()), null);
+
+// ─── ۹) $wpdb جعلی — برای آزمودن مسیرهای DB-محور ───────────────────────────
+//
+// تا اینجا فقط «منطق» آزموده می‌شد. اما مهم‌ترین نیازمندی این تغییر —
+// «ورود در وب‌اپ نباید توکن اپ را باطل کند» — یک رفتار issue()/find_by_token()
+// است، نه یک تابع خالص. پس یک $wpdb درون‌حافظه‌ای می‌سازیم که فقط همان
+// پرس‌وجوهایی را می‌فهمد که این کلاس صادر می‌کند.
+//
+// ⚠️ صادقانه: این MySQL نیست. اگر پرس‌وجویی متفاوت از آنچه اینجا شبیه‌سازی شده
+// صادر شود، جعلی آن را نمی‌فهمد و نتیجهٔ خالی/صفر می‌دهد — یعنی تست می‌افتد نه
+// اینکه سبزِ کاذب بدهد. اما تضمین نمی‌کند MySQL واقعی همان را بگوید؛ برای آن
+// چک‌لیست استیجینگ در docs/PLUGIN_v1.8.0_MULTI_DEVICE_TOKENS.md است.
+
+if (!defined('ARRAY_A')) {
+    define('ARRAY_A', 'ARRAY_A'); // ثابت وردپرس برای get_results
+}
+
+if (!function_exists('wp_strip_all_tags')) {
+    function wp_strip_all_tags($string) {
+        return trim(strip_tags((string) $string));
+    }
+}
+if (!function_exists('get_user_meta')) {
+    function get_user_meta($user_id, $key, $single = false) {
+        $k = $user_id . ':' . $key;
+        return isset($GLOBALS['mrd_test_usermeta'][$k]) ? $GLOBALS['mrd_test_usermeta'][$k] : '';
+    }
+}
+if (!function_exists('delete_user_meta')) {
+    function delete_user_meta($user_id, $key) {
+        unset($GLOBALS['mrd_test_usermeta'][$user_id . ':' . $key]);
+        return true;
+    }
+}
+
+$GLOBALS['mrd_test_usermeta'] = array();
+
+class Mrd_Fake_Wpdb {
+
+    public $prefix = 'wp_';
+    public $insert_id = 0;
+    public $last_error = '';
+
+    private $rows = array();
+    private $next_id = 1;
+
+    /** جایگزینی ساده و کافی برای $wpdb->prepare (فقط %d/%s/%f). */
+    public function prepare($sql) {
+        $args = func_get_args();
+        array_shift($args);
+        if (count($args) === 1 && is_array($args[0])) {
+            $args = $args[0];
+        }
+
+        $i = 0;
+        return preg_replace_callback(
+            '/%[dsf]/',
+            function ($m) use (&$i, $args) {
+                $v = array_key_exists($i, $args) ? $args[$i] : '';
+                $i++;
+                if ('%d' === $m[0]) {
+                    return (string) (int) $v;
+                }
+                return "'" . str_replace("'", "''", (string) $v) . "'";
+            },
+            (string) $sql
+        );
+    }
+
+    public function insert($table, $data, $formats = null) {
+        $defaults = array(
+            'token_hash'   => '',
+            'device_id'    => '',
+            'device_name'  => '',
+            'platform'     => '',
+            'app_version'  => '',
+            'issued_at'    => null,
+            'expires_at'   => null,
+            'revoked_at'   => null,
+            'last_used_at' => null,
+        );
+
+        $row = array_merge($defaults, (array) $data);
+        $row['id'] = $this->next_id++;
+
+        $this->rows[$table][] = $row;
+        $this->insert_id = $row['id'];
+
+        return 1;
+    }
+
+    public function update($table, $data, $where, $formats = null, $where_formats = null) {
+        $count = 0;
+
+        foreach ($this->rows[$table] as $i => $row) {
+            if (!$this->matches($row, $where)) {
+                continue;
+            }
+            foreach ((array) $data as $k => $v) {
+                $this->rows[$table][$i][$k] = $v;
+            }
+            $count++;
+        }
+
+        return $count;
+    }
+
+    public function get_results($sql, $mode = null) {
+        $sql = trim((string) $sql);
+
+        // الگوی list_for_user / find_by_token
+        if (preg_match('/^SELECT \* FROM (\S+) WHERE user_id = (\d+) AND revoked_at IS NULL ORDER BY issued_at DESC, id DESC$/', $sql, $m)) {
+            $out = array();
+            foreach ($this->rows[$m[1]] as $row) {
+                if ((int) $row['user_id'] === (int) $m[2] && null === $row['revoked_at']) {
+                    $out[] = $row;
+                }
+            }
+            usort($out, function ($a, $b) {
+                $ta = strtotime((string) $a['issued_at']);
+                $tb = strtotime((string) $b['issued_at']);
+                if ($ta !== $tb) {
+                    return ($ta > $tb) ? -1 : 1;
+                }
+                return ((int) $a['id'] > (int) $b['id']) ? -1 : 1;
+            });
+            return $out;
+        }
+
+        return array();
+    }
+
+    public function get_var($sql = null) {
+        $sql = trim((string) $sql);
+
+        if (preg_match('/^SELECT id FROM (\S+) WHERE user_id = (\d+) AND token_hash = \'([^\']*)\' LIMIT 1$/', $sql, $m)) {
+            foreach ($this->rows[$m[1]] as $row) {
+                if ((int) $row['user_id'] === (int) $m[2] && (string) $row['token_hash'] === $m[3]) {
+                    return $row['id'];
+                }
+            }
+            return null;
+        }
+
+        return null;
+    }
+
+    public function query($sql) {
+        $sql = trim((string) $sql);
+        $count = 0;
+
+        // revoke_all: ... AND revoked_at IS NULL [AND id <> N]
+        if (preg_match('/^UPDATE (\S+) SET revoked_at = \'([^\']*)\' WHERE user_id = (\d+) AND revoked_at IS NULL(?: AND id <> (\d+))?$/', $sql, $m)) {
+            $except = isset($m[4]) ? (int) $m[4] : null;
+            foreach ($this->rows[$m[1]] as $i => $row) {
+                if ((int) $row['user_id'] !== (int) $m[3] || null !== $row['revoked_at']) {
+                    continue;
+                }
+                if (null !== $except && (int) $row['id'] === $except) {
+                    continue;
+                }
+                $this->rows[$m[1]][$i]['revoked_at'] = $m[2];
+                $count++;
+            }
+            return $count;
+        }
+
+        // revoke_by_device
+        if (preg_match('/^UPDATE (\S+) SET revoked_at = \'([^\']*)\' WHERE user_id = (\d+) AND device_id = \'([^\']*)\' AND revoked_at IS NULL$/', $sql, $m)) {
+            foreach ($this->rows[$m[1]] as $i => $row) {
+                if ((int) $row['user_id'] !== (int) $m[3] || null !== $row['revoked_at']) {
+                    continue;
+                }
+                if ((string) $row['device_id'] !== $m[4]) {
+                    continue;
+                }
+                $this->rows[$m[1]][$i]['revoked_at'] = $m[2];
+                $count++;
+            }
+            return $count;
+        }
+
+        // prune_old_rows
+        if (preg_match('/^DELETE FROM (\S+) WHERE expires_at < \'([^\']*)\' AND \(revoked_at IS NOT NULL OR expires_at < \'([^\']*)\'\)$/', $sql, $m)) {
+            $kept = array();
+            foreach ($this->rows[$m[1]] as $row) {
+                $stale = ((string) $row['expires_at'] < $m[2])
+                    && (null !== $row['revoked_at'] || (string) $row['expires_at'] < $m[3]);
+                if ($stale) {
+                    $count++;
+                } else {
+                    $kept[] = $row;
+                }
+            }
+            $this->rows[$m[1]] = $kept;
+            return $count;
+        }
+
+        return 0;
+    }
+
+    // ── کمک‌کننده‌های تست ──
+
+    public function all($table) {
+        return isset($this->rows[$table]) ? $this->rows[$table] : array();
+    }
+
+    public function active_for($table, $user_id) {
+        $out = array();
+        foreach ($this->all($table) as $row) {
+            if ((int) $row['user_id'] === (int) $user_id && null === $row['revoked_at']) {
+                $out[] = $row;
+            }
+        }
+        return $out;
+    }
+
+    private function matches($row, $where) {
+        foreach ((array) $where as $k => $v) {
+            if (null === $v) {
+                if (null !== $row[$k]) {
+                    return false;
+                }
+            } elseif ((string) $row[$k] !== (string) $v) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
+
+// ─── ۱۰) ورود وب نباید توکن اپ را باطل کند ─────────────────────────────────
+//
+// این همان بلاکر انتشار است. پیش از v1.8.0 هر کاربر یک اسلات توکن داشت، پس
+// ورود در وب‌اپ توکن اپ اندروید را بازنویسی می‌کرد. چون اشتراک در وب خریداری
+// می‌شود، کاربر ناچار بود هر دو جا وارد بماند — و نمی‌توانست.
+
+$GLOBALS['wpdb'] = new Mrd_Fake_Wpdb();
+$table = MrDastbaaf_Token_Store::table();
+
+$app_row = MrDastbaaf_Token_Store::issue(1, 'app-secret-1', array(
+    'device_id' => 'phone-a',
+    'device_name' => 'گوشی',
+    'platform' => 'android',
+    'app_version' => '1.0.0',
+));
+$web_row = MrDastbaaf_Token_Store::issue(1, 'web-secret-1', array(
+    'device_id' => 'browser-a',
+    'device_name' => 'مرورگر',
+    'platform' => 'web',
+));
+
+mrd_assert('issue returns the new row id', (is_int($app_row) && $app_row > 0), true);
+mrd_assert('a web login creates a second row rather than overwriting', count($GLOBALS['wpdb']->all($table)), 2);
+
+mrd_assert(
+    'THE RELEASE BLOCKER: the app token still resolves after a web login',
+    (bool) MrDastbaaf_Token_Store::find_by_token('1.app-secret-1'),
+    true
+);
+mrd_assert(
+    'the web token resolves as well',
+    (bool) MrDastbaaf_Token_Store::find_by_token('1.web-secret-1'),
+    true
+);
+
+// هر دو نشست فعال‌اند و هیچ‌کدام باطل نشده.
+$active = MrDastbaaf_Token_Store::list_for_user(1);
+mrd_assert('both sessions are active', count($active), 2);
+mrd_assert(
+    'neither session was revoked',
+    (null === $active[0]['revoked_at'] && null === $active[1]['revoked_at']),
+    true
+);
+
+// ورود سوم (مثلاً اپ روی تبلت) هم کسی را بیرون نمی‌اندازد.
+MrDastbaaf_Token_Store::issue(1, 'tablet-secret-1', array('device_id' => 'tablet-a', 'platform' => 'android'));
+mrd_assert('a third device still does not evict anyone', count(MrDastbaaf_Token_Store::list_for_user(1)), 3);
+mrd_assert(
+    'the app token survives a third login too',
+    (bool) MrDastbaaf_Token_Store::find_by_token('1.app-secret-1'),
+    true
+);
+
+// نشست‌های کاربران دیگر دست‌نخورده می‌مانند.
+MrDastbaaf_Token_Store::issue(2, 'other-user-secret', array('device_id' => 'phone-b', 'platform' => 'android'));
+mrd_assert('another user gets their own session', count(MrDastbaaf_Token_Store::list_for_user(2)), 1);
+mrd_assert(
+    'another user cannot resolve the first user token',
+    MrDastbaaf_Token_Store::find_by_token('1.app-secret-1')['user_id'],
+    1
+);
+
+// ─── ۱۱) سقف دستگاه: دستگاه اضافی، قدیمی‌ترین را بیرون می‌اندازد ───────────
+//
+// با MAX_DEVICES = 3، سه نشست اول همه زنده می‌مانند و **چهارمین** ورود
