+    }
+
+    /**
+     * آیا ردیف منقضی/باطل شده است؟ (مرجع زمانی: time() واقعی UTC — ستون‌ها GMT)
+     */
+    public static function is_usable($row, $now = null) {
+        if (!is_array($row)) {
+            return false;
+        }
+        if (!empty($row['revoked_at'])) {
+            return false;
+        }
+        $expires_at = isset($row['expires_at']) ? strtotime((string) $row['expires_at']) : false;
+        if (false === $expires_at) {
+            return false;
+        }
+        $now = (null === $now) ? time() : (int) $now;
+        return $expires_at > $now;
+    }
+
+    /**
+     * انتخاب قدیمی‌ترین نشست از فهرست ردیف‌های فعال.
+     *
+     * مبنای سیاست سقف دستگاه‌ها. tie-break با id تا نتیجه قطعی باشد و دو ردیف
+     * با issued_at یکسان باعث رفتار غیرقطعی نشوند.
+     *
+     * @param array $rows ردیف‌های فعال
+     * @return int|null شناسهٔ ردیف قدیمی‌تر، یا null اگر فهرست خالی باشد
+     */
+    public static function oldest_row_id($rows) {
+        $valid = array();
+        foreach ((array) $rows as $row) {
+            if (is_array($row) && isset($row['id'])) {
+                $valid[] = $row;
+            }
+        }
+
+        if (empty($valid)) {
+            return null;
+        }
+
+        usort($valid, array('MrDastbaaf_Token_Store', 'compare_oldest_first'));
+
+        return (int) $valid[0]['id'];
+    }
+
+    /**
+     * مقایسه‌گر: قدیمی‌ترین اول.
+     *
+     * ترتیب قطعی بر اساس (issued_at, id). ردیفی که issued_at نامعتبر دارد
+     * «قدیمی‌ترین» در نظر گرفته می‌شود (fail-closed: مشکوک‌ترین اول بیرون).
+     */
+    public static function compare_oldest_first($a, $b) {
+        $ta = isset($a['issued_at']) ? strtotime((string) $a['issued_at']) : false;
+        $tb = isset($b['issued_at']) ? strtotime((string) $b['issued_at']) : false;
+
+        if (false === $ta) {
+            $ta = 0;
+        }
+        if (false === $tb) {
+            $tb = 0;
+        }
+
+        if ($ta !== $tb) {
+            return ($ta < $tb) ? -1 : 1;
+        }
+
+        $ia = (int) $a['id'];
+        $ib = (int) $b['id'];
+
+        if ($ia === $ib) {
+            return 0;
+        }
+
+        return ($ia < $ib) ? -1 : 1;
+    }
+
+    /**
+     * کدام نشست‌ها باید باطل شوند تا تعداد از سقف رد نشود؟
+     *
+     * این «سیاست» است، جدا از دیتابیس — تا بتوان بدون MySQL آزمونش کرد.
+     * قاعده: فقط **قدیمی‌ترین‌ها**، و فقط به‌اندازهٔ مازاد. نشست تازه‌وارد هرگز
+     * قربانی نمی‌شود.
+     *
+     * ورودی عمداً به ترتیب خاصی تکیه نمی‌کند: خودمان مرتب می‌کنیم، چون
+     * list_for_user امروز جدیدترین‌اول برمی‌گرداند ولی این قرارداد شکننده است.
+     *
+     * @param array    $active_rows ردیف‌های فعال
+     * @param int|null $limit       سقف؛ پیش‌فرض MAX_DEVICES
+     * @return int[] شناسهٔ ردیف‌هایی که باید باطل شوند (قدیمی‌ترین اول)
+     */
+    public static function rows_to_evict($active_rows, $limit = null) {
+        $limit = (null === $limit) ? self::MAX_DEVICES : (int) $limit;
+
+        $valid = array();
+        foreach ((array) $active_rows as $row) {
+            if (is_array($row) && isset($row['id'])) {
+                $valid[] = $row;
+            }
+        }
+
+        $excess = count($valid) - $limit;
+        if ($excess <= 0) {
+            return array();
+        }
+
+        usort($valid, array('MrDastbaaf_Token_Store', 'compare_oldest_first'));
+
+        $evict = array();
+        for ($i = 0; $i < $excess; $i++) {
+            $evict[] = (int) $valid[$i]['id'];
+        }
+
+        return $evict;
+    }
+
+    /**
+     * محاسبهٔ زمان انقضای توکن از لحظهٔ صدور (فرمت MySQL، مرجع UTC).
+     */
+    public static function expiry_from($issued_timestamp) {
+        return gmdate('Y-m-d H:i:s', (int) $issued_timestamp + self::TOKEN_LIFETIME_SECONDS);
+    }
+
+    /**
+     * آیا باید last_used_at را به‌روز کرد؟
+     */
+    public static function should_touch($last_used_at, $now = null) {
+        $now = (null === $now) ? time() : (int) $now;
+        if (empty($last_used_at)) {
+            return true;
+        }
+        $last = strtotime((string) $last_used_at);
+        if (false === $last) {
+            return true;
+        }
+        return ($now - $last) >= self::TOUCH_INTERVAL_SECONDS;
+    }
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // بخش DB-محور
+    // ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * نام کامل جدول.
+     */
+    public static function table() {
+        global $wpdb;
+        return $wpdb->prefix . 'mrdastbaaf_api_tokens';
+    }
+
+    /**
+     * صدور توکن برای یک دستگاه.
+     *
+     * پس از درج، سقف دستگاه‌ها اعمال می‌شود: قدیمی‌ترین نشستِ فعال باطل
+     * می‌شود تا تعداد نشست‌های فعال حداکثر MAX_DEVICES بماند.
+     *
+     * @param int    $user_id شناسهٔ کاربر
+     * @param string $secret  secret خام (فقط هش آن ذخیره می‌شود)
+     * @param array  $meta    device_id / device_name / platform / app_version
+     * @return int|false شناسهٔ ردیف یا false در شکست
+     */
+    public static function issue($user_id, $secret, $meta = array()) {
+        global $wpdb;
+
+        $user_id = (int) $user_id;
+        if ($user_id <= 0 || '' === (string) $secret) {
+            return false;
+        }
+
+        $now = time();
+        $inserted = $wpdb->insert(
+            self::table(),
+            array(
+                'user_id'     => $user_id,
+                'token_hash'  => self::hash_secret($secret),
+                'device_id'   => self::sanitize_label(isset($meta['device_id']) ? $meta['device_id'] : '', 64),
+                'device_name' => self::sanitize_label(isset($meta['device_name']) ? $meta['device_name'] : '', 100),
+                'platform'    => self::sanitize_label(isset($meta['platform']) ? $meta['platform'] : '', 20),
+                'app_version' => self::sanitize_label(isset($meta['app_version']) ? $meta['app_version'] : '', 20),
+                'issued_at'   => gmdate('Y-m-d H:i:s', $now),
+                'expires_at'  => self::expiry_from($now),
+                'revoked_at'  => null,
+            ),
+            array('%d', '%s', '%s', '%s', '%s', '%s', '%s', '%s', '%s')
+        );
+
+        if (false === $inserted) {
+            return false;
+        }
+
+        $row_id = (int) $wpdb->insert_id;
+        self::enforce_device_limit($user_id);
+
+        return $row_id;
+    }
+
+    /**
+     * یافتن نشست متناظر با یک توکن.
+     *
+     * مسیر سریع: شناسهٔ کاربر از خود توکن پارس می‌شود (بدون جست‌وجوی متا) و
+     * سپس فقط ردیف‌های همان کاربر بررسی می‌شوند — با سقف ۳ دستگاه، حداکثر سه
+     * مقایسهٔ زمان-ثابت.
+     *
+     * @param string $token توکن خام
+     * @return array|null ردیف + کلید user_id، یا null
+     */
+    public static function find_by_token($token) {
+        global $wpdb;
+
+        $parsed = self::parse_token($token);
+        if (null === $parsed) {
+            return null;
+        }
+
+        $rows = $wpdb->get_results(
+            $wpdb->prepare(
+                'SELECT * FROM ' . self::table() . ' WHERE user_id = %d AND revoked_at IS NULL ORDER BY issued_at DESC, id DESC',
+                $parsed['user_id']
+            ),
+            ARRAY_A
+        );
+
+        foreach ((array) $rows as $row) {
+            if (!self::is_usable($row)) {
+                continue;
+            }
+            if (self::secret_matches($parsed['secret'], $row['token_hash'])) {
+                self::touch($row);
+                return $row;
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * به‌روزرسانی «آخرین فعالیت» — حداکثر هر TOUCH_INTERVAL_SECONDS برای هر نشست.
+     *
+     * @param array $row ردیف نشست
+     */
+    public static function touch($row) {
+        if (!is_array($row) || empty($row['id'])) {
+            return;
+        }
+        if (!self::should_touch(isset($row['last_used_at']) ? $row['last_used_at'] : null)) {
+            return;
+        }
+
+        global $wpdb;
+        $wpdb->update(
+            self::table(),
+            array('last_used_at' => gmdate('Y-m-d H:i:s')),
+            array('id' => (int) $row['id']),
+            array('%s'),
+            array('%d')
+        );
+    }
+
+    /**
+     * فهرست نشست‌های فعال یک کاربر (جدیدترین اول).
+     *
+     * @param int $user_id
+     * @return array
+     */
+    public static function list_for_user($user_id) {
+        global $wpdb;
+
+        $rows = $wpdb->get_results(
+            $wpdb->prepare(
+                'SELECT * FROM ' . self::table() . ' WHERE user_id = %d AND revoked_at IS NULL ORDER BY issued_at DESC, id DESC',
+                (int) $user_id
+            ),
+            ARRAY_A
+        );
+
+        $active = array();
+        foreach ((array) $rows as $row) {
+            if (self::is_usable($row)) {
+                $active[] = $row;
+            }
+        }
+
+        return $active;
+    }
+
+    /**
+     * باطل‌کردن یک نشست مشخص — فقط اگر متعلق به همین کاربر باشد.
+     *
+     * گارد مالکیت عمدی است: بدون آن، یک شناسهٔ حدسی می‌توانست نشست کاربر دیگر
+     * را باطل کند (IDOR).
+     *
+     * @param int $row_id
+     * @param int $user_id
+     * @return bool
+     */
+    public static function revoke($row_id, $user_id) {
+        global $wpdb;
+
+        $row_id = (int) $row_id;
+        $user_id = (int) $user_id;
+        if ($row_id <= 0 || $user_id <= 0) {
+            return false;
+        }
+
+        $updated = $wpdb->update(
+            self::table(),
+            array('revoked_at' => gmdate('Y-m-d H:i:s')),
+            array('id' => $row_id, 'user_id' => $user_id, 'revoked_at' => null),
+            array('%s'),
+            array('%d', '%d', '%s')
+        );
+
+        return (false !== $updated && $updated > 0);
+    }
+
+    /**
+     * باطل‌کردن همهٔ نشست‌های یک کاربر، با امکان استثنای نشست جاری.
+     *
+     * @param int      $user_id
+     * @param int|null $except_row_id نشستی که باید زنده بماند (معمولاً دستگاه جاری)
+     * @return int تعداد ردیف‌های باطل‌شده
+     */
+    public static function revoke_all($user_id, $except_row_id = null) {
+        global $wpdb;
+
+        $user_id = (int) $user_id;
+        if ($user_id <= 0) {
+            return 0;
+        }
+
+        $sql = 'UPDATE ' . self::table() . ' SET revoked_at = %s WHERE user_id = %d AND revoked_at IS NULL';
+        $params = array(gmdate('Y-m-d H:i:s'), $user_id);
+
+        if (null !== $except_row_id && (int) $except_row_id > 0) {
+            $sql .= ' AND id <> %d';
+            $params[] = (int) $except_row_id;
+        }
+
+        $updated = $wpdb->query($wpdb->prepare($sql, $params));
+
+        return (int) $updated;
+    }
+
+    /**
+     * باطل‌کردن نشست‌های یک دستگاه مشخص.
+     *
+     * برای خروج «از این دستگاه» وقتی کلاینت device_id پایدار دارد: اگر کاربر
+     * چند بار روی یک دستگاه وارد شده باشد، همهٔ نشست‌های همان دستگاه بسته
+     * می‌شوند.
+     *
+     * @param int    $user_id
+     * @param string $device_id
+     * @return int
+     */
+    public static function revoke_by_device($user_id, $device_id) {
+        global $wpdb;
+
+        $user_id = (int) $user_id;
+        $device_id = self::sanitize_label($device_id, 64);
+        if ($user_id <= 0 || '' === $device_id) {
+            return 0;
+        }
+
+        $updated = $wpdb->query(
+            $wpdb->prepare(
+                'UPDATE ' . self::table() . ' SET revoked_at = %s WHERE user_id = %d AND device_id = %s AND revoked_at IS NULL',
+                gmdate('Y-m-d H:i:s'),
+                $user_id,
+                $device_id
+            )
+        );
+
+        return (int) $updated;
+    }
+
+    /**
+     * اعمال سقف دستگاه‌ها: تا وقتی نشست فعال بیش از MAX_DEVICES است،
+     * قدیمی‌ترین‌ها باطل می‌شوند.
+     *
+     * سیاست در [rows_to_evict] است؛ اینجا فقط اجرا می‌شود.
+     *
+     * @param int $user_id
+     * @return int تعداد باطل‌شده
+     */
+    public static function enforce_device_limit($user_id) {
+        $user_id = (int) $user_id;
+        if ($user_id <= 0) {
+            return 0;
+        }
+
+        $evict = self::rows_to_evict(self::list_for_user($user_id));
+        $revoked = 0;
+
+        foreach ($evict as $row_id) {
+            if (self::revoke($row_id, $user_id)) {
+                $revoked++;
+            }
+        }
+
+        return $revoked;
+    }
+
+    /**
+     * مهاجرت تنبل توکن قدیمی (usermeta) به جدول.
+     *
+     * روی نصب‌های موجود، توکن فعال فقط به‌شکل hash در usermeta است. چون برای
+     * درج ردیف به secret خام نیازی نیست (همان hash کافی است)، مهاجرت بدون
+     * دخالت کاربر و بدون ابطال نشست او انجام می‌شود.
+     *
+     * پس از مهاجرت، متاهای قدیمی حذف می‌شوند تا مسیر fallback دیگر اجرا نشود.
+     *
+     * @param int $user_id
+     * @return bool آیا مهاجرتی انجام شد؟
+     */
+    public static function migrate_legacy_token($user_id) {
+        global $wpdb;
+
+        $user_id = (int) $user_id;
+        if ($user_id <= 0) {
+            return false;
+        }
+
+        $legacy_hash = (string) get_user_meta($user_id, 'mrdastbaaf_api_token', true);
+        if ('' === $legacy_hash) {
+            return false;
+        }
+
+        $issued = (int) get_user_meta($user_id, 'mrdastbaaf_api_token_issued', true);
+        if ($issued <= 0) {
+            // مهر زمانی نامعتبر ⇒ توکن قدیمی غیرقابل اعتبار است (همان رفتار
+            // fail-closed نسخه‌های قبل).
+            delete_user_meta($user_id, 'mrdastbaaf_api_token');
+            delete_user_meta($user_id, 'mrdastbaaf_api_token_issued');
+            return false;
+        }
+
+        // اگر همین هش از قبل در جدول هست (مهاجرت تکراری)، دوباره درج نکن.
+        $existing = $wpdb->get_var(
+            $wpdb->prepare(
+                'SELECT id FROM ' . self::table() . ' WHERE user_id = %d AND token_hash = %s LIMIT 1',
+                $user_id,
+                $legacy_hash
+            )
+        );
+
+        if (null === $existing) {
+            $wpdb->insert(
+                self::table(),
+                array(
+                    'user_id'     => $user_id,
+                    'token_hash'  => $legacy_hash,
+                    'device_id'   => 'legacy',
+                    'device_name' => 'دستگاه پیشین',
+                    'platform'    => 'web',
+                    'app_version' => '',
+                    'issued_at'   => gmdate('Y-m-d H:i:s', $issued),
+                    'expires_at'  => self::expiry_from($issued),
+                    'revoked_at'  => null,
+                ),
+                array('%d', '%s', '%s', '%s', '%s', '%s', '%s', '%s', '%s')
+            );
+        }
+
+        delete_user_meta($user_id, 'mrdastbaaf_api_token');
+        delete_user_meta($user_id, 'mrdastbaaf_api_token_issued');
+
+        return true;
+    }
+
+    /**
+     * حذف ردیف‌های باطل/منقضی قدیمی — جلوگیری از رشد بی‌پایان جدول.
+     *
+     * ردیف‌های باطل‌شده تا ۹۰ روز نگه داشته می‌شوند (ردپای ممیزی «این دستگاه
+     * چه زمانی قطع شد») و سپس حذف می‌شوند. از کرون ۱۰دقیقه‌ای صدا زده می‌شود.
+     *
+     * @return int تعداد حذف‌شده
+     */
+    public static function prune_old_rows() {
+        global $wpdb;
+
+        $cutoff = gmdate('Y-m-d H:i:s', time() - 90 * DAY_IN_SECONDS);
+
+        $deleted = $wpdb->query(
+            $wpdb->prepare(
+                'DELETE FROM ' . self::table() . ' WHERE expires_at < %s AND (revoked_at IS NOT NULL OR expires_at < %s)',
+                $cutoff,
+                $cutoff
+            )
+        );
+
+        return (int) $deleted;
+    }
+
+    /**
+     * پاک‌سازی برچسب دستگاه — بدون تگ، بدون کنترل‌کاراکتر، سقف طول.
+     *
+     * device_name از سمت کلاینت می‌آید و در پاسخ REST نمایش داده می‌شود؛ پس
+     * باید در «نقطهٔ ورود» پاک شود، نه در لحظهٔ نمایش.
+     */
+    private static function sanitize_label($value, $max_length) {
+        $value = wp_strip_all_tags((string) $value);
+        $value = preg_replace('/[\x00-\x1F\x7F]/u', '', $value);
+        $value = trim((string) $value);
+        return mb_substr($value, 0, (int) $max_length);
+    }
+}
