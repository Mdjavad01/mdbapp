+     *
+     * فیلتر `mrdastbaaf_stream_video_type` برای وقتی است که لایهٔ HLS واقعی
+     * اضافه شود (یا DASH) — بدون تغییر این تابع.
+     *
+     * @param string   $url    آدرس ویدیو
+     * @param int|null $lesson_id برای فیلتر
+     * @return string 'mp4' | 'hls'
+     */
+    public static function detect_video_type($url, $lesson_id = null) {
+        $type = 'mp4';
+
+        $path = (string) wp_parse_url((string) $url, PHP_URL_PATH);
+        if ('' !== $path && preg_match('/\.m3u8$/i', $path)) {
+            $type = 'hls';
+        }
+
+        /**
+         * فیلتر نوع استریم — نقطهٔ اتصال لایهٔ HLS آینده.
+         *
+         * @param string   $type      'mp4' | 'hls'
+         * @param string   $url       آدرس ویدیو
+         * @param int|null $lesson_id شناسهٔ درس
+         */
+        $type = apply_filters('mrdastbaaf_stream_video_type', $type, $url, $lesson_id);
+
+        return in_array($type, array('mp4', 'hls'), true) ? $type : 'mp4';
+    }
