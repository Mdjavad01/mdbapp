+<?php
+/**
+ * تست مستقل تشخیص نوع استریم (test-video-type) — بدون وردپرس
+ *
+ * اجرای روی سرور: php tests/php/test-video-type.php
+ *
+ * فقط متد استاتیک و خالص MrDastbaaf_Courses_Controller::detect_video_type()
+ * آزموده می‌شود. دو تابع وردپرس که این متد لازم دارد (wp_parse_url و
+ * apply_filters) در همین فایل با پیاده‌سازی حداقلی جایگزین می‌شوند — همان
+ * الگویی که تست‌های دیگر برای ABSPATH به‌کار می‌برند.
+ *
+ * چرا این تست مهم است: پیش از v1.8.0، فیلد streamType در پاسخ بلیط **هاردکد
+ * 'hls'** بود در حالی که سرور MP4 سرو می‌کرد. کلاینتی که به آن اعتماد می‌کرد،
+ * پلیر HLS را روی یک فایل MP4 راه می‌انداخت. این تست تضمین می‌کند مقدار
+ * خروجی از خود آدرس مشتق شود و پیش‌فرض هم محافظه‌کارانه بماند.
+ */
+
+define('ABSPATH', '/tmp/');
+
+if (!defined('MINUTE_IN_SECONDS')) {
+    define('MINUTE_IN_SECONDS', 60);
+}
+if (!defined('HOUR_IN_SECONDS')) {
+    define('HOUR_IN_SECONDS', 3600);
+}
+if (!defined('DAY_IN_SECONDS')) {
+    define('DAY_IN_SECONDS', 86400);
+}
+
+/**
+ * جایگزین wp_parse_url — همان رفتار هستهٔ وردپرس روی parse_url.
+ */
+if (!function_exists('wp_parse_url')) {
+    function wp_parse_url($url, $component = -1) {
+        return parse_url($url, $component);
+    }
+}
+
+/**
+ * جایگزین apply_filters — با یک رجیستری حداقلی تا مسیر فیلتر هم آزمون‌پذیر باشد.
+ */
+$GLOBALS['mrd_test_filters'] = array();
+if (!function_exists('apply_filters')) {
+    function apply_filters($tag, $value) {
+        if (isset($GLOBALS['mrd_test_filters'][$tag])) {
+            return $GLOBALS['mrd_test_filters'][$tag];
+        }
+        return $value;
+    }
+}
+
+require_once __DIR__ . '/../../includes/class-courses-controller.php';
+
+$pass = 0;
+$fail = 0;
+
+/**
+ * اجرای یک assertion و ثبت نتیجه
+ */
+function mrd_assert($label, $actual, $expected) {
+    global $pass, $fail;
+    if ($actual === $expected) {
+        $pass++;
+        echo "PASS: {$label}\n";
+    } else {
+        $fail++;
+        echo "FAIL: {$label} — expected: " . var_export($expected, true) . " | got: " . var_export($actual, true) . "\n";
+    }
+}
+
+// ─── ۱) پیش‌فرض محافظه‌کارانه: هر چیزی جز .m3u8 یعنی MP4 ────────────────────
+
+mrd_assert(
+    'plain mp4',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/lesson-01.mp4'),
+    'mp4'
+);
+
+mrd_assert(
+    'mp4 with a dot in the filename',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/lesson.01.mp4'),
+    'mp4'
+);
+
+// سایر فرمت‌های ویدیویی عمداً MP4 گزارش می‌شوند: پلیر Media3 همان داده‌سورس را
+// می‌گیرد و تفاوت رفتاری ندارد، در حالی که افزودن نوع سوم، سطح قرارداد را
+// بی‌دلیل بزرگ می‌کند.
+mrd_assert(
+    'webm falls back to mp4 by contract',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/lesson-01.webm'),
+    'mp4'
+);
+
+mrd_assert(
+    'extension-less url (proxy shape) is mp4',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://mrdastbaaf.com/wp-json/mrdastbaaf/v1/lessons/12/stream?token=XyZ123'),
+    'mp4'
+);
+
+mrd_assert(
+    'empty url is mp4',
+    MrDastbaaf_Courses_Controller::detect_video_type(''),
+    'mp4'
+);
+
+mrd_assert(
+    'malformed url is mp4',
+    MrDastbaaf_Courses_Controller::detect_video_type('not a url at all'),
+    'mp4'
+);
+
+mrd_assert(
+    'a path segment named m3u8 without the extension is mp4',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/m3u8/segment.mp4'),
+    'mp4'
+);
+
+mrd_assert(
+    'the literal filename m3u8 without a dot is mp4',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/m3u8'),
+    'mp4'
+);
+
+// ─── ۲) HLS فقط با پسوند .m3u8 ─────────────────────────────────────────────
+
+mrd_assert(
+    'hls master playlist',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/master.m3u8'),
+    'hls'
+);
+
+mrd_assert(
+    'hls is case insensitive',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/master.M3U8'),
+    'hls'
+);
+
+mrd_assert(
+    'hls with signed query params',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/master.m3u8?token=abc&exp=1800000000'),
+    'hls'
+);
+
+mrd_assert(
+    'hls variant playlist in a subdirectory',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/1080p/index.m3u8'),
+    'hls'
+);
+
+mrd_assert(
+    'a .mp4 segment is still mp4 even under an hls folder',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/hls/segment-001.mp4'),
+    'mp4'
+);
+
+// ─── ۳) فیلتر توسعه ────────────────────────────────────────────────────────
+
+$GLOBALS['mrd_test_filters']['mrdastbaaf_stream_video_type'] = 'hls';
+mrd_assert(
+    'filter can promote a url to hls (future signed-HLS provider)',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/lesson.mp4'),
+    'hls'
+);
+
+$GLOBALS['mrd_test_filters']['mrdastbaaf_stream_video_type'] = 'dash';
+mrd_assert(
+    'an unsupported type from the filter is rejected back to mp4',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/lesson.mp4'),
+    'mp4'
+);
+
+$GLOBALS['mrd_test_filters']['mrdastbaaf_stream_video_type'] = null;
+mrd_assert(
+    'a null filter result falls back to mp4 rather than leaking null',
+    MrDastbaaf_Courses_Controller::detect_video_type('https://dll.mrdastbaaf.com/FA/lesson.mp4'),
+    'mp4'
+);
+
+// پاک‌سازی رجیستری فیلتر تا آزمون‌های بعدی تحت تأثیر نباشند
+$GLOBALS['mrd_test_filters'] = array();
+
+echo "\n---- result ----\n";
+echo "PASS: {$pass}\n";
+echo "FAIL: {$fail}\n";
+
+exit($fail > 0 ? 1 : 0);
