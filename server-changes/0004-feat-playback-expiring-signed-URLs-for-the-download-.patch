diff --git a/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-signed-urls.php b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-signed-urls.php
new file mode 100644
index 0000000..fe8535b
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-signed-urls.php
@@ -0,0 +1,423 @@
+<?php
+/**
+ * تست مستقل امضای آدرس (test-signed-urls) — بدون وردپرس
+ *
+ * اجرای روی سرور: php tests/php/test-signed-urls.php
+ *
+ * ─── چرا این تست حیاتی است ───
+ * الگوریتم امضا باید **مو‌به‌مو** با ماژول secure_link خود nginx یکی باشد.
+ * اگر یک کاراکتر اختلاف باشد (مثلاً padding در base64 یا «+» تبدیل‌نشده)،
+ * nginx **همهٔ** درخواست‌ها را 403 می‌کند و کل ویدیوی پلتفرم از کار می‌افتد.
+ * این تست آن قرارداد را با یک بردار ثابت قفل می‌کند.
+ *
+ * بردار ثابت:
+ *   resource = /FA/lesson-01.mp4
+ *   expires  = 1800000000
+ *   secret   = test-secret
+ *   ⇒ uydm921XT5rHRgrrCIVrgA
+ *
+ * این مقدار مستقل هم با پایتون بازمحاسبه و تأیید شده است:
+ *   base64(md5("1800000000/FA/lesson-01.mp4test-secret", raw))
+ *   با «-_» به‌جای «+/» و بدون padding
+ *
+ * توابع وردپرس موردنیاز با پیاده‌سازی حداقلی جایگزین می‌شوند — همان الگویی که
+ * تست‌های دیگر برای ABSPATH به‌کار می‌برند.
+ */
+
+define('ABSPATH', '/tmp/');
+
+if (!defined('MINUTE_IN_SECONDS')) {
+    define('MINUTE_IN_SECONDS', 60);
+}
+if (!defined('HOUR_IN_SECONDS')) {
+    define('HOUR_IN_SECONDS', 3600);
+}
+if (!defined('DAY_IN_SECONDS')) {
+    define('DAY_IN_SECONDS', 86400);
+}
+
+if (!function_exists('wp_parse_url')) {
+    function wp_parse_url($url, $component = -1) {
+        return parse_url($url, $component);
+    }
+}
+
+if (!function_exists('add_query_arg')) {
+    function add_query_arg($args, $url) {
+        $separator = (strpos($url, '?') === false) ? '?' : '&';
+        return $url . $separator . http_build_query($args);
+    }
+}
+
+$GLOBALS['mrd_test_options'] = array();
+$GLOBALS['mrd_test_filters'] = array();
+
+if (!function_exists('get_option')) {
+    function get_option($name, $default = false) {
+        return isset($GLOBALS['mrd_test_options'][$name]) ? $GLOBALS['mrd_test_options'][$name] : $default;
+    }
+}
+if (!function_exists('update_option')) {
+    function update_option($name, $value, $autoload = null) {
+        $GLOBALS['mrd_test_options'][$name] = $value;
+        return true;
+    }
+}
+if (!function_exists('apply_filters')) {
+    function apply_filters($tag, $value) {
+        return isset($GLOBALS['mrd_test_filters'][$tag]) ? $GLOBALS['mrd_test_filters'][$tag] : $value;
+    }
+}
+if (!function_exists('wp_generate_password')) {
+    function wp_generate_password($length = 12, $special = true, $extra = true) {
+        return substr(str_repeat('abcdef0123456789', 8), 0, $length);
+    }
+}
+
+require_once __DIR__ . '/../../includes/class-signed-url-service.php';
+
+$pass = 0;
+$fail = 0;
+
+/**
+ * اجرای یک assertion و ثبت نتیجه
+ */
+function mrd_assert($label, $actual, $expected) {
+    global $pass, $fail;
+    if ($actual === $expected) {
+        $pass++;
+        echo "PASS: {$label}\n";
+    } else {
+        $fail++;
+        echo "FAIL: {$label} — expected: " . var_export($expected, true) . " | got: " . var_export($actual, true) . "\n";
+    }
+}
+
+const MRD_TEST_SECRET = 'test-secret';
+const MRD_TEST_EXPIRES = 1800000000;
+const MRD_TEST_RESOURCE = '/FA/lesson-01.mp4';
+const MRD_TEST_SIGNATURE = 'uydm921XT5rHRgrrCIVrgA';
+
+// ─── ۱) base64 سازگار با URL ───────────────────────────────────────────────
+
+mrd_assert(
+    'base64_url_encode strips padding',
+    MrDastbaaf_Signed_Url_Service::base64_url_encode('a'),
+    'YQ'
+);
+
+// base64("\xfb\xff\xfe") == "+//+" — یعنی هم «+» و هم «/» در خروجی حاضرند و
+// تبدیل به «-» و «_» واقعاً آزموده می‌شود (با ورودی‌ای که فقط یکی را تولید
+// کند، نیمی از تبدیل تست نمی‌شد).
+mrd_assert(
+    'base64_url_encode maps + and / to - and _',
+    MrDastbaaf_Signed_Url_Service::base64_url_encode("\xfb\xff\xfe"),
+    '-__-'
+);
+mrd_assert(
+    'base64_url_encode produces no +, / or = at all',
+    (bool) preg_match('#^[A-Za-z0-9_-]+$#', MrDastbaaf_Signed_Url_Service::base64_url_encode("\xfb\xff\xfe\xff\xfb")),
+    true
+);
+
+// ─── ۲) بردار ثابت سازگاری با nginx ────────────────────────────────────────
+
+mrd_assert(
+    'sign matches the fixed nginx-compatible vector',
+    MrDastbaaf_Signed_Url_Service::sign(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SECRET),
+    MRD_TEST_SIGNATURE
+);
+
+mrd_assert(
+    'sign is deterministic',
+    MrDastbaaf_Signed_Url_Service::sign(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SECRET),
+    MrDastbaaf_Signed_Url_Service::sign(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SECRET)
+);
+
+mrd_assert(
+    'sign produces a 22 character url-safe string for a 16 byte digest',
+    strlen(MRD_TEST_SIGNATURE),
+    22
+);
+
+mrd_assert(
+    'sign output contains no base64 padding or unsafe characters',
+    (bool) preg_match('/^[A-Za-z0-9_-]+$/', MrDastbaaf_Signed_Url_Service::sign(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SECRET)),
+    true
+);
+
+// هر جزء ورودی باید در امضا اثر داشته باشد — وگرنه امضا قابل جعل می‌شد
+mrd_assert(
+    'a different secret yields a different signature',
+    MrDastbaaf_Signed_Url_Service::sign(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, 'other-secret') === MRD_TEST_SIGNATURE,
+    false
+);
+mrd_assert(
+    'a different expiry yields a different signature',
+    MrDastbaaf_Signed_Url_Service::sign(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES + 1, MRD_TEST_SECRET) === MRD_TEST_SIGNATURE,
+    false
+);
+mrd_assert(
+    'a different resource yields a different signature',
+    MrDastbaaf_Signed_Url_Service::sign('/FA/lesson-02.mp4', MRD_TEST_EXPIRES, MRD_TEST_SECRET) === MRD_TEST_SIGNATURE,
+    false
+);
+
+// ─── ۳) استخراج مسیر ───────────────────────────────────────────────────────
+
+mrd_assert(
+    'path_for_signing strips the query string',
+    MrDastbaaf_Signed_Url_Service::path_for_signing('https://dll.mrdastbaaf.com/FA/lesson-01.mp4?foo=bar'),
+    '/FA/lesson-01.mp4'
+);
+
+mrd_assert(
+    'path_for_signing percent-decodes to match nginx $uri',
+    MrDastbaaf_Signed_Url_Service::path_for_signing('https://dll.mrdastbaaf.com/FA/%D8%AF%D8%B1%D8%B3-%DB%B1.mp4'),
+    '/FA/درس-۱.mp4'
+);
+
+// این تفاوت، دلیل وجود decode است: اگر روی مسیر encode‌شده امضا می‌شد، هیچ
+// امضایی در nginx معتبر نبود و همهٔ ویدیوها 403 می‌شدند.
+mrd_assert(
+    'an encoded and a decoded path produce different signatures',
+    MrDastbaaf_Signed_Url_Service::sign('/FA/%D8%AF%D8%B1%D8%B3.mp4', MRD_TEST_EXPIRES, MRD_TEST_SECRET)
+        === MrDastbaaf_Signed_Url_Service::sign('/FA/درس.mp4', MRD_TEST_EXPIRES, MRD_TEST_SECRET),
+    false
+);
+
+mrd_assert(
+    'path_for_signing on an empty string',
+    MrDastbaaf_Signed_Url_Service::path_for_signing(''),
+    ''
+);
+
+// PHP رشتهٔ بدون scheme را «مسیر نسبی» می‌بیند، نه ورودی خراب:
+// parse_url('not a url') === ['path' => 'not a url'].
+// پس برگرداندن همان رشته رفتار درست است، نه باگ. این را عمداً قفل می‌کنیم تا
+// کسی بعداً «سخت‌گیرانه‌ترش» نکند و مسیرهای نسبی مشروع را نشکند.
+mrd_assert(
+    'path_for_signing treats a scheme-less string as a relative path',
+    MrDastbaaf_Signed_Url_Service::path_for_signing('not a url'),
+    'not a url'
+);
+
+mrd_assert(
+    'path_for_signing accepts a bare relative path',
+    MrDastbaaf_Signed_Url_Service::path_for_signing('/FA/a.mp4'),
+    '/FA/a.mp4'
+);
+
+mrd_assert(
+    'path_for_signing on a host with no path',
+    MrDastbaaf_Signed_Url_Service::path_for_signing('https://dll.mrdastbaaf.com'),
+    ''
+);
+
+// ─── ۴) اعتبارسنجی ─────────────────────────────────────────────────────────
+
+// مرجع زمانی طوری انتخاب شده که now + ttl(900) دقیقاً برابر مهر زمانی بردار
+// ثابت شود، تا همان امضای تأییدشده در آزمون‌های sign_url هم قابل استفاده باشد.
+$now = MRD_TEST_EXPIRES - 900;
+
+mrd_assert(
+    'verify accepts a valid, unexpired signature',
+    MrDastbaaf_Signed_Url_Service::verify(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SIGNATURE, MRD_TEST_SECRET, $now),
+    true
+);
+
+mrd_assert(
+    'verify rejects a tampered signature',
+    MrDastbaaf_Signed_Url_Service::verify(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, 'AAAAAAAAAAAAAAAAAAAAAA', MRD_TEST_SECRET, $now),
+    false
+);
+
+mrd_assert(
+    'verify rejects a signature made with a different secret',
+    MrDastbaaf_Signed_Url_Service::verify(
+        MRD_TEST_RESOURCE,
+        MRD_TEST_EXPIRES,
+        MrDastbaaf_Signed_Url_Service::sign(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, 'attacker'),
+        MRD_TEST_SECRET,
+        $now
+    ),
+    false
+);
+
+mrd_assert(
+    'verify rejects an expired signature',
+    MrDastbaaf_Signed_Url_Service::verify(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SIGNATURE, MRD_TEST_SECRET, MRD_TEST_EXPIRES + 1),
+    false
+);
+
+mrd_assert(
+    'verify treats expiry exactly at now as expired (fail-closed)',
+    MrDastbaaf_Signed_Url_Service::verify(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SIGNATURE, MRD_TEST_SECRET, MRD_TEST_EXPIRES),
+    false
+);
+
+mrd_assert(
+    'verify rejects an extended expiry with the original signature',
+    // سناریوی حمله: مهاجم expires را جلو می‌برد ولی امضا را ندارد.
+    MrDastbaaf_Signed_Url_Service::verify(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES + 86400, MRD_TEST_SIGNATURE, MRD_TEST_SECRET, $now),
+    false
+);
+
+mrd_assert(
+    'verify rejects an empty signature',
+    MrDastbaaf_Signed_Url_Service::verify(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, '', MRD_TEST_SECRET, $now),
+    false
+);
+
+mrd_assert(
+    'verify rejects an empty secret',
+    MrDastbaaf_Signed_Url_Service::verify(MRD_TEST_RESOURCE, MRD_TEST_EXPIRES, MRD_TEST_SIGNATURE, '', $now),
+    false
+);
+
+// ─── ۵) ساخت آدرس امضاشده ─────────────────────────────────────────────────
+
+$signed = MrDastbaaf_Signed_Url_Service::sign_url(
+    'https://dll.mrdastbaaf.com/FA/lesson-01.mp4',
+    MRD_TEST_SECRET,
+    900,
+    $now
+);
+
+mrd_assert(
+    'sign_url appends md5 and expires',
+    $signed,
+    'https://dll.mrdastbaaf.com/FA/lesson-01.mp4?md5=' . MRD_TEST_SIGNATURE . '&expires=' . ($now + 900)
+);
+
+mrd_assert(
+    'sign_url keeps the original percent-encoded path in the url',
+    (strpos(
+        MrDastbaaf_Signed_Url_Service::sign_url('https://dll.mrdastbaaf.com/FA/%D8%AF%D8%B1%D8%B3.mp4', MRD_TEST_SECRET, 900, $now),
+        '/FA/%D8%AF%D8%B1%D8%B3.mp4?md5='
+    ) !== false),
+    true
+);
+
+mrd_assert(
+    'sign_url preserves an existing query string',
+    (strpos(
+        MrDastbaaf_Signed_Url_Service::sign_url('https://dll.mrdastbaaf.com/FA/a.mp4?v=2', MRD_TEST_SECRET, 900, $now),
+        '?v=2&md5='
+    ) !== false),
+    true
+);
+
+mrd_assert(
+    'sign_url clamps an absurd ttl to MAX_TTL_SECONDS',
+    (strpos(
+        MrDastbaaf_Signed_Url_Service::sign_url('https://dll.mrdastbaaf.com/FA/a.mp4', MRD_TEST_SECRET, 999999999, $now),
+        'expires=' . ($now + MrDastbaaf_Signed_Url_Service::MAX_TTL_SECONDS)
+    ) !== false),
+    true
+);
+
+mrd_assert(
+    'sign_url clamps a zero ttl to at least one second',
+    (strpos(
+        MrDastbaaf_Signed_Url_Service::sign_url('https://dll.mrdastbaaf.com/FA/a.mp4', MRD_TEST_SECRET, 0, $now),
+        'expires=' . ($now + 1)
+    ) !== false),
+    true
+);
+
+mrd_assert(
+    'sign_url returns the url unchanged when the secret is empty',
+    MrDastbaaf_Signed_Url_Service::sign_url('https://dll.mrdastbaaf.com/FA/a.mp4', '', 900, $now),
+    'https://dll.mrdastbaaf.com/FA/a.mp4'
+);
+
+mrd_assert(
+    'sign_url returns the url unchanged when there is no path',
+    MrDastbaaf_Signed_Url_Service::sign_url('https://dll.mrdastbaaf.com', MRD_TEST_SECRET, 900, $now),
+    'https://dll.mrdastbaaf.com'
+);
+
+// ─── ۶) پیکربندی ───────────────────────────────────────────────────────────
+
+$GLOBALS['mrd_test_options'] = array();
+
+mrd_assert(
+    'signed urls are OFF by default (safe rollout order)',
+    MrDastbaaf_Signed_Url_Service::is_enabled(),
+    false
+);
+
+mrd_assert(
+    'maybe_sign is a no-op while disabled',
+    MrDastbaaf_Signed_Url_Service::maybe_sign('https://dll.mrdastbaaf.com/FA/a.mp4'),
+    'https://dll.mrdastbaaf.com/FA/a.mp4'
+);
+
+$secret = MrDastbaaf_Signed_Url_Service::get_secret();
+mrd_assert('get_secret generates a secret on first use', strlen($secret) > 0, true);
+mrd_assert(
+    'get_secret is stable across calls',
+    MrDastbaaf_Signed_Url_Service::get_secret(),
+    $secret
+);
+
+$GLOBALS['mrd_test_options'][MrDastbaaf_Signed_Url_Service::ENABLED_OPTION] = true;
+mrd_assert('is_enabled reads the option', MrDastbaaf_Signed_Url_Service::is_enabled(), true);
+
+$signed_auto = MrDastbaaf_Signed_Url_Service::maybe_sign('https://dll.mrdastbaaf.com/FA/a.mp4');
+mrd_assert('maybe_sign signs once enabled', (strpos($signed_auto, 'md5=') !== false), true);
+
+// خودآزمایی رفت‌وبرگشت: آدرسی که خودمان می‌سازیم باید با همان پارامترها معتبر
+// شناخته شود. این دقیقاً همان کاری است که nginx با $arg_md5 و $arg_expires
+// انجام می‌دهد — پس اگر این تست بیفتد، پخش در پروداکشن 403 می‌شود.
+$manual = MrDastbaaf_Signed_Url_Service::sign_url(
+    'https://dll.mrdastbaaf.com/FA/a.mp4',
+    $secret,
+    900,
+    1800000000
+);
+$query = array();
+parse_str((string) parse_url($manual, PHP_URL_QUERY), $query);
+
+mrd_assert(
+    'a signed url self-verifies (php round trip, as nginx would)',
+    MrDastbaaf_Signed_Url_Service::verify(
+        '/FA/a.mp4',
+        (int) $query['expires'],
+        (string) $query['md5'],
+        $secret,
+        1800000000
+    ),
+    true
+);
+
+$GLOBALS['mrd_test_filters']['mrdastbaaf_signed_urls_enabled'] = false;
+mrd_assert('the filter can force signing off', MrDastbaaf_Signed_Url_Service::is_enabled(), false);
+$GLOBALS['mrd_test_filters'] = array();
+
+mrd_assert(
+    'ttl falls back to the default when unset',
+    MrDastbaaf_Signed_Url_Service::get_ttl(),
+    MrDastbaaf_Signed_Url_Service::DEFAULT_TTL_SECONDS
+);
+
+$GLOBALS['mrd_test_options'][MrDastbaaf_Signed_Url_Service::TTL_OPTION] = -5;
+mrd_assert(
+    'a nonsensical ttl falls back to the default',
+    MrDastbaaf_Signed_Url_Service::get_ttl(),
+    MrDastbaaf_Signed_Url_Service::DEFAULT_TTL_SECONDS
+);
+
+$GLOBALS['mrd_test_options'][MrDastbaaf_Signed_Url_Service::TTL_OPTION] = 999999999;
+mrd_assert(
+    'ttl is capped at MAX_TTL_SECONDS',
+    MrDastbaaf_Signed_Url_Service::get_ttl(),
+    MrDastbaaf_Signed_Url_Service::MAX_TTL_SECONDS
+);
+
+echo "\n---- result ----\n";
+echo "PASS: {$pass}\n";
