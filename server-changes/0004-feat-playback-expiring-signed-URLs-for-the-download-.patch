+++ b/wordpress-plugin/mrdastbaaf-bridge/includes/class-signed-url-service.php
@@ -0,0 +1,277 @@
+<?php
+/**
+ * آدرس‌های امضاشده با انقضا برای هاست دانلود (v1.8.0 — بدون تغییر اسکیما)
+ *
+ * ─── مسئله ───
+ * تا پیش از این، POST /lessons/{id}/playback یک آدرس **دائمی** برمی‌گرداند:
+ * https://dll.mrdastbaaf.com/FA/lesson-01.mp4
+ * هر کسی که این آدرس را می‌گرفت (از تب Network، از یک لاگ، از یک اسکرین‌شات)
+ * برای همیشه و بدون ورود می‌توانست ویدیو را دانلود کند. تنها محافظ،
+ * Hotlink Protection مبتنی بر Referer بود که با یک هدر جعلی دور زده می‌شود.
+ *
+ * ─── راه‌حل ───
+ * همان الگوی ماژول secure_link خود nginx: سرور یک امضای کوتاه‌عمر به آدرس
+ * می‌چسباند و nginx پیش از سرو فایل، اعتبار آن را بررسی می‌کند.
+ *
+ *   https://dll.mrdastbaaf.com/FA/lesson-01.mp4?md5=<sig>&expires=1800000000
+ *
+ * الگوریتم (باید **مو‌به‌مو** با nginx یکی باشد):
+ *   md5_raw  = md5( $expires . $uri . $secret , binary = true )
+ *   md5_url  = base64( md5_raw ) با «-_» به‌جای «+/» و بدون padding
+ *
+ * و در nginx:
+ *   secure_link            $arg_md5,$arg_expires;
+ *   secure_link_md5        "$secure_link_expires$uri<SECRET>";
+ *
+ * ─── نکتهٔ حیاتی: $uri در nginx «decode‌شده» است ───
+ * نام فایل‌های این پروژه فارسی‌اند و در URL به‌صورت percent-encoded می‌آیند
+ * (مثلاً /FA/درس-اول.mp4 → /FA/%D8%AF%D8%B1%D8%B3....mp4). nginx متغیر $uri را
+ * **پس از** percent-decode می‌بیند، در حالی که PHP مسیر خام را می‌خواند.
+ * اگر امضا روی مسیر encode‌شده محاسبه شود، هیچ امضایی در nginx معتبر نیست و
+ * **همهٔ ویدیوها 403 می‌شوند**. به همین دلیل [path_for_signing()] مسیر را
+ * decode می‌کند و [sign_url()] مسیر اصلی (encode‌شده) را در URL نهایی نگه
+ * می‌دارد: امضا روی شکل decode‌شده، آدرس روی شکل اصلی.
+ *
+ * ─── نکتهٔ دوم: $remote_addr عمداً در امضا نیست ───
+ * bind کردن امضا به IP کاربر، اشتراک‌گذاری را سخت‌تر می‌کند اما برای اپ موبایل
+ * شکستن پخش در لحظهٔ تغییر شبکه (۴G → وای‌فای) به‌دنبال دارد. پیکربندی
+ * جایگزین در سند nginx کامنت شده است.
+ *
+ * ─── ترتیب راه‌اندازی (مهم) ───
+ * اگر nginx امضا را اجباری کند ولی PHP آن را نچسباند، **تمام پخش‌ها 403
+ * می‌شوند**. ترتیب امن در docs/NGINX_SIGNED_URLS.md آمده است.
+ */
+
+if (!defined('ABSPATH')) {
+    exit;
+}
+
+class MrDastbaaf_Signed_Url_Service {
+
+    const SECRET_OPTION  = 'mrdastbaaf_signed_url_secret';
+    const ENABLED_OPTION = 'mrdastbaaf_signed_urls_enabled';
+    const TTL_OPTION     = 'mrdastbaaf_signed_url_ttl';
+
+    /**
+     * تعریف ثابت در wp-config.php بر پایگاه‌داده اولویت دارد.
+     *
+     * چرا: این کلید باید **هم** در PHP و **هم** در nginx یکی باشد. نگه‌داشتنش
+     * در wp-config یعنی یک منبع حقیقت، بدون رفت‌وبرگشت دیتابیس، و بدون اینکه
+     * مقدارش در پشتیبان‌گیری دیتابیس یا جدول options بیفتد.
+     */
+    const SECRET_CONSTANT = 'MRDASTBAAF_SIGNED_URL_SECRET';
+
+    /**
+     * عمر پیش‌فرض امضا — ۱۵ دقیقه، هم‌اندازهٔ عمر بلیط پخش.
+     *
+     * کوتاه‌تر از عمر ویدیو است و باید باشد: امضا فقط باید به‌اندازهٔ «شروع و
+     * ادامهٔ یک نشست پخش» زنده بماند. برای ویدیوی طولانی، پلیر در هر درخواست
+     * Range همان امضای اولیه را می‌فرستد؛ پس TTL باید از طول یک درس بیشتر
+     * باشد، نه از طول یک درخواست.
+     */
+    const DEFAULT_TTL_SECONDS = 900;
+
+    /**
+     * سقف TTL — ۲۴ ساعت. جلوگیری از پیکربندی اشتباهی که عملاً آدرس را دائمی
+     * می‌کند (و کل هدف این لایه را بی‌اثر می‌سازد).
+     */
+    const MAX_TTL_SECONDS = 86400;
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // بخش خالص (بدون وردپرس) — قابل آزمون در tests/php/test-signed-urls.php
+    // ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * base64 سازگار با URL: «+» → «-»، «/» → «_»، بدون padding.
+     *
+     * nginx همین تبدیل را انجام می‌دهد؛ اگر padding باقی بماند یا «+» تبدیل
+     * نشود، امضا در سمت nginx معتبر شناخته نمی‌شود.
+     */
+    public static function base64_url_encode($raw) {
+        return rtrim(strtr(base64_encode((string) $raw), '+/', '-_'), '=');
+    }
+
+    /**
+     * محاسبهٔ امضا برای یک منبع (مسیر decode‌شده) و یک مهر زمانی.
+     *
+     * @param string $resource مسیر منبع، **decode‌شده** (مثل nginx $uri)
+     * @param int    $expires  مهر زمانی انقضا (ثانیه، UTC)
+     * @param string $secret   کلید مشترک با nginx
+     * @return string امضای آماده برای پارامتر md5
+     */
+    public static function sign($resource, $expires, $secret) {
+        $raw = md5((int) $expires . (string) $resource . (string) $secret, true);
+        return self::base64_url_encode($raw);
+    }
+
+    /**
+     * اعتبارسنجی یک امضا — برای خودآزمایی و تست.
+     *
+     * در پروداکشن، اعتبارسنجی کار nginx است؛ این متد برای تست یکپارچگی
+     * «PHP ↔ nginx» و برای عیب‌یابی (مقایسهٔ امضای محاسبه‌شده با امضای ارسالی)
+     * به‌کار می‌رود.
+     *
+     * @param string   $resource  مسیر decode‌شده
+     * @param int      $expires   مهر زمانی اعلامی
+     * @param string   $signature امضای اعلامی
+     * @param string   $secret    کلید مشترک
+     * @param int|null $now       مرجع زمانی (پیش‌فرض: time())
+     * @return bool
+     */
+    public static function verify($resource, $expires, $signature, $secret, $now = null) {
+        if ('' === (string) $signature || '' === (string) $secret) {
+            return false;
+        }
+
+        $now = (null === $now) ? time() : (int) $now;
+        if ((int) $expires <= $now) {
+            return false; // منقضی
+        }
+
+        $expected = self::sign($resource, $expires, $secret);
+
+        // مقایسهٔ زمان-ثابت — جلوگیری از حملهٔ زمان‌سنجی روی امضا.
+        return hash_equals($expected, (string) $signature);
+    }
+
+    /**
+     * استخراج مسیرِ قابل‌امضا از یک آدرس کامل.
+     *
+     * **decode می‌شود** تا با متغیر $uri در nginx یکی باشد (توضیح کامل در
+     * ابتدای فایل). اگر مسیر خالی باشد، رشتهٔ خالی برمی‌گردد و فراخوان باید
+     * امضا نکند.
+     *
+     * @param string $url آدرس کامل یا مسیر
+     * @return string مسیر decode‌شده، یا '' اگر قابل استخراج نبود
+     */
+    public static function path_for_signing($url) {
+        $url = (string) $url;
+        if ('' === $url) {
+            return '';
+        }
+
+        $path = wp_parse_url($url, PHP_URL_PATH);
+        if (!is_string($path) || '' === $path) {
+            return '';
+        }
+
+        return rawurldecode($path);
+    }
+
+    /**
+     * افزودن امضا و انقضا به یک آدرس — بدون دست‌زدن به شکل اصلی مسیر.
+     *
+     * @param string   $url        آدرس کامل منبع
+     * @param string   $secret     کلید مشترک
+     * @param int|null $ttl        عمر امضا (ثانیه)؛ پیش‌فرض DEFAULT_TTL_SECONDS
+     * @param int|null $now        مرجع زمانی (برای تست قطعی)
+     * @return string آدرس امضاشده، یا آدرس اصلی اگر قابل امضا نبود
+     */
+    public static function sign_url($url, $secret, $ttl = null, $now = null) {
+        $url = (string) $url;
+        if ('' === $url || '' === (string) $secret) {
+            return $url;
+        }
+
+        $path = self::path_for_signing($url);
+        if ('' === $path) {
+            return $url; // آدرس بی‌مسیر (نسبی/خراب) — دست‌نخورده برگردانده می‌شود
+        }
+
+        $ttl = (null === $ttl) ? self::DEFAULT_TTL_SECONDS : (int) $ttl;
+        $ttl = max(1, min($ttl, self::MAX_TTL_SECONDS));
+
+        $now = (null === $now) ? time() : (int) $now;
+        $expires = $now + $ttl;
+
+        $signature = self::sign($path, $expires, $secret);
+
+        return add_query_arg(
+            array(
+                'md5'     => $signature,
+                'expires' => $expires,
+            ),
+            $url
+        );
+    }
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // پیکربندی (وردپرس)
+    // ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * کلید مشترک با nginx — ثابت wp-config اولویت دارد، وگرنه گزینهٔ دیتابیس.
+     *
+     * روی نخستین فراخوانی، اگر هیچ‌کدام نبود، کلید تصادفی ساخته و ذخیره
+     * می‌شود (همان الگوی mrdastbaaf_cron_token). ذخیره با autoload=false تا در
+     * alloptions هر درخواست بارگذاری نشود.
+     *
+     * @return string
+     */
+    public static function get_secret() {
+        if (defined(self::SECRET_CONSTANT)) {
+            $from_constant = (string) constant(self::SECRET_CONSTANT);
+            if ('' !== $from_constant) {
+                return $from_constant;
+            }
+        }
+
+        $stored = (string) get_option(self::SECRET_OPTION, '');
+        if ('' !== $stored) {
+            return $stored;
+        }
+
+        $generated = wp_generate_password(48, false, false);
+        update_option(self::SECRET_OPTION, $generated, false);
+
+        return $generated;
+    }
+
+    /**
+     * آیا امضاگذاری فعال است؟
+     *
+     * پیش‌فرض **خاموش** است. دلیل عملیاتی: اگر PHP امضا بگذارد ولی nginx هنوز
+     * بررسی نکند، همه‌چیز کار می‌کند؛ اما اگر nginx بررسی کند و PHP امضا
+     * نگذارد، **تمام پخش‌ها 403 می‌شوند**. پس راه‌اندازی همیشه از سمت PHP
+     * شروع می‌شود و با یک سوئیچ قابل بازگشت است.
+     *
+     * @return bool
+     */
+    public static function is_enabled() {
+        return (bool) apply_filters(
+            'mrdastbaaf_signed_urls_enabled',
+            (bool) get_option(self::ENABLED_OPTION, false)
+        );
+    }
+
+    /**
+     * عمر امضا — با سقف MAX_TTL_SECONDS.
+     *
+     * @return int
+     */
+    public static function get_ttl() {
+        $ttl = (int) get_option(self::TTL_OPTION, self::DEFAULT_TTL_SECONDS);
+        if ($ttl <= 0) {
+            $ttl = self::DEFAULT_TTL_SECONDS;
+        }
+
+        return max(1, min($ttl, self::MAX_TTL_SECONDS));
+    }
+
+    /**
+     * امضای یک آدرس با پیکربندی فعلی.
+     *
+     * اگر امضاگذاری خاموش باشد، آدرس **دست‌نخورده** برگردانده می‌شود — تا
+     * فراخوان لازم نباشد شرط فعال‌بودن را تکرار کند.
+     *
+     * @param string $url
+     * @return string
+     */
+    public static function maybe_sign($url) {
+        if (!self::is_enabled()) {
+            return (string) $url;
+        }
+
+        return self::sign_url($url, self::get_secret(), self::get_ttl());
+    }
+}
