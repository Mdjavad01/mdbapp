+# =============================================================================
+# مستر دستباف — آدرس‌های امضاشده با انقضا روی هاست دانلود
+# فایل نمونهٔ nginx برای dll.mrdastbaaf.com
+# -----------------------------------------------------------------------------
+# این فایل جانشین docs/DLL_HOST_HTACCESS.sample می‌شود.
+#
+# چرا .htaccess کافی نبود: آن لایه بر پایهٔ Referer بود و Referer قابل جعل است.
+# با یک درخواست curl و هدر جعلی، آدرس دائمی ویدیو همچنان کار می‌کرد و هر کسی
+# که آدرس را یک‌بار می‌دید، برای همیشه به فایل دسترسی داشت.
+#
+# این لایه به‌جای «چه کسی درخواست کرده»، «آیا سرور این آدرس را برای این لحظه
+# امضا کرده» را بررسی می‌کند. آدرس بدون امضای معتبر → 403؛ آدرس منقضی → 410.
+#
+# ⚠️ ترتیب راه‌اندازی را رعایت کنید — docs/NGINX_SIGNED_URLS.md
+# =============================================================================
+
+
+# =============================================================================
+# ۰) پیش‌نیاز: ماژول secure_link باید در باینری nginx موجود باشد
+# -----------------------------------------------------------------------------
+# روی سرور اجرا کنید:
+#
+#   nginx -V 2>&1 | tr ' ' '\n' | grep secure_link
+#
+# باید یکی از این دو را ببینید:
+#   --with-http_secure_link_module        (ساخت دستی / nginx.org)
+#   (در بستهٔ nginx-full دبیان/اوبونتو هم موجود است)
+#
+# اگر خروجی خالی بود: بستهٔ nginx-light یا نسخهٔ بدون این ماژول نصب است.
+# راه‌حل: بستهٔ nginx.org یا nginx-full را نصب کنید. بدون این ماژول، ادامه
+# ندهید — کانفیگ بالا نمی‌آید و کل سایت دانلود از کار می‌افتد.
+# =============================================================================
+
+
+# =============================================================================
+# ۱) تعریف کلید مشترک
+# -----------------------------------------------------------------------------
+# این مقدار باید **مو‌به‌مو** با کلید سمت PHP یکی باشد. سمت PHP از این ترتیب
+# می‌خواند:
+#   ۱) ثابت MRDASTBAAF_SIGNED_URL_SECRET در wp-config.php  (توصیه‌شده)
+#   ۲) گزینهٔ mrdastbaaf_signed_url_secret در دیتابیس (خودکار ساخته می‌شود)
+#
+# برای خواندن مقدار خودکارساخته:
+#   wp option get mrdastbaaf_signed_url_secret
+#   — یا —  SELECT option_value FROM wp_options
+#           WHERE option_name = 'mrdastbaaf_signed_url_secret';
+#
+# توصیه: همان مقدار را در wp-config.php هم بگذارید تا یک منبع حقیقت داشته باشید:
+#   define('MRDASTBAAF_SIGNED_URL_SECRET', 'مقدار-دلخواه-بلند-و-تصادفی');
+#
+# ⚠️ اگر کلید دو طرف یکی نباشد، **همهٔ** درخواست‌ها 403 می‌شوند.
+# =============================================================================
+
+map $host $mrd_signed_secret {
+    default "PUT_YOUR_SHARED_SECRET_HERE";
+}
+
+
+server {
+    listen      443 ssl http2;
+    listen      [::]:443 ssl http2;
+    server_name dll.mrdastbaaf.com;
+
+    # ---------------------------------------------------------------------
+    # گواهی TLS — مسیرها را با سرور خود تطبیق دهید
+    # ---------------------------------------------------------------------
+    ssl_certificate     /etc/ssl/mrdastbaaf/dll.crt;
+    ssl_certificate_key /etc/ssl/mrdastbaaf/dll.key;
+    ssl_protocols       TLSv1.2 TLSv1.3;
+    ssl_prefer_server_ciphers off;
+
+    root  /home/mrdastbaaf/dll.mrdastbaaf.com;
+    index index.html;
+
+    # ---------------------------------------------------------------------
+    # فایل‌های ویدیو — قلب این پیکربندی
+    # ---------------------------------------------------------------------
+    # مسیر /FA/ جایی است که ویدیوها قرار دارند. اگر ساختار پوشه‌ها فرق دارد،
+    # این location را متناسب تغییر دهید (امضا روی $uri محاسبه می‌شود، پس
+    # هر مسیری که پوشش دهید به‌طور خودکار محافظت می‌شود).
+    # ---------------------------------------------------------------------
+    location /FA/ {
+
+        # ── امضا را از query string بخوان ──────────────────────────────────
+        # قالب آدرس:  ?md5=<signature>&expires=<unix-timestamp>
+        secure_link $arg_md5,$arg_expires;
+
+        # ── الگوریتم امضا ─────────────────────────────────────────────────
+        # ترتیب اجزا **باید** با PHP یکی باشد:
+        #     $expires . $uri . $secret
+        #
+        # نکتهٔ حیاتی: متغیر $uri در nginx **decode‌شده** است. نام فایل‌های این
+        # پروژه فارسی‌اند و در URL به‌صورت percent-encoded می‌آیند
+        # (/FA/%D8%AF%D8%B1%D8%B3.mp4). سمت PHP هم عمداً مسیر را decode می‌کند
+        # (MrDastbaaf_Signed_Url_Service::path_for_signing) تا با همین متغیر
+        # یکی باشد. اگر امضا روی مسیر encode‌شده محاسبه شود، هیچ امضایی معتبر
+        # شناخته نمی‌شود و همهٔ ویدیوها 403 می‌شوند.
+        secure_link_md5 "$secure_link_expires$uri$mrd_signed_secret";
+
+        # ── نسخهٔ مقید به IP (اختیاری — پیش‌فرض غیرفعال) ───────────────────
+        # bind کردن امضا به IP کاربر، اشتراک‌گذاری آدرس را سخت‌تر می‌کند، اما
+        # برای اپ موبایل خطرناک است: تغییر شبکه (۴G ↔ وای‌فای) وسط پخش، IP را
+        # عوض می‌کند و ویدیو ۴۰۳ می‌شود. اگر فعال می‌کنید، مطمئن شوید که
+        # پلیر در خطا، بلیط تازه می‌گیرد.
+        #
+        # secure_link_md5 "$secure_link_expires$uri$remote_addr$mrd_signed_secret";
+
+        # ── تصمیم دسترسی ──────────────────────────────────────────────────
+        # $secure_link مقادیر زیر را می‌گیرد:
+        #   ""    → امضا غایب یا نامعتبر            → 403
+        #   "0"   → امضا معتبر ولی منقضی            → 410 Gone
+        #   "1"   → معتبر و در بازهٔ اعتبار          → سرو فایل
+        #
+        # ┌─────────────────────────────────────────────────────────────────┐
+        # │ فاز A (راه‌اندازی): دو خط if زیر را کامنت بگذارید.                │
+        # │   nginx آدرس‌های امضاشده و بدون امضا را یکسان سرو می‌کند — یعنی   │
+        # │   می‌توانید مطمئن شوید PHP امضا می‌گذارد و پخش سالم است، بدون     │
+        # │   اینکه اگر جایی از قلم افتاد، کاربر ویدیو از دست بدهد.           │
+        # │                                                                 │
+        # │ فاز B (اعمال): کامنت را بردارید و nginx -s reload.              │
+        # │   از این لحظه دسترسی بدون امضا بسته می‌شود.                       │
+        # └─────────────────────────────────────────────────────────────────┘
+        if ($secure_link = "") { return 403; }
+        if ($secure_link = "0") { return 410; }
+
+        # ── سرو فایل با پشتیبانی از Range ────────────────────────────────
+        # seek در پلیر به Range request وابسته است. nginx برای فایل‌های استاتیک
+        # این را بومی پشتیبانی می‌کند؛ فقط نباید خاموشش کنید.
+        add_header Accept-Ranges bytes always;
+        add_header Cache-Control "private, no-store" always;
+        add_header X-Content-Type-Options nosniff always;
+
+        # ویدیوهای بزرگ: بافر کم و ارسال پیوسته
+        sendfile        on;
+        tcp_nopush      on;
+        tcp_nodelay     on;
+        aio             threads;
+        directio        8m;
+
+        # نبود فایل = 404 (نه صفحهٔ پیش‌فرض سرور)
+        try_files $uri =404;
+    }
+
+    # ---------------------------------------------------------------------
+    # فایل‌های HLS در آینده (.m3u8 و سگمنت‌ها)
+    # ---------------------------------------------------------------------
+    # وقتی پکیجینگ HLS اضافه شد، امضا روی مستر پلی‌لیست هم اعمال می‌شود. توجه:
+    # nginx امضای پلی‌لیست را بررسی می‌کند، اما آدرس سگمنت‌های داخل آن باید
+    # **در همان لحظهٔ ساخت پلی‌لیست** امضا شده باشند (چون هر سگمنت URL جداگانه
+    # است). این کار در لایهٔ PHP انجام می‌شود، نه اینجا.
+    # ---------------------------------------------------------------------
+    location ~* \.(m3u8|ts|m4s)$ {
+        secure_link     $arg_md5,$arg_expires;
+        secure_link_md5 "$secure_link_expires$uri$mrd_signed_secret";
+
+        if ($secure_link = "") { return 403; }
+        if ($secure_link = "0") { return 410; }
+
+        add_header Cache-Control "private, no-store" always;
+        try_files $uri =404;
+    }
+
+    # ---------------------------------------------------------------------
+    # بقیهٔ مسیرها
+    # ---------------------------------------------------------------------
+    # توجه: هر چیزی که در location های بالا پوشش داده نشود، **بدون امضا** سرو
+    # می‌شود. اگر فایل ویدیویی بیرون از /FA/ دارید، یا آن را به /FA/ منتقل
+    # کنید یا location مربوطه را اضافه کنید. برای اطمینان، در پایان راه‌اندازی
+    # این را تست کنید:
+    #     curl -I "https://dll.mrdastbaaf.com/مسیر-دیگر/فایل.mp4"
+    # باید 403 بگیرد، نه 200.
+    # ---------------------------------------------------------------------
+    location / {
+        try_files $uri $uri/ =404;
+    }
+
+    # ---------------------------------------------------------------------
+    # دسترسی به فایل‌های حساس
+    # ---------------------------------------------------------------------
+    location ~ /\.(?!well-known) { deny all; }
+
+    access_log /var/log/nginx/dll.mrdastbaaf.com.access.log;
+    error_log  /var/log/nginx/dll.mrdastbaaf.com.error.log warn;
+}
+
+
+# =============================================================================
+# ۲) اگر هاست دانلود پشت BitNinja/Cloudflare است
+# -----------------------------------------------------------------------------
+# طبق مستندات پروژه، این هاست پشت BitNinja-WafPro قرار دارد. نکته:
+#   - secure_link روی **Apache/nginx مبدأ** اجرا می‌شود، نه روی WAF.
+#   - WAF ممکن است query string را دست‌کاری یا حذف کند. پس از راه‌اندازی،
+#     حتماً با curl واقعی تست کنید که پارامترهای md5 و expires به مبدأ می‌رسند.
+#   - اگر Cloudflare جلوی این هاست است، «Cache Everything» را برای /FA/ خاموش
+#     کنید؛ کش شدن پاسخ ۲۰۰ باعث می‌شود بررسی امضا دور زده شود.
+# =============================================================================
+
+
+# =============================================================================
+# ۳) تست پس از راه‌اندازی
+# -----------------------------------------------------------------------------
+# الف) بدون امضا — باید 403 باشد (پس از فاز B):
+#   curl -I "https://dll.mrdastbaaf.com/FA/lesson-01.mp4"
+#
+# ب) با امضای معتبر — باید 200 و Accept-Ranges: bytes باشد.
+#    (مقدار زیر با secret = test-secret ساخته شده؛ با کلید واقعی خودتان
+#     باید از طریق اپ یا PHP بسازید.)
+#   curl -I "https://dll.mrdastbaaf.com/FA/lesson-01.mp4?md5=uydm921XT5rHRgrrCIVrgA&expires=1800000000"
+#
+# ج) با امضای دست‌کاری‌شده — باید 403 باشد:
+#   curl -I "https://dll.mrdastbaaf.com/FA/lesson-01.mp4?md5=AAAAAAAAAAAAAAAAAAAAAA&expires=1800000000"
+#
+# د) با مهر زمانی گذشته — باید 410 باشد:
+#   curl -I "https://dll.mrdastbaaf.com/FA/lesson-01.mp4?md5=<sig>&expires=1000000000"
+#
+# هـ) Range request با امضای معتبر — باید 206 Partial Content باشد (seek):
+#   curl -I -H "Range: bytes=0-1023" "https://dll.mrdastbaaf.com/FA/lesson-01.mp4?md5=...&expires=..."
+# =============================================================================
