index 0000000..da9be98
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/gateway/signed-url-config.php.sample
@@ -0,0 +1,86 @@
+<?php
+/**
+ * پیکربندی دروازهٔ رسانه (نمونه) — v1.8.0
+ *
+ * ─── نصب ───
+ * این فایل را با نام `signed-url-config.php` کنار `s.php` روی هاست دانلود
+ * بگذارید، مقادیر زیر را پر کنید، و **بلافاصله** مطمئن شوید که از بیرون
+ * قابل دانلود نیست (بخش محافظت در docs/APACHE_SIGNED_URLS.md و نمونهٔ
+ * .htaccess).
+ *
+ * توصیهٔ اکید: این فایل را **بیرون از ریشهٔ وب** بگذارید و مسیرش را با متغیر
+ * محیطی MRD_GATEWAY_CONFIG به s.php بدهید. در آن حالت حتی اگر .htaccess اشتباه
+ * پیکربندی شود، کلید لو نمی‌رود.
+ *
+ * @package mrdastbaaf-bridge
+ */
+
+return array(
+
+    /**
+     * کلید مشترک با افزونه — **باید بایت‌به‌بایت یکسان باشد**.
+     *
+     * همان مقداری که در wp-config.php می‌گذارید:
+     *     define('MRDASTBAAF_SIGNED_URL_SECRET', 'همین-مقدار');
+     *
+     * این کلید تنها چیزی است که جلوی ساخت آدرس دلخواه توسط مهاجم را می‌گیرد.
+     * آن را تصادفی و طولانی انتخاب کنید (حداقل ۳۲ نویسه). اگر لو برود، هر کسی
+     * می‌تواند برای هر فایلی آدرس معتبر بسازد — یعنی دقیقاً همان وضعیتی که این
+     * لایه می‌خواست ببندد.
+     */
+    'secret' => 'CHANGE-ME-to-a-long-random-string-shared-with-wordpress',
+
+    /**
+     * ریشهٔ فایل‌های رسانه روی دیسک (مسیر مطلق).
+     *
+     * همهٔ مسیرهای درخواستی نسبت به این ریشه حل می‌شوند و هیچ فایلی بیرون از آن
+     * سرو نمی‌شود (realpath بررسی می‌شود).
+     */
+    'media_root' => '/var/www/dll.mrdastbaaf.com',
+
+    /**
+     * سقف عمر امضا (ثانیه). حتی اگر امضا معتبر باشد، عمری بیش از این پذیرفته
+     * نمی‌شود تا یک آدرس دزدیده‌شده تا ابد کار نکند. پیش‌فرض: ۲۴ ساعت.
+     */
+    'max_ttl_seconds' => 86400,
+
+    /**
+     * پسوندهای مجاز برای سرو.
+     *
+     * فهرست بسته — هر چیزی خارج از این‌ها ۴۰۴ می‌گیرد، حتی اگر امضایش درست
+     * باشد. اگر روزی HLS اضافه شد، 'm3u8'، 'ts' و 'key' از قبل اینجا هستند.
+     */
+    'allowed_extensions' => array(
+        'mp4', 'm4v', 'mov', 'webm', 'mkv', 'ogv',
+        'm3u8', 'ts', 'm4s', 'key', 'mpd',
+        'vtt', 'srt', 'jpg', 'jpeg', 'png', 'webp',
+        'mp3', 'm4a', 'aac', 'ogg',
+    ),
+
+    /**
+     * هدر Cache-Control پاسخ.
+     *
+     * پیش‌فرض `private, no-store` است تا هیچ نسخهٔ میانی ویدیوی پولی را نگه
+     * ندارد. اگر پخش روان‌تر می‌خواهید می‌توانید به
+     * `private, max-age=300` تغییر دهید — امضا خودش منقضی می‌شود، پس خطرش
+     * محدود است. عمومی (public) هرگز نگذارید.
+     */
+    'cache_control' => 'private, no-store',
+
+    /**
+     * مبدأهای مجاز برای CORS — معمولاً لازم نیست.
+     *
+     * تگ <video> بدون ویژگی crossorigin به هدر CORS نیازی ندارد. فقط اگر کلاینت
+     * با crossorigin="anonymous" درخواست بدهد این را پر کنید:
+     *     array('https://app.mrdastbaaf.com'),
+     * یا برای همه: array('*')
+     */
+    'allowed_origins' => array(),
+
+    /**
+     * لاگ تشخیصی. در حالت true، دلیل دقیق خطا (bad_signature / expired / …)
+     * در error_log سرور نوشته می‌شود. **هرگز** در پاسخ HTTP ظاهر نمی‌شود.
+     * برای عیب‌یابی روشن کنید و بعد خاموش بگذارید.
+     */
+    'debug' => false,
+);
diff --git a/wordpress-plugin/mrdastbaaf-bridge/gateway/signed-url-core.php b/wordpress-plugin/mrdastbaaf-bridge/gateway/signed-url-core.php
new file mode 100644
index 0000000..61efe00
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/gateway/signed-url-core.php
@@ -0,0 +1,496 @@
+<?php
+/**
+ * هستهٔ امضای آدرس و منطق خالص دروازه (v1.8.0) — بدون وردپرس
+ *
+ * ─── چرا این فایل جدا است ───
+ * امضا در «دو» جا محاسبه/بررسی می‌شود:
+ *   ۱) افزونه (سمت وردپرس) هنگام ساخت آدرس پخش
+ *   ۲) دروازهٔ s.php روی هاست دانلود (Apache) هنگام سرو فایل
+ * اگر هر کدام پیاده‌سازی خودش را داشته باشد، دیر یا زود از هم فاصله می‌گیرند و
+ * نتیجه‌اش ۴۰۳ شدن «همهٔ» پخش‌هاست. پس هر دو، همین یک فایل را include می‌کنند.
+ * هیچ وابستگی‌ای به وردپرس اینجا نیست تا s.php بتواند روی هاست دانلود —
+ * که نصب وردپرس ندارد — مستقیم اجرا شود.
+ *
+ * ─── قرارداد امضا ───
+ *   message   = "<مسیر decode‌شده>|<انقضا>|<شناسهٔ کاربر>"
+ *   signature = hash_hmac('sha256', message, secret)      // hex lowercase
+ *   query     = ?f=<path>&e=<expiry>&u=<userId>&t=<signature>
+ *
+ * مسیر در امضا **decode‌شده** است (شکل rawurldecode)، ولی در URL به‌صورت
+ * rawurlencode نوشته می‌شود. دلیل: نام فایل‌های این پروژه فارسی‌اند و در URL
+ * percent-encoded می‌آیند؛ اگر یک طرف روی شکل encode‌شده امضا بگذارد و طرف
+ * دیگر روی decode‌شده، هیچ امضایی معتبر نیست.
+ *
+ * خروجی hex است (نه base64) تا هیچ‌وقت «+»، «/» یا «=» در URL نیفتد — همان
+ * کاراکترهایی که در کوئری‌استرینگ معناهای متفاوتی می‌گیرند.
+ */
+
+if (!defined('ABSPATH') && !defined('MRD_GATEWAY_CONTEXT')) {
+    // فایل باید یا از داخل وردپرس و یا از دروازهٔ مستقل بارگذاری شود.
+    exit;
+}
+
+if (!class_exists('Mdb_Signed_Url_Core')) {
+
+    class Mdb_Signed_Url_Core {
+
+        /** طول عمر پیش‌فرض امضا — هم‌اندازهٔ عمر بلیط پخش. */
+        const DEFAULT_TTL_SECONDS = 900;
+
+        /** سقف عمر امضا — ۲۴ ساعت؛ جلوی پیکربندی‌ای که آدرس را دائمی می‌کند. */
+        const MAX_TTL_SECONDS = 86400;
+
+        /** پسوندهایی که دروازه اجازهٔ سروشان را دارد. */
+        public static function default_allowed_extensions() {
+            return array(
+                // ویدیو
+                'mp4', 'm4v', 'mov', 'webm', 'mkv', 'ogv',
+                // HLS (برای آینده — سرور فعلاً MP4 می‌دهد)
+                'm3u8', 'ts', 'm4s', 'key', 'mpd',
+                // زیرنویس و پوستر
+                'vtt', 'srt', 'jpg', 'jpeg', 'png', 'webp',
+                // صدا
+                'mp3', 'm4a', 'aac', 'ogg',
+            );
+        }
+
+        // ─────────────────────────────────────────────────────────────────────
+        // امضا
+        // ─────────────────────────────────────────────────────────────────────
+
+        /**
+         * پیام امضا. تنها جایی که قالب پیام تعریف می‌شود.
+         *
+         * @param string   $decoded_path مسیر decode‌شده (مثل /FA/درس-اول.mp4)
+         * @param int      $expires      مهر زمانی انقضا (UTC)
+         * @param int|null $user_id      شناسهٔ کاربر؛ 0 برای مهمان/پیش‌نمایش رایگان
+         * @return string
+         */
+        public static function message($decoded_path, $expires, $user_id) {
+            return (string) $decoded_path . '|' . (int) $expires . '|' . (int) $user_id;
+        }
+
+        /**
+         * امضای HMAC-SHA256 به‌صورت hex.
+         *
+         * @param string   $decoded_path
+         * @param int      $expires
+         * @param int|null $user_id
+         * @param string   $secret
+         * @return string رشتهٔ ۶۴ کاراکتری hex، یا '' اگر secret خالی باشد
+         */
+        public static function signature($decoded_path, $expires, $user_id, $secret) {
+            $secret = (string) $secret;
+            if ('' === $secret) {
+                return '';
+            }
+
+            return hash_hmac(
+                'sha256',
+                self::message($decoded_path, $expires, $user_id),
+                $secret
+            );
+        }
+
+        /**
+         * اعتبارسنجی یک امضا.
+         *
+         * ترتیب بررسی‌ها مهم است: اول انقضا (ارزان)، بعد مقایسهٔ زمان-ثابت.
+         *
+         * @param string   $decoded_path
+         * @param int      $expires
+         * @param int|null $user_id
+         * @param string   $signature
+         * @param string   $secret
+         * @param int|null $now
+         * @return bool
+         */
+        public static function verify($decoded_path, $expires, $user_id, $signature, $secret, $now = null) {
+            $signature = (string) $signature;
+            $secret = (string) $secret;
+
+            if ('' === $signature || '' === $secret) {
+                return false;
+            }
+
+            $now = (null === $now) ? time() : (int) $now;
+            if ((int) $expires <= $now) {
+                return false; // منقضی — fail-closed
+            }
+
+            $expected = self::signature($decoded_path, $expires, $user_id, $secret);
+            if ('' === $expected) {
+                return false;
+            }
+
+            // مقایسهٔ زمان-ثابت تا امضا قابل حدس‌زدن کاراکتر-به-کاراکتر نباشد.
+            return hash_equals($expected, $signature);
+        }
+
+        /**
+         * استخراج مسیرِ قابل‌امضا از یک آدرس کامل یا نسبی.
+         *
+         * **decode می‌کند** و «+» را دست‌نخورده می‌گذارد (rawurldecode برخلاف
+         * urldecode «+» را فاصله نمی‌کند) — چون سمت دروازه هم عیناً همین کار
+         * انجام می‌شود.
+         *
+         * @param string $url
+         * @return string مسیر decode‌شده، یا '' اگر قابل استخراج نبود
+         */
+        public static function path_for_signing($url) {
+            $url = (string) $url;
+            if ('' === $url) {
+                return '';
+            }
+
+            $path = self::url_path($url);
+            if ('' === $path) {
+                return '';
+            }
+
+            return rawurldecode($path);
+        }
+
+        /**
+         * استخراج بخش path از یک آدرس، با پشتیبانی از ورودی بدون scheme.
+         *
+         * از parse_url مستقیم استفاده نمی‌کنیم چون برای رشتهٔ بدون scheme رفتار
+         * غیرشهودی دارد؛ اینجا خودمان تصمیم می‌گیریم.
+         *
+         * @param string $url
+         * @return string
+         */
+        private static function url_path($url) {
+            $url = (string) $url;
+
+            // آدرس کامل با scheme یا protocol-relative
+            if (preg_match('#^[a-z][a-z0-9+.\-]*://#i', $url) || strpos($url, '//') === 0) {
+                $parsed = parse_url($url, PHP_URL_PATH);
+                return is_string($parsed) ? $parsed : '';
+            }
+
+            // مسیر نسبی یا مطلق بدون میزبان — کوئری و fragment را ببر
+            $cut = strcspn($url, '?#');
+            return substr($url, 0, $cut);
+        }
+
+        /**
+         * ساخت آدرس دروازه از یک آدرس رسانه.
+         *
+         * @param string   $media_url  آدرس اصلی فایل روی هاست دانلود
+         * @param string   $gateway    آدرس پایهٔ دروازه (مثل https://dll.example.com/s.php)
+         * @param int|null $user_id
+         * @param string   $secret
+         * @param int|null $ttl
+         * @param int|null $now
+         * @return string آدرس امضاشده، یا آدرس اصلی اگر قابل امضا نبود
+         */
+        public static function build_gateway_url($media_url, $gateway, $user_id, $secret, $ttl = null, $now = null) {
+            $media_url = (string) $media_url;
+            $gateway = trim((string) $gateway);
+
+            if ('' === $media_url || '' === $gateway || '' === (string) $secret) {
+                return $media_url;
+            }
+
+            $path = self::path_for_signing($media_url);
+            if ('' === $path) {
+                return $media_url; // آدرس بی‌مسیر — دست‌نخورده
+            }
+
+            $ttl = (null === $ttl) ? self::DEFAULT_TTL_SECONDS : (int) $ttl;
+            $ttl = max(1, min($ttl, self::MAX_TTL_SECONDS));
+
+            $now = (null === $now) ? time() : (int) $now;
+            $expires = $now + $ttl;
+            $user_id = (int) $user_id;
+
+            $signature = self::signature($path, $expires, $user_id, $secret);
+            if ('' === $signature) {
+                return $media_url;
+            }
+
+            $query = http_build_query(
+                array(
+                    'f' => $path,          // http_build_query از rawurlencode استفاده می‌کند
+                    'e' => $expires,
+                    'u' => $user_id,
+                    't' => $signature,
+                ),
+                '',
+                '&',
+                PHP_QUERY_RFC3986
+            );
+
+            $separator = (strpos($gateway, '?') === false) ? '?' : '&';
+
+            return $gateway . $separator . $query;
+        }
+
+        // ─────────────────────────────────────────────────────────────────────
+        // امنیت مسیر (سمت دروازه)
+        // ─────────────────────────────────────────────────────────────────────
+
+        /**
+         * تبدیل مسیر درخواستی به مسیر مطلق امن روی دیسک.
+         *
+         * چهار لایهٔ دفاع:
+         *   ۱) نویسهٔ null رد می‌شود
+         *   ۲) هر بخش «..» رد می‌شود (پس از یکسان‌سازی «\» به «/»)
+         *   ۳) پسوند باید در فهرست مجاز باشد
+         *   ۴) realpath نهایی باید داخل realpath ریشهٔ رسانه باشد — این لایه
+         *      symlink و مسیرهای عجیب را هم می‌گیرد
+         *
+         * @param string   $media_root ریشهٔ رسانه روی دیسک
+         * @param string   $decoded_path مسیر decode‌شدهٔ درخواستی
+         * @param string[]|null $allowed_extensions
+         * @return string|null مسیر مطلق، یا null اگر نامعتبر بود
+         */
+        public static function resolve_path($media_root, $decoded_path, $allowed_extensions = null) {
+            $media_root = rtrim((string) $media_root, "/\\");
+            $decoded_path = (string) $decoded_path;
+
+            if ('' === $media_root || '' === $decoded_path) {
+                return null;
+            }
+            if (strpos($decoded_path, "\0") !== false) {
+                return null;
+            }
+
+            $root_real = realpath($media_root);
+            if (false === $root_real || !is_dir($root_real)) {
+                return null; // پیکربندی خراب — fail-closed
+            }
+
+            // اگر کلاینت اشتباهاً یک URL کامل فرستاده باشد، فقط مسیرش را برمی‌داریم.
+            if (preg_match('#^[a-z][a-z0-9+.\-]*://#i', $decoded_path)) {
+                $parsed = parse_url($decoded_path, PHP_URL_PATH);
+                $decoded_path = is_string($parsed) ? $parsed : '';
+            }
+
+            // یکسان‌سازی جداکننده‌ها: در ویندوز «\» هم جداکننده است و بدون این
+            // خط، «..\..\x» از بررسی بخش‌ها رد می‌شد.
+            $decoded_path = str_replace('\\', '/', $decoded_path);
+
+            // نرمال‌سازی: حذف اسلش‌های تکراری و بخش‌های «.»؛ «..» را رد می‌کنیم
+            // (به‌جای حل‌کردنش) تا هیچ ورودی‌ای نتواند از ریشه بیرون بزند.
+            $segments = explode('/', $decoded_path);
+            $clean = array();
+            foreach ($segments as $segment) {
+                if ('' === $segment || '.' === $segment) {
+                    continue;
+                }
+                if ('..' === $segment) {
+                    return null;
+                }
+                $clean[] = $segment;
+            }
+
+            if (empty($clean)) {
+                return null;
+            }
+
+            $relative = implode('/', $clean);
+
+            $extensions = (null === $allowed_extensions)
+                ? self::default_allowed_extensions()
+                : $allowed_extensions;
+            if (!self::is_allowed_extension($relative, $extensions)) {
+                return null;
+            }
+
+            $candidate = $root_real . DIRECTORY_SEPARATOR . $relative;
+            $real = realpath($candidate);
+
+            if (false === $real || !is_file($real)) {
+                return null;
+            }
+
+            // لایهٔ آخر: مسیر واقعی باید واقعاً داخل ریشه باشد.
+            $root_prefix = $root_real . DIRECTORY_SEPARATOR;
+            if (strpos($real . DIRECTORY_SEPARATOR, $root_prefix) !== 0) {
+                return null;
+            }
+
+            return $real;
+        }
+
+        /**
+         * آیا پسوند فایل در فهرست مجاز است؟
+         *
+         * مقایسه بدون حساسیت به بزرگی/کوچکی حروف.
+         *
+         * @param string   $path
+         * @param string[] $allowed
+         * @return bool
+         */
+        public static function is_allowed_extension($path, $allowed) {
+            $path = (string) $path;
+            $dot = strrpos($path, '.');
+            if (false === $dot || $dot === strlen($path) - 1) {
+                return false; // بدون پسوند — رد
+            }
+
+            $ext = strtolower(substr($path, $dot + 1));
+
+            foreach ((array) $allowed as $candidate) {
+                if (strtolower((string) $candidate) === $ext) {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        /**
+         * نوع محتوا از روی پسوند — عمداً فهرست بسته، نه حدس.
+         *
+         * @param string $path
+         * @return string
+         */
+        public static function content_type_for($path) {
+            $map = array(
+                'mp4'  => 'video/mp4',
+                'm4v'  => 'video/mp4',
+                'mov'  => 'video/quicktime',
+                'webm' => 'video/webm',
+                'mkv'  => 'video/x-matroska',
+                'ogv'  => 'video/ogg',
+                'm3u8' => 'application/vnd.apple.mpegurl',
+                'ts'   => 'video/mp2t',
+                'm4s'  => 'video/iso.segment',
+                'mpd'  => 'application/dash+xml',
+                'key'  => 'application/octet-stream',
+                'vtt'  => 'text/vtt',
+                'srt'  => 'application/x-subrip',
+                'jpg'  => 'image/jpeg',
+                'jpeg' => 'image/jpeg',
+                'png'  => 'image/png',
+                'webp' => 'image/webp',
+                'mp3'  => 'audio/mpeg',
+                'm4a'  => 'audio/mp4',
+                'aac'  => 'audio/aac',
+                'ogg'  => 'audio/ogg',
+            );
+
+            $dot = strrpos((string) $path, '.');
+            $ext = (false === $dot) ? '' : strtolower(substr($path, $dot + 1));
+
+            return isset($map[$ext]) ? $map[$ext] : 'application/octet-stream';
+        }
+
+        // ─────────────────────────────────────────────────────────────────────
+        // Range
+        // ─────────────────────────────────────────────────────────────────────
+
+        /** نتیجهٔ «کل فایل را بفرست» (۲۰۰). */
+        const RANGE_FULL = null;
+
+        /** نتیجهٔ «درخواست غیرقابل‌ارضا» (۴۱۶). */
+        const RANGE_INVALID = false;
+
+        /**
+         * تجزیهٔ هدر Range.
+         *
+         * خروجی:
+         *   array('start' => int, 'end' => int)  → ۲۰۶ با Content-Range
+         *   RANGE_FULL (null)                    → ۲۰۰، کل فایل
+         *   RANGE_INVALID (false)                → ۴۱۶
+         *
+         * در درخواست چندبازه‌ای فقط بازهٔ اول سرو می‌شود. ارسال multipart/byteranges
+         * برای یک پلیر ویدیویی بی‌فایده است و فقط سطح حمله را باز می‌کند.
+         *
+         * @param string $header مقدار خام هدر Range
+         * @param int    $filesize اندازهٔ فایل
+         * @return array|bool|null
+         */
+        public static function parse_range($header, $filesize) {
+            $header = trim((string) $header);
+            $filesize = (int) $filesize;
+
+            if ('' === $header) {
+                return self::RANGE_FULL;
+            }
+
+            // واحد ناشناخته ⇒ نادیده بگیر و کل فایل را بفرست (رفتار RFC 7233).
+            if (stripos($header, 'bytes=') !== 0) {
+                return self::RANGE_FULL;
+            }
+
+            $spec = trim(substr($header, 6));
+
+            // چندبازه‌ای: فقط اولی
+            $comma = strpos($spec, ',');
+            if (false !== $comma) {
+                $spec = trim(substr($spec, 0, $comma));
+            }
+
+            if ('' === $spec || strpos($spec, '-') === false) {
+                return self::RANGE_FULL;
+            }
+
+            if ($filesize <= 0) {
+                return self::RANGE_INVALID; // فایل خالی هیچ بازه‌ای ندارد
+            }
+
+            $parts = explode('-', $spec, 2);
+            $start_raw = trim($parts[0]);
+            $end_raw = trim($parts[1]);
+
+            // «bytes=-N» ⇒ N بایت آخر
+            if ('' === $start_raw) {
+                if ('' === $end_raw || !ctype_digit($end_raw)) {
+                    return self::RANGE_FULL;
+                }
+                $suffix = (int) $end_raw;
+                if ($suffix <= 0) {
+                    return self::RANGE_INVALID;
+                }
+                if ($suffix >= $filesize) {
+                    return array('start' => 0, 'end' => $filesize - 1);
+                }
+                return array('start' => $filesize - $suffix, 'end' => $filesize - 1);
+            }
+
+            if (!ctype_digit($start_raw)) {
+                return self::RANGE_FULL;
+            }
+
+            $start = (int) $start_raw;
+
+            // «bytes=N-» ⇒ از N تا انتها
+            if ('' === $end_raw) {
+                if ($start >= $filesize) {
+                    return self::RANGE_INVALID;
+                }
+                return array('start' => $start, 'end' => $filesize - 1);
+            }
+
+            if (!ctype_digit($end_raw)) {
+                return self::RANGE_FULL;
+            }
+
+            $end = (int) $end_raw;
+
+            if ($start > $end) {
+                return self::RANGE_INVALID;
+            }
+            if ($start >= $filesize) {
+                return self::RANGE_INVALID;
+            }
+
+            if ($end >= $filesize) {
+                $end = $filesize - 1;
+            }
+
+            return array('start' => $start, 'end' => $end);
+        }
+
+        /**
+         * هدر Content-Range برای پاسخ ۲۰۶.
+         */
+        public static function content_range_header($start, $end, $filesize) {
+            return 'bytes ' . (int) $start . '-' . (int) $end . '/' . (int) $filesize;
+        }
+    }
+}
