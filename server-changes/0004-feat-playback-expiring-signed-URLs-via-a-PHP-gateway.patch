--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/includes/class-signed-url-service.php
@@ -0,0 +1,241 @@
+<?php
+/**
+ * آدرس‌های امضاشده با انقضا برای هاست دانلود (v1.8.0 — بدون تغییر اسکیما)
+ *
+ * ─── مسئله ───
+ * تا پیش از این، POST /lessons/{id}/playback یک آدرس **دائمی** برمی‌گرداند:
+ * https://dll.mrdastbaaf.com/FA/lesson-01.mp4
+ * هر کسی که این آدرس را می‌گرفت (از تب Network، از یک لاگ، از یک اسکرین‌شات)
+ * برای همیشه و بدون ورود می‌توانست ویدیو را دانلود کند. تنها محافظ،
+ * Hotlink Protection مبتنی بر Referer بود که با یک هدر جعلی دور زده می‌شود.
+ *
+ * ─── راه‌حل ───
+ * آدرس کوتاه‌عمرِ امضاشده که به **دروازهٔ PHP** روی هاست دانلود اشاره می‌کند:
+ *
+ *   https://dll.mrdastbaaf.com/s.php?f=%2FFA%2Flesson-01.mp4&e=1800000000&u=42&t=<hmac>
+ *
+ * دروازه (gateway/s.php) پیش از سرو فایل، امضا را بررسی می‌کند.
+ *
+ * ⚠️ نسخهٔ اول این طرح بر پایهٔ ماژول secure_link خود nginx نوشته شده بود.
+ * هاست دانلود این پروژه **Apache** است، پس اعتبارسنجی به دروازهٔ PHP منتقل شد
+ * و دیگر هیچ وابستگی‌ای به nginx وجود ندارد.
+ *
+ * ─── الگوریتم (تعریف‌شده در gateway/signed-url-core.php) ───
+ *   message   = "<مسیر decode‌شده>|<انقضا>|<شناسهٔ کاربر>"
+ *   signature = hash_hmac('sha256', message, secret)   // hex
+ *
+ * **این کلاس هیچ محاسبهٔ رمزنگاری‌ای خودش انجام نمی‌دهد** — همه به هستهٔ
+ * مشترک واگذار می‌شود. دلیلش ساده است: امضا در دو جا (اینجا و دروازه) ساخته و
+ * بررسی می‌شود؛ اگر دو پیاده‌سازی جدا باشند، دیر یا زود از هم فاصله می‌گیرند و
+ * نتیجه‌اش ۴۰۳ شدن همهٔ پخش‌هاست.
+ *
+ * ─── ترتیب راه‌اندازی (مهم) ───
+ * ۱) دروازه را روی هاست دانلود مستقر کنید.
+ * ۲) آدرس دروازه را تنظیم و پرچم را روشن کنید.
+ * ۳) **آخر از همه** دسترسی مستقیم را با .htaccess ببندید.
+ * جزئیات در docs/APACHE_SIGNED_URLS.md.
+ */
+
+if (!defined('ABSPATH')) {
+    exit;
+}
+
+require_once MRDASTBAAF_BRIDGE_PATH . 'gateway/signed-url-core.php';
+
+class MrDastbaaf_Signed_Url_Service {
+
+    const SECRET_OPTION  = 'mrdastbaaf_signed_url_secret';
+    const ENABLED_OPTION = 'mrdastbaaf_signed_urls_enabled';
+    const TTL_OPTION     = 'mrdastbaaf_signed_url_ttl';
+    const GATEWAY_OPTION = 'mrdastbaaf_signed_url_gateway';
+
+    /**
+     * تعریف ثابت در wp-config.php بر پایگاه‌داده اولویت دارد.
+     *
+     * چرا: این کلید باید **هم** در افزونه و **هم** در فایل پیکربندی دروازه یکی
+     * باشد. نگه‌داشتنش در wp-config یعنی یک منبع حقیقت، بدون رفت‌وبرگشت
+     * دیتابیس، و بدون اینکه مقدارش در پشتیبان‌گیری دیتابیس بیفتد.
+     */
+    const SECRET_CONSTANT  = 'MRDASTBAAF_SIGNED_URL_SECRET';
+    const GATEWAY_CONSTANT = 'MRDASTBAAF_SIGNED_URL_GATEWAY';
+
+    /** عمر پیش‌فرض امضا — ۱۵ دقیقه، هم‌اندازهٔ عمر بلیط پخش. */
+    const DEFAULT_TTL_SECONDS = Mdb_Signed_Url_Core::DEFAULT_TTL_SECONDS;
+
+    /** سقف TTL — ۲۴ ساعت. جلوگیری از پیکربندی اشتباهی که آدرس را دائمی می‌کند. */
+    const MAX_TTL_SECONDS = Mdb_Signed_Url_Core::MAX_TTL_SECONDS;
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // بخش خالص — واگذاری به هستهٔ مشترک
+    // ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * امضای یک مسیر decode‌شده.
+     *
+     * @param string   $decoded_path
+     * @param int      $expires
+     * @param int|null $user_id
+     * @param string   $secret
+     * @return string hex (۶۴ کاراکتر)، یا '' اگر secret خالی باشد
+     */
+    public static function sign($decoded_path, $expires, $user_id, $secret) {
+        return Mdb_Signed_Url_Core::signature($decoded_path, $expires, $user_id, $secret);
+    }
+
+    /**
+     * اعتبارسنجی امضا — برای خودآزمایی، تست و عیب‌یابی.
+     *
+     * در پروداکشن، اعتبارسنجی کار دروازه است؛ این متد برای تست یکپارچگی
+     * «افزونه ↔ دروازه» به‌کار می‌رود.
+     */
+    public static function verify($decoded_path, $expires, $user_id, $signature, $secret, $now = null) {
+        return Mdb_Signed_Url_Core::verify($decoded_path, $expires, $user_id, $signature, $secret, $now);
+    }
+
+    /**
+     * استخراج مسیر decode‌شده از یک آدرس.
+     *
+     * **decode می‌شود** تا با مقداری که دروازه از پارامتر `f` می‌گیرد یکی باشد.
+     * نام فایل‌های این پروژه فارسی‌اند و در URL percent-encoded می‌آیند؛ اگر
+     * یک طرف روی شکل encode‌شده امضا بگذارد و طرف دیگر روی decode‌شده، هیچ
+     * امضایی معتبر نیست و **همهٔ ویدیوها ۴۰۳ می‌شوند**.
+     */
+    public static function path_for_signing($url) {
+        return Mdb_Signed_Url_Core::path_for_signing($url);
+    }
+
+    /**
+     * ساخت آدرس دروازه برای یک فایل رسانه.
+     *
+     * @param string      $media_url
+     * @param int|null    $user_id
+     * @param string      $secret
+     * @param int|null    $ttl
+     * @param int|null    $now
+     * @param string|null $gateway آدرس پایهٔ دروازه؛ پیش‌فرض از پیکربندی
+     * @return string آدرس امضاشده، یا آدرس اصلی اگر قابل امضا نبود
+     */
+    public static function sign_url($media_url, $user_id, $secret, $ttl = null, $now = null, $gateway = null) {
+        if (null === $gateway) {
+            $gateway = self::get_gateway_url();
+        }
+
+        return Mdb_Signed_Url_Core::build_gateway_url($media_url, $gateway, $user_id, $secret, $ttl, $now);
+    }
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // پیکربندی (وردپرس)
+    // ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * کلید مشترک — ثابت wp-config اولویت دارد، وگرنه گزینهٔ دیتابیس.
+     *
+     * روی نخستین فراخوانی، اگر هیچ‌کدام نبود، کلید تصادفی ساخته و ذخیره
+     * می‌شود (همان الگوی mrdastbaaf_cron_token). ذخیره با autoload=false تا در
+     * alloptions هر درخواست بارگذاری نشود.
+     *
+     * ⚠️ این مقدار باید **دقیقاً** با 'secret' در فایل پیکربندی دروازه یکی باشد.
+     *
+     * @return string
+     */
+    public static function get_secret() {
+        if (defined(self::SECRET_CONSTANT)) {
+            $from_constant = (string) constant(self::SECRET_CONSTANT);
+            if ('' !== $from_constant) {
+                return $from_constant;
+            }
+        }
+
+        $stored = (string) get_option(self::SECRET_OPTION, '');
+        if ('' !== $stored) {
+            return $stored;
+        }
+
+        $generated = wp_generate_password(48, false, false);
+        update_option(self::SECRET_OPTION, $generated, false);
+
+        return $generated;
+    }
+
+    /**
+     * آدرس پایهٔ دروازه (s.php روی هاست دانلود).
+     *
+     * @return string
+     */
+    public static function get_gateway_url() {
+        if (defined(self::GATEWAY_CONSTANT)) {
+            $from_constant = trim((string) constant(self::GATEWAY_CONSTANT));
+            if ('' !== $from_constant) {
+                return $from_constant;
+            }
+        }
+
+        return trim((string) get_option(self::GATEWAY_OPTION, ''));
+    }
+
+    /**
+     * آیا امضاگذاری فعال است؟
+     *
+     * دو شرط با هم: پرچم روشن **و** آدرس دروازه تنظیم‌شده. اگر پرچم روشن باشد
+     * ولی دروازه پیکربندی نشده باشد، آدرس‌ها بدون دروازه ساخته می‌شوند — یعنی
+     * کاربر آدرس ناقصی می‌گیرد و پخش می‌شکند. پس در آن حالت عمداً «خاموش»
+     * گزارش می‌شود و آدرس اصلی دست‌نخورده می‌ماند.
+     *
+     * پیش‌فرض خاموش است. دلیل عملیاتی: اگر افزونه امضا بگذارد ولی دروازه هنوز
+     * مستقر نشده باشد، همه‌چیز کار می‌کند؛ اما اگر دروازه مستقر شود و افزونه
+     * امضا نگذارد، **تمام پخش‌ها ۴۰۳ می‌شوند**.
+     *
+     * @return bool
+     */
+    public static function is_enabled() {
+        $flag = (bool) apply_filters(
+            'mrdastbaaf_signed_urls_enabled',
+            (bool) get_option(self::ENABLED_OPTION, false)
+        );
+
+        if (!$flag) {
+            return false;
+        }
+
+        return '' !== self::get_gateway_url();
+    }
+
+    /**
+     * عمر امضا — با سقف MAX_TTL_SECONDS.
+     *
+     * @return int
+     */
+    public static function get_ttl() {
+        $ttl = (int) get_option(self::TTL_OPTION, self::DEFAULT_TTL_SECONDS);
+        if ($ttl <= 0) {
+            $ttl = self::DEFAULT_TTL_SECONDS;
+        }
+
+        return max(1, min($ttl, self::MAX_TTL_SECONDS));
+    }
+
+    /**
+     * امضای یک آدرس با پیکربندی فعلی.
+     *
+     * اگر امضاگذاری خاموش باشد، آدرس **دست‌نخورده** برگردانده می‌شود — تا
+     * فراخوان لازم نباشد شرط فعال‌بودن را تکرار کند.
+     *
+     * @param string   $url     آدرس اصلی فایل رسانه
+     * @param int|null $user_id شناسهٔ کاربر امضاکننده؛ 0 برای مهمان/پیش‌نمایش رایگان
+     * @return string
+     */
+    public static function maybe_sign($url, $user_id = 0) {
+        if (!self::is_enabled()) {
+            return (string) $url;
+        }
+
+        return self::sign_url(
+            $url,
+            (int) $user_id,
+            self::get_secret(),
+            self::get_ttl(),
+            null,
+            self::get_gateway_url()
+        );
+    }
+}
