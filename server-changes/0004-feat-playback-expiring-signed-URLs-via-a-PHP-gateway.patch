diff --git a/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-signed-urls.php b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-signed-urls.php
new file mode 100644
index 0000000..f232274
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/tests/php/test-signed-urls.php
@@ -0,0 +1,787 @@
+<?php
+/**
+ * تست امضای آدرس و دروازهٔ رسانه (test-signed-urls) — بدون وردپرس
+ *
+ * اجرا: php tests/php/test-signed-urls.php
+ *
+ * ─── چرا این تست حیاتی است ───
+ * امضا در دو جا ساخته/بررسی می‌شود: افزونه (سمت وردپرس) و دروازهٔ s.php روی
+ * هاست دانلود. اگر یک کاراکتر اختلاف باشد — یک «|» جابه‌جا، مسیر encode‌شده به
+ * جای decode‌شده، hex به جای base64 — **همهٔ** پخش‌های پلتفرم ۴۰۳ می‌شوند.
+ *
+ * این تست قرارداد را با بردارهای ثابت قفل می‌کند و همان بردارها مستقل با
+ * پایتون هم بازمحاسبه و تأیید شده‌اند:
+ *
+ *   message = "/FA/lesson-01.mp4|1800000000|42", secret = "test-secret"
+ *   ⇒ 101d4a77cbe84329e3b27880f939926f05d12c570d34304ef078ac078343776a
+ *
+ *   message = "/FA/درس-اول.mp4|1800000000|42", secret = "test-secret"
+ *   ⇒ d7fe6d69ddfb61f7307ce2fd0aeaccf18cca5b97ed0eb224393035f5191ded9b
+ *
+ * بخش‌ها:
+ *   ۱) بردار ثابت و اثر هر جزء ورودی
+ *   ۲) استخراج و decode مسیر (فارسی/percent-encoded)
+ *   ۳) ساخت آدرس دروازه و رفت‌وبرگشت کامل
+ *   ۴) اعتبارسنجی امضا
+ *   ۵) resolve_path — traversal و فهرست پسوند
+ *   ۶) parse_range
+ *   ۷) evaluate — کدهای وضعیت دروازه
+ *   ۸) parse_query — حفظ «+»
+ *   ۹) پیکربندی افزونه
+ *  ۱۰) نگهبان واگرایی: افزونه و دروازه یک امضا می‌دهند
+ */
+
+define('ABSPATH', '/tmp/');
+define('MRDASTBAAF_BRIDGE_PATH', __DIR__ . '/../../');
+
+if (!defined('MINUTE_IN_SECONDS')) {
+    define('MINUTE_IN_SECONDS', 60);
+}
+if (!defined('HOUR_IN_SECONDS')) {
+    define('HOUR_IN_SECONDS', 3600);
+}
+if (!defined('DAY_IN_SECONDS')) {
+    define('DAY_IN_SECONDS', 86400);
+}
+
+$GLOBALS['mrd_test_options'] = array();
+$GLOBALS['mrd_test_filters'] = array();
+
+if (!function_exists('get_option')) {
+    function get_option($name, $default = false) {
+        return isset($GLOBALS['mrd_test_options'][$name]) ? $GLOBALS['mrd_test_options'][$name] : $default;
+    }
+}
+if (!function_exists('update_option')) {
+    function update_option($name, $value, $autoload = null) {
+        $GLOBALS['mrd_test_options'][$name] = $value;
+        return true;
+    }
+}
+if (!function_exists('apply_filters')) {
+    function apply_filters($tag, $value) {
+        return isset($GLOBALS['mrd_test_filters'][$tag]) ? $GLOBALS['mrd_test_filters'][$tag] : $value;
+    }
+}
+if (!function_exists('wp_generate_password')) {
+    function wp_generate_password($length = 12, $special = true, $extra = true) {
+        return substr(str_repeat('abcdef0123456789', 8), 0, $length);
+    }
+}
+
+require_once __DIR__ . '/../../includes/class-signed-url-service.php';
+require_once __DIR__ . '/../../gateway/SignedUrlGateway.php';
+
+$pass = 0;
+$fail = 0;
+$skip = 0;
+
+function mrd_assert($label, $actual, $expected) {
+    global $pass, $fail;
+    if ($actual === $expected) {
+        $pass++;
+        echo "PASS: {$label}\n";
+    } else {
+        $fail++;
+        echo "FAIL: {$label} — expected: " . var_export($expected, true) . " | got: " . var_export($actual, true) . "\n";
+    }
+}
+
+function mrd_skip($label, $why) {
+    global $skip;
+    $skip++;
+    echo "SKIP: {$label} ({$why})\n";
+}
+
+const MRD_SECRET = 'test-secret';
+const MRD_EXPIRES = 1800000000;
+const MRD_UID = 42;
+const MRD_PATH = '/FA/lesson-01.mp4';
+const MRD_SIG = '101d4a77cbe84329e3b27880f939926f05d12c570d34304ef078ac078343776a';
+const MRD_FA_PATH = '/FA/درس-اول.mp4';
+const MRD_FA_SIG = 'd7fe6d69ddfb61f7307ce2fd0aeaccf18cca5b97ed0eb224393035f5191ded9b';
+const MRD_GATEWAY = 'https://dll.mrdastbaaf.com/s.php';
+
+// ─── ۱) بردار ثابت ─────────────────────────────────────────────────────────
+
+mrd_assert(
+    'signature matches the fixed, python-verified vector',
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET),
+    MRD_SIG
+);
+
+mrd_assert(
+    'signature matches the fixed vector for a persian path',
+    Mdb_Signed_Url_Core::signature(MRD_FA_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET),
+    MRD_FA_SIG
+);
+
+mrd_assert(
+    'the message format is path|expiry|userId',
+    Mdb_Signed_Url_Core::message(MRD_PATH, MRD_EXPIRES, MRD_UID),
+    '/FA/lesson-01.mp4|1800000000|42'
+);
+
+mrd_assert(
+    'signature is deterministic',
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET),
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET)
+);
+
+mrd_assert(
+    'signature is lowercase hex sha256 (64 chars, no + / or =)',
+    (bool) preg_match('/^[0-9a-f]{64}$/', Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET)),
+    true
+);
+
+// هر جزء ورودی باید در امضا اثر داشته باشد — وگرنه امضا قابل جعل می‌شد.
+mrd_assert(
+    'a different secret yields a different signature',
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, 'other-secret') === MRD_SIG,
+    false
+);
+mrd_assert(
+    'a different expiry yields a different signature',
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES + 1, MRD_UID, MRD_SECRET) === MRD_SIG,
+    false
+);
+mrd_assert(
+    'a different path yields a different signature',
+    Mdb_Signed_Url_Core::signature('/FA/lesson-02.mp4', MRD_EXPIRES, MRD_UID, MRD_SECRET) === MRD_SIG,
+    false
+);
+// شناسهٔ کاربر در امضاست، پس لینک یک کاربر برای کاربر دیگر معتبر نیست.
+mrd_assert(
+    'a different user id yields a different signature',
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, 43, MRD_SECRET) === MRD_SIG,
+    false
+);
+// جداکننده باید واقعاً جداکننده باشد: بدون آن، path+expiry می‌توانستند جابه‌جا
+// ترکیب شوند و دو ورودی متفاوت یک امضا بدهند (حملهٔ الحاق).
+mrd_assert(
+    'the separator prevents concatenation ambiguity',
+    Mdb_Signed_Url_Core::signature('/FA/a|1800000000|1.mp4', MRD_EXPIRES, MRD_UID, MRD_SECRET)
+        === Mdb_Signed_Url_Core::signature('/FA/a', MRD_EXPIRES, MRD_UID, MRD_SECRET),
+    false
+);
+
+mrd_assert(
+    'an empty secret yields an empty signature',
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, ''),
+    ''
+);
+
+// ─── ۲) استخراج مسیر ───────────────────────────────────────────────────────
+
+mrd_assert(
+    'path_for_signing strips the query string',
+    Mdb_Signed_Url_Core::path_for_signing('https://dll.mrdastbaaf.com/FA/lesson-01.mp4?foo=bar'),
+    '/FA/lesson-01.mp4'
+);
+
+mrd_assert(
+    'path_for_signing percent-decodes so both sides agree',
+    Mdb_Signed_Url_Core::path_for_signing('https://dll.mrdastbaaf.com/FA/%D8%AF%D8%B1%D8%B3-%DB%B1.mp4'),
+    '/FA/درس-۱.mp4'
+);
+
+// دلیل وجود decode: اگر روی مسیر encode‌شده امضا می‌شد، هیچ امضایی در دروازه
+// معتبر نبود و همهٔ ویدیوها ۴۰۳ می‌شدند.
+mrd_assert(
+    'an encoded and a decoded path produce different signatures',
+    Mdb_Signed_Url_Core::signature('/FA/%D8%AF%D8%B1%D8%B3.mp4', MRD_EXPIRES, MRD_UID, MRD_SECRET)
+        === Mdb_Signed_Url_Core::signature('/FA/درس.mp4', MRD_EXPIRES, MRD_UID, MRD_SECRET),
+    false
+);
+
+// rawurldecode برخلاف urldecode علامت «+» را به فاصله تبدیل نمی‌کند. این برای
+// نام فایلی که «+» دارد حیاتی است.
+mrd_assert(
+    'path_for_signing keeps + as a literal plus (rawurldecode, not urldecode)',
+    Mdb_Signed_Url_Core::path_for_signing('https://dll.mrdastbaaf.com/FA/a+b.mp4'),
+    '/FA/a+b.mp4'
+);
+
+mrd_assert(
+    'path_for_signing on an empty string',
+    Mdb_Signed_Url_Core::path_for_signing(''),
+    ''
+);
+
+mrd_assert(
+    'path_for_signing accepts a bare relative path',
+    Mdb_Signed_Url_Core::path_for_signing('/FA/a.mp4'),
+    '/FA/a.mp4'
+);
+
+mrd_assert(
+    'path_for_signing on a host with no path',
+    Mdb_Signed_Url_Core::path_for_signing('https://dll.mrdastbaaf.com'),
+    ''
+);
+
+mrd_assert(
+    'path_for_signing strips a fragment',
+    Mdb_Signed_Url_Core::path_for_signing('/FA/a.mp4#t=10'),
+    '/FA/a.mp4'
+);
+
+// ─── ۳) ساخت آدرس دروازه ───────────────────────────────────────────────────
+
+$now = MRD_EXPIRES - 900;
+
+$built = Mdb_Signed_Url_Core::build_gateway_url(
+    'https://dll.mrdastbaaf.com/FA/lesson-01.mp4',
+    MRD_GATEWAY,
+    MRD_UID,
+    MRD_SECRET,
+    900,
+    $now
+);
+
+mrd_assert(
+    'build_gateway_url produces the exact expected url',
+    $built,
+    MRD_GATEWAY . '?f=%2FFA%2Flesson-01.mp4&e=' . MRD_EXPIRES . '&u=42&t=' . MRD_SIG
+);
+
+mrd_assert(
