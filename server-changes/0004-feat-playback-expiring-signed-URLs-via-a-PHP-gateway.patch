+// پیکربندی دروازه اینجا با **کلید واقعی افزونه** ساخته می‌شود، نه با ثابت تست:
+// آنچه باید بسنجیم این است که «هر کلیدی افزونه امضا می‌کند، همان دروازه تأیید
+// می‌کند» — نه اینکه تست بتواند یک کلید دلخواه را دو طرف جا بیندازد.
+$plugin_config = $config;
+$plugin_config['secret'] = MrDastbaaf_Signed_Url_Service::get_secret();
+
+$auto_params = Mdb_Signed_Url_Gateway::parse_query(parse_url($auto, PHP_URL_QUERY));
+mrd_assert(
+    'a url minted by the plugin validates in the gateway',
+    Mdb_Signed_Url_Gateway::evaluate($plugin_config, $auto_params, (int) $auto_params['e'] - 10)['status'],
+    200
+);
+
+// و برعکس: با کلید اشتباه، همان آدرس رد می‌شود. بدون این، تست بالا می‌توانست
+// به‌اشتباه سبز شود اگر بررسی امضا کلاً از کار افتاده باشد.
+mrd_assert(
+    'the same url is rejected by a gateway holding a different secret',
+    Mdb_Signed_Url_Gateway::evaluate($config, $auto_params, (int) $auto_params['e'] - 10)['status'],
+    403
+);
+
+$GLOBALS['mrd_test_filters']['mrdastbaaf_signed_urls_enabled'] = false;
+mrd_assert('the filter can force signing off', MrDastbaaf_Signed_Url_Service::is_enabled(), false);
+$GLOBALS['mrd_test_filters'] = array();
+
+mrd_assert(
+    'ttl falls back to the default when unset',
+    MrDastbaaf_Signed_Url_Service::get_ttl(),
+    MrDastbaaf_Signed_Url_Service::DEFAULT_TTL_SECONDS
+);
+
+$GLOBALS['mrd_test_options'][MrDastbaaf_Signed_Url_Service::TTL_OPTION] = -5;
+mrd_assert(
+    'a nonsensical ttl falls back to the default',
+    MrDastbaaf_Signed_Url_Service::get_ttl(),
+    MrDastbaaf_Signed_Url_Service::DEFAULT_TTL_SECONDS
+);
+
+$GLOBALS['mrd_test_options'][MrDastbaaf_Signed_Url_Service::TTL_OPTION] = 999999999;
+mrd_assert(
+    'ttl is capped at MAX_TTL_SECONDS',
+    MrDastbaaf_Signed_Url_Service::get_ttl(),
+    MrDastbaaf_Signed_Url_Service::MAX_TTL_SECONDS
+);
+
+// ─── ۱۰) نگهبان واگرایی ────────────────────────────────────────────────────
+
+// افزونه و دروازه باید **مو‌به‌مو** یک امضا بدهند. امروز افزونه به هستهٔ مشترک
+// واگذار می‌کند، پس این تساوی بدیهی است — و دقیقاً به همین دلیل ارزش قفل‌کردن
+// دارد: اگر روزی کسی یکی از دو طرف را جداگانه پیاده کند، این تست می‌افتد، نه
+// پخش‌های پروداکشن.
+mrd_assert(
+    'the plugin signer and the gateway core agree',
+    MrDastbaaf_Signed_Url_Service::sign(MRD_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET),
+    Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET)
+);
+
+mrd_assert(
+    'the plugin verifier accepts what the core signs',
+    MrDastbaaf_Signed_Url_Service::verify(
+        MRD_PATH,
+        MRD_EXPIRES,
+        MRD_UID,
+        Mdb_Signed_Url_Core::signature(MRD_PATH, MRD_EXPIRES, MRD_UID, MRD_SECRET),
+        MRD_SECRET,
+        $now
+    ),
+    true
+);
+
+// پاک‌سازی فایل‌های موقت
+@unlink($root . '/FA/escape.mp4');
+@unlink($root . '/FA/lesson-01.mp4');
+@unlink($root . '/FA/درس-اول.mp4');
+@unlink($root . '/notes.txt');
+@unlink($outside . '/secret.mp4');
+@rmdir($root . '/FA');
+@rmdir($root);
+@rmdir($outside);
+
+echo "\n---- result ----\n";
+echo "PASS: {$pass}\n";
+echo "FAIL: {$fail}\n";
+if ($skip > 0) {
+    echo "SKIP: {$skip}\n";
+}
+
+exit($fail > 0 ? 1 : 0);
