diff --git a/wordpress-plugin/mrdastbaaf-bridge/gateway/SignedUrlGateway.php b/wordpress-plugin/mrdastbaaf-bridge/gateway/SignedUrlGateway.php
new file mode 100644
index 0000000..23673b3
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/gateway/SignedUrlGateway.php
@@ -0,0 +1,321 @@
+<?php
+/**
+ * دروازهٔ سرو رسانه با آدرس امضاشده (v1.8.0) — سمت هاست دانلود (Apache)
+ *
+ * ─── چرا دروازه و نه secure_link ───
+ * نسخهٔ اول این تغییر بر پایهٔ ماژول secure_link خود nginx نوشته شده بود.
+ * هاست دانلود این پروژه **Apache** است، پس آن طرح کنار گذاشته شد و اعتبارسنجی
+ * به یک اسکریپت PHP (s.php) منتقل شد که خودش فایل را سرو می‌کند.
+ *
+ * تفاوت مهم: در مدل nginx، وب‌سرور فایل را استاتیک می‌فرستاد و فقط امضا را
+ * بررسی می‌کرد. اینجا PHP بایت‌ها را می‌خواند و می‌فرستد — یعنی باید خودمان
+ * Range، هدرها و نوع محتوا را درست انجام دهیم. به همین دلیل این کلاس منطق
+ * «تصمیم» را از «ورودی/خروجی HTTP» جدا می‌کند: [evaluate()] خالص و آزمون‌پذیر
+ * است و [serve()] فقط آن را اجرا می‌کند.
+ *
+ * ─── بارگذاری ───
+ * این فایل در دو بافت کار می‌کند:
+ *   - از s.php روی هاست دانلود (بدون وردپرس)
+ *   - از تست‌های PHP (فقط برای توابع خالص)
+ */
+
+if (!defined('ABSPATH') && !defined('MRD_GATEWAY_CONTEXT')) {
+    exit;
+}
+
+if (!defined('MRD_GATEWAY_CONTEXT')) {
+    define('MRD_GATEWAY_CONTEXT', 1);
+}
+
+require_once __DIR__ . '/signed-url-core.php';
+
+if (!class_exists('Mdb_Signed_Url_Gateway')) {
+
+    class Mdb_Signed_Url_Gateway {
+
+        /** اندازهٔ هر بلوک خواندن/نوشتن هنگام استریم. */
+        const CHUNK_SIZE = 262144; // 256 KB
+
+        /**
+         * تصمیم‌گیری برای یک درخواست — بدون هیچ ورودی/خروجی HTTP.
+         *
+         * خروجی یکی از این دو شکل است:
+         *   array('status' => 200|206, 'path' => string, 'range' => array|null, 'reason' => '')
+         *   array('status' => 400|403|404|416, 'reason' => 'code')
+         *
+         * `reason` هرگز به کلاینت فرستاده نمی‌شود؛ فقط برای لاگ است تا بشود
+         * فهمید «۴۰۳ چون امضا غلط بود» با «۴۰۳ چون منقضی بود» فرق دارد، بدون
+         * اینکه به مهاجم هم گفته شود.
+         *
+         * @param array $config
+         * @param array $params  پارامترهای درخواست، **از قبل decode‌شده** (f/e/u/t)
+         * @param int|null $now
+         * @param string   $range_header مقدار خام هدر Range
+         * @return array
+         */
+        public static function evaluate($config, $params, $now = null, $range_header = '') {
+            $secret = isset($config['secret']) ? (string) $config['secret'] : '';
+            $media_root = isset($config['media_root']) ? (string) $config['media_root'] : '';
+            $allowed = isset($config['allowed_extensions']) ? $config['allowed_extensions'] : null;
+            $now = (null === $now) ? time() : (int) $now;
+
+            $f = isset($params['f']) ? (string) $params['f'] : '';
+            $e = isset($params['e']) ? (string) $params['e'] : '';
+            $u = isset($params['u']) ? (string) $params['u'] : '';
+            $t = isset($params['t']) ? (string) $params['t'] : '';
+
+            if ('' === $f || '' === $e || '' === $t || '' === $secret || '' === $media_root) {
+                return array('status' => 400, 'reason' => 'missing_parameters');
+            }
+
+            if (!ctype_digit($e)) {
+                return array('status' => 400, 'reason' => 'malformed_expiry');
+            }
+
+            // «u» می‌تواند ۰ (مهمان) باشد؛ فقط باید عدد باشد.
+            if ('' !== $u && !ctype_digit($u)) {
+                return array('status' => 400, 'reason' => 'malformed_user');
+            }
+
+            $expires = (int) $e;
+            $user_id = ('' === $u) ? 0 : (int) $u;
+
+            // سقف عمر امضا: حتی اگر امضا معتبر باشد، عمری بیش از سقف پذیرفته
+            // نمی‌شود تا یک امضای دزدیده‌شده تا ابد کار نکند.
+            $max_ttl = isset($config['max_ttl_seconds'])
+                ? (int) $config['max_ttl_seconds']
+                : Mdb_Signed_Url_Core::MAX_TTL_SECONDS;
+            if ($max_ttl > 0 && ($expires - $now) > $max_ttl) {
+                return array('status' => 403, 'reason' => 'expiry_beyond_max_ttl');
+            }
+
+            if (!Mdb_Signed_Url_Core::verify($f, $expires, $user_id, $t, $secret, $now)) {
+                // تفکیک «منقضی» از «امضای غلط» فقط برای لاگ.
+                $reason = ($expires <= $now) ? 'expired' : 'bad_signature';
+                return array('status' => 403, 'reason' => $reason);
+            }
+
+            $path = Mdb_Signed_Url_Core::resolve_path($media_root, $f, $allowed);
+            if (null === $path) {
+                return array('status' => 404, 'reason' => 'not_found_or_rejected');
+            }
+
+            $filesize = (int) @filesize($path);
+            $range = Mdb_Signed_Url_Core::parse_range($range_header, $filesize);
+
+            if (Mdb_Signed_Url_Core::RANGE_INVALID === $range) {
+                return array('status' => 416, 'reason' => 'range_not_satisfiable', 'filesize' => $filesize);
+            }
+
+            if (null === $range) {
+                return array('status' => 200, 'path' => $path, 'range' => null, 'reason' => '', 'filesize' => $filesize);
+            }
+
+            return array('status' => 206, 'path' => $path, 'range' => $range, 'reason' => '', 'filesize' => $filesize);
+        }
+
+        /**
+         * اجرای درخواست: تصمیم می‌گیرد، هدر می‌فرستد و بدنه را استریم می‌کند.
+         *
+         * @param array $config
+         * @param array $params
+         * @param array $server  معمولاً $_SERVER
+         */
+        public static function serve($config, $params, $server) {
+            $method = isset($server['REQUEST_METHOD']) ? strtoupper((string) $server['REQUEST_METHOD']) : 'GET';
+            if ('GET' !== $method && 'HEAD' !== $method) {
+                self::respond_error(405, isset($config['debug']) && $config['debug']);
+                return;
+            }
+
+            $range_header = isset($server['HTTP_RANGE']) ? (string) $server['HTTP_RANGE'] : '';
+            $result = self::evaluate($config, $params, null, $range_header);
+            $status = (int) $result['status'];
+
+            if (isset($config['debug']) && $config['debug'] && '' !== $result['reason']) {
+                // فقط در حالت دیباگ و فقط در لاگ سرور — هرگز در پاسخ.
+                error_log('mrdastbaaf gateway: ' . $status . ' ' . $result['reason']);
+            }
+
+            if ($status >= 400) {
+                self::respond_error($status, isset($config['debug']) && $config['debug'], isset($result['filesize']) ? $result['filesize'] : null);
+                return;
+            }
+
+            self::stream_file($config, $result, 'HEAD' === $method);
+        }
+
+        /**
+         * ارسال فایل با پشتیبانی Range.
+         */
+        private static function stream_file($config, $result, $head_only) {
+            $path = $result['path'];
+            $filesize = (int) $result['filesize'];
+            $range = $result['range'];
+
+            $start = (null === $range) ? 0 : (int) $range['start'];
+            $end = (null === $range) ? ($filesize > 0 ? $filesize - 1 : 0) : (int) $range['end'];
+            $length = ($filesize > 0) ? ($end - $start + 1) : 0;
+
+            self::send_headers($config, $path, $filesize, ($result['status'] === 206), $start, $end);
+
+            if ($head_only || 0 === $length) {
+                return;
+            }
+
+            $handle = @fopen($path, 'rb');
+            if (false === $handle) {
+                return; // هدرها رفته‌اند؛ بهترین کار توقف است
+            }
+
+            if ($start > 0) {
+                if (0 !== @fseek($handle, $start)) {
+                    fclose($handle);
+                    return;
+                }
+            }
+
+            // خروجی بافر و فشرده‌سازی باید خاموش باشد وگرنه Content-Length غلط
+            // می‌شود و پلیر Range را اشتباه می‌فهمد.
+            while (ob_get_level() > 0) {
+                @ob_end_clean();
+            }
+            @set_time_limit(0);
+
+            $remaining = $length;
+            while ($remaining > 0 && !feof($handle)) {
+                if (connection_aborted()) {
+                    break;
+                }
+                $read = (int) min(self::CHUNK_SIZE, $remaining);
+                $buffer = fread($handle, $read);
+                if (false === $buffer || '' === $buffer) {
+                    break;
+                }
+                echo $buffer;
+                flush();
+                $remaining -= strlen($buffer);
+            }
+
+            fclose($handle);
+        }
+
+        /**
+         * هدرهای پاسخ.
+         */
+        private static function send_headers($config, $path, $filesize, $partial, $start, $end) {
+            if (headers_sent()) {
+                return;
+            }
+
+            $length = $partial ? ($end - $start + 1) : $filesize;
+
+            header('Content-Type: ' . Mdb_Signed_Url_Core::content_type_for($path));
+            header('Content-Length: ' . (int) $length);
+            header('Accept-Ranges: bytes');
+            header('X-Content-Type-Options: nosniff');
+            // inline تا مرورگر پخش کند، نه دانلود.
+            header('Content-Disposition: inline');
+
+            if ($partial) {
+                header('Content-Range: ' . Mdb_Signed_Url_Core::content_range_header($start, $end, $filesize));
+            }
+
+            $cache_control = isset($config['cache_control'])
+                ? (string) $config['cache_control']
+                : 'private, no-store';
+            if ('' !== $cache_control) {
+                header('Cache-Control: ' . $cache_control);
+            }
+
+            // CORS فقط اگر صراحتاً پیکربندی شده باشد. تگ <video> بدون
+            // crossorigin به هدر CORS نیازی ندارد؛ این گزینه برای وقتی است که
+            // کلاینت با crossorigin="anonymous" درخواست بدهد.
+            $origins = isset($config['allowed_origins']) ? (array) $config['allowed_origins'] : array();
+            if (!empty($origins)) {
+                $origin = isset($_SERVER['HTTP_ORIGIN']) ? (string) $_SERVER['HTTP_ORIGIN'] : '';
+                $allow = '';
+                foreach ($origins as $candidate) {
+                    $candidate = (string) $candidate;
+                    if ('*' === $candidate) {
+                        $allow = '*';
+                        break;
+                    }
+                    if ('' !== $origin && $candidate === $origin) {
+                        $allow = $origin;
+                        break;
+                    }
+                }
+                if ('' !== $allow) {
+                    header('Access-Control-Allow-Origin: ' . $allow);
+                    header('Access-Control-Expose-Headers: Content-Length, Content-Range, Accept-Ranges');
+                    header('Vary: Origin');
+                }
+            }
+        }
+
+        /**
+         * پاسخ خطا — پیام عمومی، بدون افشای دلیل واقعی.
+         */
+        private static function respond_error($status, $debug, $filesize = null) {
+            if (416 === (int) $status && null !== $filesize) {
+                if (!headers_sent()) {
+                    header('Content-Range: bytes */' . (int) $filesize);
+                    header('Accept-Ranges: bytes');
+                }
+            }
+
+            if (!headers_sent()) {
+                http_response_code((int) $status);
+                header('Content-Type: text/plain; charset=utf-8');
+                header('X-Content-Type-Options: nosniff');
+                header('Cache-Control: no-store');
+            }
+
+            $messages = array(
+                400 => 'درخواست نامعتبر است.',
+                403 => 'دسترسی به این فایل مجاز نیست یا لینک منقضی شده است.',
+                404 => 'فایل یافت نشد.',
+                405 => 'روش درخواست پشتیبانی نمی‌شود.',
+                416 => 'بازهٔ درخواستی معتبر نیست.',
+            );
+
+            echo isset($messages[(int) $status]) ? $messages[(int) $status] : 'خطا.';
+        }
+
+        /**
+         * خواندن پارامترهای درخواست از QUERY_STRING.
+         *
+         * عمداً از $_GET استفاده نمی‌کنیم: PHP در $_GET علامت «+» را به فاصله
+         * تبدیل می‌کند، ولی rawurlencode در سمت امضا برای فاصله «%20» و برای
+         * «+» خودِ «%2B» می‌فرستد. با پارس‌کردن دستی QUERY_STRING، رفت‌وبرگشت
+         * بیت‌به‌بیت دقیق می‌ماند و نام فایلی که «+» دارد هم درست کار می‌کند.
+         *
+         * @param string $query_string
+         * @return array
+         */
+        public static function parse_query($query_string) {
+            $params = array();
+            $query_string = (string) $query_string;
+
+            if ('' === $query_string) {
+                return $params;
+            }
+
+            foreach (explode('&', $query_string) as $pair) {
+                if ('' === $pair) {
+                    continue;
+                }
+                $eq = strpos($pair, '=');
+                if (false === $eq) {
+                    continue;
+                }
+                $key = rawurldecode(substr($pair, 0, $eq));
+                $value = rawurldecode(substr($pair, $eq + 1));
+                $params[$key] = $value;
+            }
+
+            return $params;
+        }
+    }
+}
diff --git a/wordpress-plugin/mrdastbaaf-bridge/gateway/htaccess.sample b/wordpress-plugin/mrdastbaaf-bridge/gateway/htaccess.sample
new file mode 100644
index 0000000..5a998d9
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/gateway/htaccess.sample
@@ -0,0 +1,101 @@
+# ---------------------------------------------------------------------------
+# .htaccess برای ریشهٔ رسانهٔ هاست دانلود — v1.8.0
+#
+# این فایل را در همان پوشه‌ای بگذارید که فایل‌های ویدیو در آن هستند
+# (مثلاً ریشهٔ dll.mrdastbaaf.com، کنار پوشهٔ FA/).
+#
+# هدف: **بستن دسترسی مستقیم** به فایل‌های رسانه. تنها راه رسیدن به فایل،
+# دروازهٔ s.php است که امضا را بررسی می‌کند.
+#
+# ⚠️ ترتیب راه‌اندازی: این فایل را **آخر از همه** فعال کنید. اگر قبل از
+# روشن‌کردن پرچم امضاگذاری در افزونه فعالش کنید، هیچ آدرسی امضا ندارد و
+# تمام پخش‌ها ۴۰۳ می‌شوند. جزئیات در docs/APACHE_SIGNED_URLS.md.
+#
+# ⚠️ پیش‌نیاز: در پیکربندی Apache، AllowOverride باید اجازهٔ AuthConfig
+# (یا All) را برای این پوشه بدهد، وگرنه این قواعد نادیده گرفته می‌شوند.
+# ---------------------------------------------------------------------------
+
+# فهرست‌کردن پوشه‌ها خاموش — وگرنه نام همهٔ فایل‌ها قابل شمارش است.
+Options -Indexes
+
+# ---------------------------------------------------------------------------
+# ۱) بستن دسترسی مستقیم به رسانه
+#
+# s.php با این قواعد مسدود نمی‌شود (پسوندش php است، نه رسانه) و باید در دسترس
+# بماند. فایل‌های ویدیو از بیرون ۴۰۳ می‌گیرند و فقط از طریق دروازه سرو می‌شوند.
+# ---------------------------------------------------------------------------
+<FilesMatch "\.(mp4|m4v|mov|webm|mkv|ogv|m3u8|ts|m4s|mpd|key|vtt|srt|mp3|m4a|aac|ogg)$">
+    <IfModule mod_authz_core.c>
+        Require all denied
+    </IfModule>
+    <IfModule !mod_authz_core.c>
+        Order allow,deny
+        Deny from all
+    </IfModule>
+</FilesMatch>
+
+# ---------------------------------------------------------------------------
+# ۲) تصاویر — پیش‌فرض باز می‌مانند
+#
+# تصاویر دوره‌ها (پوستر/بندانگشتی) معمولاً باید عمومی باشند و در فهرست دوره‌ها
+# نمایش داده شوند. اگر آن‌ها را هم از همین هاست سرو می‌کنید و می‌خواهید پشت
+# دروازه بروند، خط زیر را از حالت کامنت دربیاورید.
+# اگر این کار را می‌کنید، مطمئن شوید آدرس تصاویر در پاسخ /courses هم امضا شده
+# است — وگرنه کاتالوگ بی‌تصویر می‌شود.
+# ---------------------------------------------------------------------------
+# <FilesMatch "\.(jpg|jpeg|png|webp)$">
+#     <IfModule mod_authz_core.c>
+#         Require all denied
+#     </IfModule>
+#     <IfModule !mod_authz_core.c>
+#         Order allow,deny
+#         Deny from all
+#     </IfModule>
+# </FilesMatch>
+
+# ---------------------------------------------------------------------------
+# ۳) محافظت از فایل پیکربندی دروازه
+#
+# این فایل کلید مشترک را در خود دارد. اگر بیرون از ریشهٔ وب باشد (توصیه‌شده)
+# این قاعده لازم نیست، ولی به‌عنوان لایهٔ دوم ضرری ندارد.
+# ---------------------------------------------------------------------------
+<Files "signed-url-config.php">
+    <IfModule mod_authz_core.c>
+        Require all denied
+    </IfModule>
+    <IfModule !mod_authz_core.c>
+        Order allow,deny
+        Deny from all
+    </IfModule>
+</Files>
+
+# فایل‌های نمونه و مستندات نباید روی وب‌سرور بمانند.
+<FilesMatch "\.(sample|md|dist)$">
+    <IfModule mod_authz_core.c>
+        Require all denied
+    </IfModule>
+    <IfModule !mod_authz_core.c>
+        Order allow,deny
+        Deny from all
+    </IfModule>
+</FilesMatch>
+
+# فایل‌های مخفی (شامل خود .htaccess و فایل‌های ادیتور).
+<FilesMatch "^\.">
+    <IfModule mod_authz_core.c>
+        Require all denied
+    </IfModule>
+    <IfModule !mod_authz_core.c>
+        Order allow,deny
+        Deny from all
+    </IfModule>
+</FilesMatch>
+
+# ---------------------------------------------------------------------------
+# ۴) هدرهای امنیتی
+# ---------------------------------------------------------------------------
+<IfModule mod_headers.c>
+    Header always set X-Content-Type-Options "nosniff"
+    # اگر پشت پروکسی/CDN هستید، این خط را نگه دارید تا مبدأ واقعی بازنویسی نشود.
+    Header always set X-Frame-Options "SAMEORIGIN"
+</IfModule>
diff --git a/wordpress-plugin/mrdastbaaf-bridge/gateway/s.php b/wordpress-plugin/mrdastbaaf-bridge/gateway/s.php
new file mode 100644
index 0000000..6779cef
--- /dev/null
+++ b/wordpress-plugin/mrdastbaaf-bridge/gateway/s.php
@@ -0,0 +1,63 @@
+<?php
+/**
+ * s.php — دروازهٔ سرو رسانه با آدرس امضاشده (v1.8.0)
+ *
+ * این فایل روی **هاست دانلود** (Apache) قرار می‌گیرد، نه روی سایت وردپرس.
+ * آدرس پخش ویدیو دیگر مستقیم نیست؛ به این شکل است:
+ *
+ *   https://dll.mrdastbaaf.com/s.php?f=%2FFA%2Flesson-01.mp4&e=1800000000&u=42&t=<hmac>
+ *
+ * ─── چرا اینجا وردپرس بارگذاری نمی‌شود ───
+ * هاست دانلود نصب وردپرس ندارد و نباید داشته باشد. ضمناً بارگذاری وردپرس برای
+ * هر درخواست Range یک پلیر ویدیویی، چند صد میلی‌ثانیه هزینه دارد. پس این اسکریپت
+ * کاملاً مستقل است و کلید مشترک را از یک فایل پیکربندی کنار خودش می‌خواند.
+ *
+ * ─── ترتیب راه‌اندازی (حیاتی) ───
+ * ۱) این فایل + فایل پیکربندی را روی هاست دانلود بگذارید.
+ * ۲) در افزونه، آدرس دروازه را تنظیم و پرچم امضاگذاری را روشن کنید.
+ * ۳) **آخر از همه** دسترسی مستقیم به فایل‌های رسانه را با .htaccess ببندید.
+ *
+ * اگر مرحلهٔ ۳ قبل از ۲ انجام شود، هیچ آدرسی امضا ندارد و همهٔ پخش‌ها ۴۰۳
+ * می‌شوند. جزئیات در docs/APACHE_SIGNED_URLS.md.
+ *
+ * @package mrdastbaaf-bridge
+ */
+
+// بافت دروازه را اعلام می‌کنیم تا فایل‌های هسته بارگذاری شوند.
+define('MRD_GATEWAY_CONTEXT', 1);
+
+require_once __DIR__ . '/SignedUrlGateway.php';
+
+// ─── بارگذاری پیکربندی ───────────────────────────────────────────────────────
+
+$config_path = __DIR__ . '/signed-url-config.php';
+
+// امکان قرار دادن فایل پیکربندی بیرون از ریشهٔ وب (توصیه‌شده).
+$env_config = getenv('MRD_GATEWAY_CONFIG');
+if (is_string($env_config) && '' !== $env_config) {
+    $config_path = $env_config;
+}
+
+$config = null;
+if (is_file($config_path)) {
+    $loaded = require $config_path;
+    if (is_array($loaded)) {
+        $config = $loaded;
+    }
+}
+
+if (null === $config) {
+    http_response_code(500);
+    header('Content-Type: text/plain; charset=utf-8');
+    error_log('mrdastbaaf gateway: configuration missing at ' . $config_path);
+    echo 'پیکربندی دروازه یافت نشد.';
+    exit;
+}
+
+// ─── سرو ─────────────────────────────────────────────────────────────────────
+
+$params = Mdb_Signed_Url_Gateway::parse_query(
+    isset($_SERVER['QUERY_STRING']) ? (string) $_SERVER['QUERY_STRING'] : ''
+);
+
+Mdb_Signed_Url_Gateway::serve($config, $params, $_SERVER);
diff --git a/wordpress-plugin/mrdastbaaf-bridge/gateway/signed-url-config.php.sample b/wordpress-plugin/mrdastbaaf-bridge/gateway/signed-url-config.php.sample
