# =============================================================================
# Android / Gradle
# =============================================================================
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
output.json
release/
debug/

# Keystores — NEVER commit these, except the debug key below.
*.jks
*.keystore
keystore.properties

# The debug keystore IS committed on purpose. GitHub-hosted runners generate a
# fresh ~/.android/debug.keystore per job, so every CI build was signed with a
# different key and Android refused to install over the previous one
# ("App not installed as package conflicts with an existing package").
# A debug key is not a secret: its password is the well-known "android".
!app/debug.keystore

# R8 mapping output (upload to Play Console, do not commit)
app/build/outputs/mapping/
mapping.txt
build/debug-info/

# =============================================================================
# IDE
# =============================================================================
.idea/
*.iml
*.hprof
.kotlin/

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Secrets / environment
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key

# =============================================================================
# WorkBuddy local workspace data
# =============================================================================
.workbuddy-ai/

# =============================================================================
# Web app (web/) — build output and dependencies. The PWA lives in this
# repository now; its own .gitignore handles the rest.
# =============================================================================
node_modules/
vendor/
dist/
*.log
.cache/
.temp/
tmp/
web/.env
web/.env.local
