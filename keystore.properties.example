# Copy this file to `keystore.properties` and fill in the real values.
#
# `keystore.properties` is gitignored. The keystore itself must never be
# committed either — `*.jks` is already ignored.
#
# Create the key ONCE and keep it somewhere safe. If you lose it you can never
# update the app on Play again, unless Play App Signing is enabled (in which
# case Google holds the real key and this one only signs uploads).
#
#   keytool -genkeypair -v -keystore mdbapp-release.jks -alias mdbapp \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# The path is resolved from the repository root.
storeFile=mdbapp-release.jks
storePassword=CHANGE_ME
keyAlias=mdbapp
keyPassword=CHANGE_ME
