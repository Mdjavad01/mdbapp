# Normalise line endings so a checkout on Windows behaves the same as on CI.
* text=auto eol=lf

# The Gradle wrapper scripts must keep LF even on Windows — CRLF in `gradlew`
# makes the shell fail with "bad interpreter".
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf

# Binary assets: never touch these.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jks binary
*.keystore binary

# Patch files must survive byte-for-byte: normalising line endings inside a
# diff corrupts the context lines and makes `git am` fail.
*.patch -text
*.diff  -text

# Keep generated/verbose files out of diffs and language stats.
gradle/wrapper/gradle-wrapper.jar binary
*.lock binary
