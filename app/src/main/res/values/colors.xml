<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Brand palette for XML-only surfaces: the splash screen, the adaptive
      launcher icon background, and the window background before the first
      Compose frame.

      The live palette is BrandPalette in core/ui/theme/BrandPalette.kt, and it
      is the only one the UI reads. This file exists because the splash screen
      is drawn by the system before any Compose code runs — so if you change the
      brand, change it here too. Values are sampled from mrdastbaaf.com.
    -->
    <color name="brand_primary">#9A3412</color>
    <color name="brand_accent">#D97706</color>
    <color name="brand_canvas">#FDFBF7</color>
    <color name="brand_ink">#150702</color>

    <color name="ic_launcher_background">#9A3412</color>

    <!-- Window backgrounds -->
    <color name="app_window_background_light">#FDFBF7</color>
    <color name="app_window_background_dark">#0F0502</color>
</resources>
