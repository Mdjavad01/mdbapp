<?xml version="1.0" encoding="utf-8"?>
<!--
  Default locale resources are Persian: the app is Persian-only, so it must be
  correct on a device whose locale is anything at all. There is intentionally no
  values-en fallback — the AndroidManifest declares fa via locales_config.xml.

  NOTE: `app_name` is deliberately absent. It is injected per build flavour via
  `resValue` in app/build.gradle.kts; declaring it here as well would produce a
  duplicate-resource failure.
-->
